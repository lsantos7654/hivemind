load("@aspect_rules_py//py:defs.bzl", "py_test")
load("//tools/bazel:ruff_test.bzl", "ruff_check_test", "ruff_format_test")

package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.bazel"])

# Common attrs for every py_test target in this package.
_PYTEST_DEPS = [
    "//src/hivemind:lib",
    "@pypi//pytest",
]

_PYTEST_TAGS = ["unit"]

py_test(
    name = "test_core",
    srcs = [
        "conftest.py",
        "test_core.py",
    ],
    imports = [".."],
    main = "test_core.py",
    tags = _PYTEST_TAGS,
    deps = _PYTEST_DEPS,
)

py_test(
    name = "test_provider",
    srcs = [
        "conftest.py",
        "test_provider.py",
    ],
    imports = [".."],
    main = "test_provider.py",
    tags = _PYTEST_TAGS,
    deps = _PYTEST_DEPS,
)

py_test(
    name = "test_cross_session",
    srcs = [
        "conftest.py",
        "test_cross_session.py",
    ],
    imports = [".."],
    main = "test_cross_session.py",
    tags = _PYTEST_TAGS,
    deps = _PYTEST_DEPS,
)

py_test(
    name = "test_memory_daemon",
    srcs = [
        "conftest.py",
        "test_memory_daemon.py",
    ],
    imports = [".."],
    main = "test_memory_daemon.py",
    tags = _PYTEST_TAGS,
    deps = _PYTEST_DEPS,
)

py_test(
    name = "test_ephemeral_invariants",
    srcs = [
        "conftest.py",
        "test_ephemeral_invariants.py",
    ],
