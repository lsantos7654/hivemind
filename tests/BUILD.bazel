    main = "test_ephemeral_invariants.py",
    tags = _PYTEST_TAGS,
    deps = _PYTEST_DEPS,
)

# ---------------------------------------------------------------------------
# Quality gates (Stage 0)
#
# `mypy_test` is intentionally NOT added here. Existing tests use
# untyped function signatures — making them strict-type-clean is
# Stage 2 work in docs/TESTING_ROADMAP.md ("Make tests themselves
# type-check"). When Stage 2 lands, add:
#
#     load("//tools/bazel:mypy_test.bzl", "mypy_test")
#     mypy_test(name = "mypy", srcs = _PY_SRCS)
# ---------------------------------------------------------------------------

_PY_SRCS = glob(["**/*.py"])

ruff_check_test(
    name = "ruff_check",
    srcs = _PY_SRCS,
)

ruff_format_test(
    name = "ruff_format",
    srcs = _PY_SRCS,
)
