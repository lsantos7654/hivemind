{
  "providers": {
    "claude": {
      "engine": "claude -p --verbose --dangerously-skip-permissions",
      "home_dir": "~/.claude",
      "settings": {
        "model": "sonnet",
        "tools": [
          "Read",
          "Grep",
          "Glob"
        ]
      },
      "permissions": {
        "defaultMode": "acceptEdits",
        "allow": [
          "Read(~/.cache/hivemind/**)",
          "Grep(~/.cache/hivemind/**)",
          "Glob(~/.cache/hivemind/**)",
          "Edit(~/.claude/hivemind/teams/**)",
          "Edit(~/.claude/hivemind/projects/**)"
        ]
      }
    },
    "opencode": {
      "engine": "opencode run",
      "home_dir": "~/.config/opencode",
      "settings": {
        "model": "github-copilot/claude-sonnet-4",
        "temperature": 0.1,
        "tools": {
          "read": true,
          "grep": true,
          "glob": true,
          "bash": false
        }
      },
      "permissions": {
        "allow": [
          "Read(~/.cache/hivemind/**)",
          "Grep(~/.cache/hivemind/**)",
          "Glob(~/.cache/hivemind/**)"
        ]
      }
    }
  },
