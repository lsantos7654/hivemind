/* Hivemind TUI Styles */

Screen {
    background: $surface;
}

/* Header */
.header {
    background: $primary;
    color: $text;
    padding: 1;
    text-align: center;
}

/* Search bar */
.search-container {
    height: 3;
    padding: 0 1;
    background: $panel;
}

.search-label {
    padding: 1 0;
    width: auto;
}

Input {
    width: 1fr;
    border: tall $primary;
}

Input:focus {
    border: tall $accent;
}

/* Tables */
DataTable {
    height: 1fr;
    border: tall transparent;
}

DataTable:focus {
    border: tall $accent;
}

DataTable > .datatable--cursor {
    background: $accent;
}

/* Footer */
.footer {
    background: $panel;
    color: $text;
    height: 3;
    padding: 0 1;
}

.keybindings {
    text-align: left;
    padding: 0 1;
}

/* Version detail screen */
#expert-header {
    height: auto;
    padding: 1 2;
    background: $panel;
    margin-bottom: 1;
}

#search-container {
    height: 3;
    padding: 1 2;
    background: $panel;
    margin: 0 2 1 2;
}

#search-container.hidden {
    display: none;
}

.section-title {
    padding: 1 2;
    text-style: bold;
}

#version-table {
    height: 1fr;
    margin: 0 2;
}

#commit-input-container {
    height: 3;
    padding: 1 2;
    background: $panel;
}

#commit-input-container.hidden {
    display: none;
}

.input-label {
    width: auto;
    padding: 0 1;
}
