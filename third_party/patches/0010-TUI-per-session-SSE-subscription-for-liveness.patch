From 7da232a5f62718cc9dbd4caab254eb41d237290c Mon Sep 17 00:00:00 2001
From: Lucas Santos <lsantos7654@gmail.com>
Date: Mon, 27 Apr 2026 22:48:23 -0400
Subject: [PATCH 10/27] TUI per-session SSE subscription for liveness

Pairs with the server-side patch 0009 (SSE liveness counter). The TUI
now passes ?sessionID=<currentSession> on its /event subscription so
GET /global/live-sessions reflects the session the TUI is actively
attached to.

Mechanism:
  - sdk.tsx (TUI's SDK context): startSSE accepts an optional sessionID
    and the subscription is wrapped in createEffect on route.data so
    navigating between sessions in the sidebar tears down the prior
    SSE stream and opens a new one with the updated sessionID. On the
    home route the param is omitted (no liveness contribution), and
    closing the TUI aborts both signals.
  - sdk.gen.ts + types.gen.ts: extend the auto-generated Event.subscribe
    typed parameters with `sessionID?: string` so the TUI can pass it
    type-safely. The generated files come from @hey-api/openapi-ts;
    these manual edits will be re-applied by future regenerations.

The corresponding server route already increments and decrements its
counter on stream open/close. Together these two patches give an
accurate per-session liveness signal that hivemind's MCP tools can
filter on without heuristics or heartbeats.
---
 .../opencode/src/cli/cmd/tui/context/sdk.tsx  | 22 +++++++++++++++----
 1 file changed, 18 insertions(+), 4 deletions(-)

diff --git a/packages/opencode/src/cli/cmd/tui/context/sdk.tsx b/packages/opencode/src/cli/cmd/tui/context/sdk.tsx
index 348c3ca..bae8d0c 100644
--- a/packages/opencode/src/cli/cmd/tui/context/sdk.tsx
+++ b/packages/opencode/src/cli/cmd/tui/context/sdk.tsx
@@ -1,7 +1,8 @@
 import { createOpencodeClient, type Event } from "@opencode-ai/sdk/v2"
 import { createSimpleContext } from "./helper"
+import { useRoute } from "./route"
 import { createGlobalEmitter } from "@solid-primitives/event-bus"
-import { batch, onCleanup, onMount } from "solid-js"
+import { batch, createEffect, onCleanup, onMount } from "solid-js"

 export type EventSource = {
   subscribe: (directory: string | undefined, handler: (event: Event) => void) => Promise<() => void>
@@ -67,14 +68,19 @@ export const { use: useSDK, provider: SDKProvider } = createSimpleContext({
       flush()
     }

-    function startSSE() {
+    // Hivemind: tracks the session this TUI is currently watching so the
+    // server's `/global/live-sessions` endpoint reports it as live. Reads
+    // the Route context — when the user navigates between sessions in the
+    // sidebar, the SSE stream restarts with the new sessionID, the prior
+    // session drops out of the live set, and the new one enters.
+    function startSSE(sessionID?: string) {
       sse?.abort()
       const ctrl = new AbortController()
       sse = ctrl
       ;(async () => {
         while (true) {
           if (abort.signal.aborted || ctrl.signal.aborted) break
-          const events = await sdk.event.subscribe({}, { signal: ctrl.signal })
+          const events = await sdk.event.subscribe({ sessionID }, { signal: ctrl.signal })

           for await (const event of events.stream) {
             if (ctrl.signal.aborted) break
@@ -87,12 +93,20 @@ export const { use: useSDK, provider: SDKProvider } = createSimpleContext({
       })().catch(() => {})
     }

+    const route = useRoute()
+
     onMount(async () => {
       if (props.events) {
         const unsub = await props.events.subscribe(props.directory, handleEvent)
         onCleanup(unsub)
       } else {
-        startSSE()
+        // Re-establish the SSE subscription whenever the route changes so the
+        // sessionID query param matches the currently focused session.
+        createEffect(() => {
+          const data = route.data
+          const sessionID = data.type === "session" ? data.sessionID : undefined
+          startSSE(sessionID)
+        })
       }
     })

