 import { Log } from "@/util/log"
 import { BusEvent } from "@/bus/bus-event"
 
 const log = Log.create({ service: "server" })
 
+function gitMeta(dir: string): Record<string, string> {
+  const out: Record<string, string> = {}
+  try {
+    let root = path.join(dir, ".git")
+    let head: string
+    try {
+      head = new TextDecoder().decode(readFileSync(path.join(root, "HEAD")))
+    } catch {
+      const text = new TextDecoder().decode(readFileSync(root))
+      const m = text.match(/^gitdir:\s*(.+)$/m)
+      if (!m) return out
+      root = path.resolve(dir, m[1])
+      head = new TextDecoder().decode(readFileSync(path.join(root, "HEAD")))
+    }
+    head = head.trim()
+    if (head.startsWith("ref: refs/heads/")) {
+      out.branch = head.slice(16)
+    } else if (head.length >= 7) {
+      out.branch = head.slice(0, 7)
+    }
+    try {
+      const cfg = new TextDecoder().decode(readFileSync(path.join(root, "config")))
+      const m = cfg.match(/\[remote\s+"origin"\][^\[]*url\s*=\s*(.+)/s)
+      if (m) out.remote = m[1].trim()
+    } catch {}
+  } catch {}
+  return out
+}
