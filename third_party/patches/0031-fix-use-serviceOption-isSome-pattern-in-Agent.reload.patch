From 87f9b68ac57a627a3910fb99e6885c414a2e6e4a Mon Sep 17 00:00:00 2001
From: Lucas Santos <lsantos7654@gmail.com>
Date: Mon, 11 May 2026 00:57:41 -0400
Subject: [PATCH 31/35] fix: use serviceOption + isSome pattern in
 Agent.reload()

---
 packages/opencode/src/agent/agent.ts | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/packages/opencode/src/agent/agent.ts b/packages/opencode/src/agent/agent.ts
index ea3d0b2..0cf4f7c 100644
--- a/packages/opencode/src/agent/agent.ts
+++ b/packages/opencode/src/agent/agent.ts
@@ -349,11 +349,10 @@ export namespace Agent {
           yield* config.invalidateState()
           yield* InstanceState.invalidate(state)
           const list = yield* InstanceState.useEffect(state, (s) => s.list())
-          const bus = yield* Effect.serviceOptional(Bus.Service)
-          yield* Option.match(bus, {
-            onNone: () => Effect.unit,
-            onSome: (b) => b.publish(AgentsChanged, { count: list.length }).pipe(Effect.ignore),
-          })
+          const busOpt = yield* Effect.serviceOption(Bus.Service)
+          if (Option.isSome(busOpt)) {
+            yield* busOpt.value.publish(AgentsChanged, { count: list.length })
+          }
           return { count: list.length }
         }),
         generate: Effect.fn("Agent.generate")(function* (input: {
-- 
