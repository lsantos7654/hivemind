+          await new Promise((r) => setTimeout(r, 200))
+
+          const children = await Session.children(orch.id)
+          const daemon = children.find((c) => c.title.includes("compact memory"))
+          expect(daemon).toBeDefined()
+          expect(daemon!.parentID).toBe(orch.id)
+          expect(daemon!.metadata).toEqual({
+            triggered_by_session: orch.id,
+            target_agent: "_orchestrator",
+            triggered_at_bytes: 9000,
+          })
+          expect(daemon!.ephemeral).toBe(true)
+        },
+      })
+    } finally {
+      process.chdir(cwd)
+      await cfg.cleanup()
