+describe("Phase 3 — cross-session fan-out", () => {
+  test("N root sessions exist independently with no shared parent", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const sessions = await Promise.all(
+          Array.from({ length: 5 }, (_, i) =>
+            Session.create({ title: `branch ${i + 1}` }),
+          ),
+        )
+
+        for (const s of sessions) {
+          const fetched = await Session.get(s.id)
+          expect(fetched.title).toBe(s.title)
+          expect(fetched.parentID).toBeFalsy()
+        }
+
+        // Children list for any session is empty (no shared parent).
+        for (const s of sessions) {
+          const kids = await Session.children(s.id)
+          expect(kids).toHaveLength(0)
+        }
+      },
+    })
+  })
+
+  test("fan-out creates sessions independently — no serialization queue", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        // Create all sessions in parallel (simulating fan-out).
+        const start = Date.now()
+        const sessions = await Promise.all(
+          Array.from({ length: 10 }, (_, i) =>
+            Session.create({ title: `peer ${i}` }),
+          ),
+        )
+        const elapsed = Date.now() - start
+
+        // 10 sessions should create quickly (no serialization bottleneck).
+        expect(elapsed).toBeLessThan(5000)
+        expect(sessions).toHaveLength(10)
+
+        // All have unique IDs.
+        const ids = new Set(sessions.map((s) => s.id))
+        expect(ids.size).toBe(10)
+      },
+    })
+  })
 })
