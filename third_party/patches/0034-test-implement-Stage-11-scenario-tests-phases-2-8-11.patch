+  test("concurrent over-threshold write for same target agent does not spawn a second daemon", async () => {
+    const cfg = await configWithThreshold(8192)
+    const cwd = process.cwd()
+    process.chdir(cfg.path)
+    try {
+      await Instance.provide({
+        directory: projectRoot,
+        fn: async () => {
+          const main = await Session.create({})
+          const expert = await Session.create({ parentID: main.id, title: "expert-bazel" })
+
+          await Plugin.notifyFileWrite({
+            path: "/Users/santos/.config/opencode/hivemind/memory/bazel/short_memory.md",
+            sessionID: expert.id,
+            bytes: 9000,
+            tool: "write",
+          })
+          await new Promise((r) => setTimeout(r, 200))
+
+          const children = await Session.children(main.id)
+          const daemons = children.filter((c) => c.title.includes("compact memory"))
+          expect(daemons.length).toBe(1)
+
+          // Second write for same agent while daemon still exists: no new spawn.
+          await Plugin.notifyFileWrite({
+            path: "/Users/santos/.config/opencode/hivemind/memory/bazel/short_memory.md",
+            sessionID: expert.id,
+            bytes: 9500,
+            tool: "write",
+          })
+          await new Promise((r) => setTimeout(r, 200))
+
+          const after = await Session.children(main.id)
+          const afterDaemons = after.filter((c) => c.title.includes("compact memory"))
+          expect(afterDaemons.length).toBe(1)
+        },
+      })
+    } finally {
+      process.chdir(cwd)
+      await cfg.cleanup()
+    }
+  })
+
+  test("daemon spawns under orchestrator when writer has no parentID", async () => {
+    const cfg = await configWithThreshold(8192)
+    const cwd = process.cwd()
+    process.chdir(cfg.path)
+    try {
+      await Instance.provide({
+        directory: projectRoot,
+        fn: async () => {
+          // Writer is the orchestrator itself — no parent.
+          const orch = await Session.create({ title: "orchestrator" })
+
+          await Plugin.notifyFileWrite({
+            path: "/Users/santos/.config/opencode/hivemind/memory/_orchestrator/short_memory.md",
+            sessionID: orch.id,
+            bytes: 9000,
+            tool: "write",
