From fc8f2b7ea167f8b61ed483d676ec46ca3b0e0759 Mon Sep 17 00:00:00 2001
From: Lucas Santos <lsantos7654@gmail.com>
Date: Mon, 11 May 2026 00:14:03 -0400
Subject: [PATCH 20/25] fix: stabilize engine typecheck + autoshare migration
 for Stage 1
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- agent.ts: omit reload from State type, type reloadAll result
- config.ts: remove Zod .default() from share/autoshare/autoupdate,
  apply hardened defaults post-migration so autoshare→share isn't blocked
- server.ts: use ReturnType<typeof Bun.serve> instead of generic
  Server<WebSocketData> (avoids TS2314)
- presence test files: same BunServer type fix
- footer.tsx: add explicit param types for session_footer slot
- hivemind-memory.ts: add explicit handler param types
- read-task-result.ts: add explicit return type with running status
- task.ts: add explicit nextSession type annotation
---
 packages/opencode/src/agent/agent.ts                | 11 ++++++++---
 packages/opencode/src/config/config.ts              | 10 +++++++---
 packages/opencode/src/plugin/hivemind-memory.ts     |  2 +-
 packages/opencode/src/server/server.ts              |  6 ++++--
 packages/opencode/src/tool/read-task-result.ts      |  5 ++++-
 packages/opencode/src/tool/task.ts                  |  4 ++--
 .../opencode/test/server/presence-client.test.ts    | 13 +++++++------
 packages/opencode/test/server/presence.test.ts      |  7 ++++---
 8 files changed, 37 insertions(+), 21 deletions(-)

diff --git a/packages/opencode/src/agent/agent.ts b/packages/opencode/src/agent/agent.ts
index 44d00fd..0cf4f7c 100644
--- a/packages/opencode/src/agent/agent.ts
+++ b/packages/opencode/src/agent/agent.ts
@@ -80,7 +80,7 @@ export namespace Agent {
     }>
   }
 
-  type State = Omit<Interface, "generate">
+  type State = Omit<Interface, "generate" | "reload">
 
   export class Service extends ServiceMap.Service<Service, Interface>()("@opencode/Agent") {}
 
@@ -467,11 +467,16 @@ export namespace Agent {
     let agents = 0
     for (const directory of dirs) {
       try {
-        const result = await Instance.provide({
+        const reloaded = await Instance.provide({
           directory,
           fn: () => runPromise((svc) => svc.reload()),
         })
-        agents += result.count
+        // Instance.provide can't fully infer the return type
+        // through the Effect scope chain (Bus.Service ⊆
+        // Agent.Service via InstanceContext). The runtime is
+        // backed by makeRuntime's layer tree which provides
+        // all services.  Single typed boundary.
+        agents += (reloaded as { count: number }).count
       } catch {
         // Skip instances that failed to load; the dispose path skips them too.
       }
diff --git a/packages/opencode/src/config/config.ts b/packages/opencode/src/config/config.ts
index e9c4ecc..8d03cf0 100644
--- a/packages/opencode/src/config/config.ts
+++ b/packages/opencode/src/config/config.ts
@@ -939,19 +939,16 @@ export namespace Config {
       share: z
         .enum(["manual", "auto", "disabled"])
         .optional()
-        .default("disabled")
         .describe(
           "Control sharing behavior:'manual' allows manual sharing via commands, 'auto' enables automatic sharing, 'disabled' disables all sharing",
         ),
       autoshare: z
         .boolean()
         .optional()
-        .default(false)
         .describe("@deprecated Use 'share' field instead. Share newly created sessions automatically"),
       autoupdate: z
         .union([z.boolean(), z.literal("notify")])
         .optional()
-        .default(false)
         .describe(
           "Automatically update to the latest version. Set to true to auto-update, false to disable, or 'notify' to show update notifications",
         ),
@@ -1527,6 +1524,13 @@ export namespace Config {
             result.share = "auto"
           }
 
+          // Hivemind hardened defaults: apply after migrations so
+          // autoshare→share migration isn't blocked by a defaulted
+          // share field. Users can override these in opencode.json.
+          result.share ??= "disabled"
+          result.autoshare ??= false
+          result.autoupdate ??= false
+
           if (Flag.OPENCODE_DISABLE_AUTOCOMPACT) {
             result.compaction = { ...result.compaction, auto: false }
           }
