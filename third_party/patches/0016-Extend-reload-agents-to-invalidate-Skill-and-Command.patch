 packages/opencode/src/command/index.ts        | 43 ++++++++++++++++++-
 packages/opencode/src/server/routes/global.ts | 26 +++++++++--
 packages/opencode/src/skill/index.ts          | 41 +++++++++++++++++-
 3 files changed, 104 insertions(+), 6 deletions(-)

diff --git a/packages/opencode/src/command/index.ts b/packages/opencode/src/command/index.ts
index 088d7c5..866f1a4 100644
--- a/packages/opencode/src/command/index.ts
+++ b/packages/opencode/src/command/index.ts
@@ -1,4 +1,5 @@
 import { BusEvent } from "@/bus/bus-event"
+import { Instance } from "@/project/instance"
 import { InstanceState } from "@/effect/instance-state"
 import { makeRuntime } from "@/effect/run-service"
 import { SessionID, MessageID } from "@/session/schema"
@@ -68,6 +69,7 @@ export namespace Command {
   export interface Interface {
     readonly get: (name: string) => Effect.Effect<Info | undefined>
     readonly list: () => Effect.Effect<Info[]>
+    readonly reload: () => Effect.Effect<{ count: number }>
   }
 
   export class Service extends ServiceMap.Service<Service, Interface>()("@opencode/Command") {}
@@ -177,7 +179,18 @@ export namespace Command {
         return Object.values(s.commands)
       })
 
-      return Service.of({ get, list })
+      // Hivemind: invalidate the per-instance Command cache so the next
+      // get/list call re-runs the `init` effect, picking up newly-added
+      // commands/*.md files, MCP-registered prompts, and (importantly)
+      // any Skill changes that have been reloaded since the last access.
+      // Used by the `POST /global/reload-agents` route.
+      const reload = Effect.fn("Command.reload")(function* () {
+        yield* InstanceState.invalidate(state)
+        const s = yield* InstanceState.get(state)
+        return { count: Object.keys(s.commands).length }
+      })
+
+      return Service.of({ get, list, reload })
     }),
   )
 
@@ -192,4 +205,32 @@ export namespace Command {
   export async function list() {
     return runPromise((svc) => svc.list())
   }
+
+  /**
+   * Hivemind: reload the command registry for every active instance.
+   * Mirrors `Agent.reloadAll` and `Skill.reloadAll` — iterates
+   * `Instance.directories()`, provides each context, and runs
+   * `reload()` so commands/*.md changes (and downstream Skill changes
+   * that flow into the auto-promoted command list) are picked up
+   * without disposing the InstanceState.
+   *
+   * Used by the `POST /global/reload-agents` route. Must run AFTER
+   * `Skill.reloadAll` because Command's init reads `skill.all()`.
+   */
+  export async function reloadAll(): Promise<{ instances: number; commands: number }> {
+    const dirs = Instance.directories()
+    let commands = 0
+    for (const directory of dirs) {
+      try {
+        const result = await Instance.provide({
+          directory,
+          fn: () => runPromise((svc) => svc.reload()),
+        })
+        commands += result.count
+      } catch {
+        // Skip instances that failed to load; the dispose path skips them too.
+      }
+    }
+    return { instances: dirs.length, commands }
+  }
 }
