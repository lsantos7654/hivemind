+import { describe, expect, test } from "bun:test"
+import path from "path"
+import { Session } from "../../src/session"
+import { Log } from "../../src/util/log"
+import { Instance } from "../../src/project/instance"
+
+const projectRoot = path.join(__dirname, "../..")
+Log.init({ print: false })
+
+// Hivemind: tests for the session.metadata column added by patch.
+// Used by the memory-compaction daemon to record structured
+// attribution (triggered_by_session, target_agent, triggered_at_bytes)
+// without parsing the title.
+
+describe("Session metadata column", () => {
+  test("round-trips arbitrary JSON-serializable metadata", async () => {
+    await Instance.provide({
+      directory: projectRoot,
+      fn: async () => {
+        const meta = {
+          triggered_by_session: "ses_writer_xyz",
+          target_agent: "bazel",
+          triggered_at_bytes: 9000,
+        }
+        const session = await Session.create({ metadata: meta })
+        const fetched = await Session.get(session.id)
+        expect(fetched.metadata).toEqual(meta)
+      },
+    })
+  })
+
+  test("defaults to undefined when not provided", async () => {
+    await Instance.provide({
+      directory: projectRoot,
+      fn: async () => {
+        const session = await Session.create({})
+        const fetched = await Session.get(session.id)
+        expect(fetched.metadata).toBeUndefined()
+      },
+    })
+  })
+
+  test("supports nested values", async () => {
+    await Instance.provide({
+      directory: projectRoot,
+      fn: async () => {
+        const meta = {
+          nested: { count: 42, ids: ["a", "b"] },
+          flag: true,
+        }
+        const session = await Session.create({ metadata: meta })
+        const fetched = await Session.get(session.id)
+        expect(fetched.metadata).toEqual(meta)
+      },
+    })
+  })
+})
