From b302e1a8eebea9c1ee2ff9aa85036756aaf9aef2 Mon Sep 17 00:00:00 2001
From: Lucas Santos <lsantos7654@gmail.com>
Date: Sun, 3 May 2026 22:14:10 -0400
Subject: [PATCH 17/29] TUI SSE loop: catch transient errors and reconnect
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The TUI's event-stream consumer used to wrap the entire subscribe loop in
one async IIFE ending in `.catch(() => {})`. Any throw — from
`sdk.event.subscribe` or the inner `for await` — fell through to that
swallow and exited the loop forever. The TUI then kept running but
stopped receiving any streaming events; the user only saw the dead
state on the next Ctrl-C reconnect.

Move the try/catch inside the while so a thrown subscribe or a thrown
stream iteration logs once, applies a 250ms→5s exponential backoff, and
re-subscribes. Both abort signals still stop the loop on intentional
shutdown. Replace the outer swallow with an error log; under the new
shape it should never fire.
---
 .../opencode/src/cli/cmd/tui/context/sdk.tsx  | 41 +++++++++++++++----
 1 file changed, 32 insertions(+), 9 deletions(-)

diff --git a/packages/opencode/src/cli/cmd/tui/context/sdk.tsx b/packages/opencode/src/cli/cmd/tui/context/sdk.tsx
index 67718c0..9c3ca5c 100644
--- a/packages/opencode/src/cli/cmd/tui/context/sdk.tsx
+++ b/packages/opencode/src/cli/cmd/tui/context/sdk.tsx
@@ -4,6 +4,7 @@ import { useRoute } from "./route"
 import { createPresenceClient, type PresenceClient } from "./presence-client"
 import { createGlobalEmitter } from "@solid-primitives/event-bus"
 import { batch, createEffect, onCleanup, onMount } from "solid-js"
+import { Log } from "@/util/log"
 
 export type EventSource = {
   subscribe: (directory: string | undefined, handler: (event: Event) => void) => Promise<() => void>
@@ -74,19 +75,41 @@ export const { use: useSDK, provider: SDKProvider } = createSimpleContext({
       const ctrl = new AbortController()
       sse = ctrl
       ;(async () => {
+        // Hivemind: a single throw from `subscribe()` or the inner `for await`
+        // used to fall through to the outer `.catch(() => {})` and silently
+        // exit the loop forever — the TUI kept running but stopped seeing any
+        // streaming events until the user Ctrl-C'd and reconnected.
+        // Symptom was "I sent a message and nothing happened, but reconnect
+        // showed the turn ran." Now any transient error is caught inside the
+        // while, logged, briefly backed off, and the loop re-subscribes.
+        let backoff = 0
         while (true) {
           if (abort.signal.aborted || ctrl.signal.aborted) break
-          const events = await sdk.event.subscribe({}, { signal: ctrl.signal })
-
-          for await (const event of events.stream) {
-            if (ctrl.signal.aborted) break
-            handleEvent(event)
+          try {
+            const events = await sdk.event.subscribe({}, { signal: ctrl.signal })
+            backoff = 0
+            for await (const event of events.stream) {
+              if (ctrl.signal.aborted) break
+              handleEvent(event)
+            }
+          } catch (err) {
+            if (ctrl.signal.aborted || abort.signal.aborted) break
+            Log.Default.warn("tui sse stream error, reconnecting", {
+              error: err instanceof Error ? err.message : String(err),
+              backoff,
+            })
+            backoff = Math.min((backoff || 250) * 2, 5000)
+            await new Promise((r) => setTimeout(r, backoff))
+          } finally {
+            if (timer) clearTimeout(timer)
+            if (queue.length > 0) flush()
           }
-
-          if (timer) clearTimeout(timer)
-          if (queue.length > 0) flush()
         }
-      })().catch(() => {})
+      })().catch((err) => {
+        Log.Default.error("tui sse loop exited unexpectedly", {
+          error: err instanceof Error ? err.message : String(err),
+        })
+      })
     }
 
     // Hivemind: presence client. One WebSocket per TUI process, kept
