 import type { TuiPlugin, TuiPluginApi, TuiPluginModule } from "@opencode-ai/plugin/tui"
 import { createMemo, Match, Show, Switch } from "solid-js"
+import { existsSync, readFileSync } from "node:fs"
+import { homedir } from "node:os"
+import { join } from "node:path"
 import { Global } from "@/global"
 
 const id = "internal:home-footer"
 
+// Hivemind: detect connection mode (standalone / hivemind-managed / remote).
+// Replaces the `opencode/plugins/connection-indicator.js` external plugin.
+type HivemindMode = "standalone" | "hivemind" | "remote"
+type HivemindState = { mode: HivemindMode; label: string }
+
+function detectHivemindMode(): HivemindState {
+  let attachUrl: string | null = null
+  for (let i = 0; i < process.argv.length - 1; i++) {
+    const cur = process.argv[i]
+    if (cur === "attach" || cur === "--attach") {
+      const next = process.argv[i + 1]
+      if (typeof next === "string" && next.startsWith("http")) {
+        attachUrl = next
+        break
+      }
+    }
+  }
+  if (!attachUrl) return { mode: "standalone", label: "standalone" }
+
+  let host = ""
+  let port = ""
+  try {
+    const u = new URL(attachUrl)
+    host = u.hostname
+    port = u.port
+  } catch {
+    return { mode: "standalone", label: "standalone" }
+  }
+
+  try {
+    const serverFile = join(homedir(), ".cache", "hivemind", "server.json")
+    if (existsSync(serverFile)) {
+      const managed = JSON.parse(readFileSync(serverFile, "utf8"))
+      if (host === managed.hostname && port === String(managed.port)) {
+        return { mode: "hivemind", label: `hivemind ${host}:${port}` }
+      }
+    }
+  } catch {
+    // fall through to remote
+  }
+  return { mode: "remote", label: `remote ${host}${port ? ":" + port : ""}` }
+}
+
+function HivemindStatus(props: { api: TuiPluginApi }) {
+  const theme = () => props.api.theme.current
+  const state = detectHivemindMode()
+  const bulletColor = () =>
+    state.mode === "hivemind" ? theme().success
+    : state.mode === "remote" ? theme().warning
+    : theme().textMuted
+  const bulletChar = state.mode === "standalone" ? "○" : "●"
+  return (
+    <box flexDirection="row" flexShrink={0} gap={1}>
+      <text fg={bulletColor()}>{bulletChar}</text>
+      <text fg={theme().textMuted}>{state.label}</text>
+    </box>
+  )
+}
+
 function Directory(props: { api: TuiPluginApi }) {
   const theme = () => props.api.theme.current
   const dir = createMemo(() => {
@@ -68,6 +130,7 @@ function View(props: { api: TuiPluginApi }) {
     >
