From a8f106bae3c57b29b3600f6e88c644ce26acb511 Mon Sep 17 00:00:00 2001
From: Lucas Santos <lsantos7654@gmail.com>
Date: Mon, 11 May 2026 01:10:35 -0400
Subject: [PATCH 32/35] fix: tsconfig paths for @opencode-ai/plugin to resolve
 patched source

tsgo resolves @opencode-ai/plugin through node_modules workspace
symlinks that point to @opencode_node_modules (unpatched source).
The paths override skips node_modules entirely and resolves
directly to ../../plugin/src/ in the same @opencode_src tree
where patches are applied.
---
 packages/opencode/tsconfig.json | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/packages/opencode/tsconfig.json b/packages/opencode/tsconfig.json
index ff98863..b73593b 100644
--- a/packages/opencode/tsconfig.json
+++ b/packages/opencode/tsconfig.json
@@ -10,7 +10,10 @@
     "customConditions": ["browser"],
     "paths": {
       "@/*": ["./src/*"],
-      "@tui/*": ["./src/cli/cmd/tui/*"]
+      "@tui/*": ["./src/cli/cmd/tui/*"],
+      "@opencode-ai/plugin": ["../../plugin/src/index.ts"],
+      "@opencode-ai/plugin/tool": ["../../plugin/src/tool.ts"],
+      "@opencode-ai/plugin/tui": ["../../plugin/src/tui.ts"]
     },
     "plugins": [
       {
-- 
2.50.1

