@@ -0,0 +1,189 @@
+import { afterAll, afterEach, describe, expect, test } from "bun:test"
+import path from "path"
+import { pathToFileURL } from "url"
+import { tmpdir } from "../fixture/fixture"
+
+const disableDefault = process.env.OPENCODE_DISABLE_DEFAULT_PLUGINS
+process.env.OPENCODE_DISABLE_DEFAULT_PLUGINS = "1"
+
+const { Plugin } = await import("../../src/plugin/index")
+const { Instance } = await import("../../src/project/instance")
+
+afterEach(async () => {
+  await Instance.disposeAll()
+})
+
+afterAll(() => {
+  if (disableDefault === undefined) {
+    delete process.env.OPENCODE_DISABLE_DEFAULT_PLUGINS
+    return
+  }
+  process.env.OPENCODE_DISABLE_DEFAULT_PLUGINS = disableDefault
+})
+
+// Hivemind: tests for the onFileWrite plugin API. Plugins register
+// (patterns, handler) at load time; engine dispatches handlers only
+// for paths matching at least one pattern. Memory writes are routed
+// through this primitive — see hivemind-memory.ts in the same package.
+
+async function projectWithPlugin(pluginSource: string) {
+  return tmpdir({
+    init: async (dir) => {
+      const file = path.join(dir, "plugin.ts")
+      await Bun.write(file, pluginSource)
+      await Bun.write(
+        path.join(dir, "opencode.json"),
+        JSON.stringify(
+          {
+            $schema: "https://opencode.ai/config.json",
+            plugin: [pathToFileURL(file).href],
+          },
+          null,
+          2,
+        ),
+      )
+    },
+  })
+}
+
+const recorderPlugin = (patterns: string[], stateGlobal: string) =>
+  [
+    "export default async () => ({",
+    "  onFileWrite: {",
+    `    patterns: ${JSON.stringify(patterns)},`,
+    "    handler: async (input) => {",
+    `      (globalThis as any).${stateGlobal} = (globalThis as any).${stateGlobal} ?? []`,
+    `      ;(globalThis as any).${stateGlobal}.push(input)`,
+    "    },",
+    "  },",
+    "})",
+    "",
+  ].join("\n")
+
+describe("plugin.onFileWrite", () => {
+  test("dispatches handler for paths matching the registered pattern", async () => {
+    const stateKey = `__fwHook_${Date.now()}_match`
+    await using tmp = await projectWithPlugin(recorderPlugin(["**/short_memory.md"], stateKey))
+    ;(globalThis as any)[stateKey] = []
+
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        await Plugin.notifyFileWrite({
+          path: "/tmp/x/hivemind/memory/bazel/short_memory.md",
+          sessionID: "ses_test_1",
+          bytes: 9000,
+          tool: "write",
+        })
+      },
+    })
+
+    const calls = (globalThis as any)[stateKey] as Array<{ path: string; bytes: number; tool: string }>
+    expect(calls.length).toBe(1)
+    expect(calls[0].path).toBe("/tmp/x/hivemind/memory/bazel/short_memory.md")
+    expect(calls[0].bytes).toBe(9000)
+    expect(calls[0].tool).toBe("write")
+    delete (globalThis as any)[stateKey]
+  })
+
+  test("skips handler when path does not match the pattern", async () => {
+    const stateKey = `__fwHook_${Date.now()}_skip`
+    await using tmp = await projectWithPlugin(recorderPlugin(["**/short_memory.md"], stateKey))
+    ;(globalThis as any)[stateKey] = []
+
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        await Plugin.notifyFileWrite({
+          path: "/tmp/x/some-other-file.md",
+          sessionID: "ses_test_2",
+          bytes: 100,
+          tool: "write",
+        })
+      },
+    })
+
+    const calls = (globalThis as any)[stateKey] as unknown[]
+    expect(calls.length).toBe(0)
+    delete (globalThis as any)[stateKey]
+  })
+
+  test("zero plugins → notifyFileWrite is a no-op", async () => {
+    // No plugin registered. Just confirm the dispatch doesn't throw.
+    await using tmp = await tmpdir({
+      init: async (dir) => {
+        await Bun.write(
+          path.join(dir, "opencode.json"),
+          JSON.stringify({ $schema: "https://opencode.ai/config.json" }, null, 2),
+        )
+      },
+    })
+
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        await Plugin.notifyFileWrite({
+          path: "/tmp/anything.md",
+          sessionID: "ses_test_3",
+          bytes: 1,
+          tool: "write",
+        })
+        // No assertion needed; not throwing is the contract.
+        expect(true).toBe(true)
+      },
+    })
+  })
+
+  test("handler errors do not propagate", async () => {
+    const throwerPlugin = [
+      "export default async () => ({",
+      "  onFileWrite: {",
+      '    patterns: ["**/short_memory.md"],',
+      "    handler: async () => {",
+      '      throw new Error("intentional handler failure")',
+      "    },",
+      "  },",
+      "})",
+      "",
+    ].join("\n")
+    await using tmp = await projectWithPlugin(throwerPlugin)
+
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        await Plugin.notifyFileWrite({
+          path: "/tmp/x/hivemind/memory/bazel/short_memory.md",
+          sessionID: "ses_test_4",
+          bytes: 9000,
+          tool: "write",
+        })
+        // Reaching this line means the throw was caught by the
+        // hook runtime and didn't propagate.
+        expect(true).toBe(true)
+      },
+    })
+  })
+
+  test("edit tool fires the same hook", async () => {
+    const stateKey = `__fwHook_${Date.now()}_edit`
+    await using tmp = await projectWithPlugin(recorderPlugin(["**/short_memory.md"], stateKey))
+    ;(globalThis as any)[stateKey] = []
+
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        await Plugin.notifyFileWrite({
+          path: "/tmp/x/hivemind/memory/bazel/short_memory.md",
+          sessionID: "ses_test_5",
+          bytes: 9000,
+          tool: "edit",
+        })
+      },
+    })
+
+    const calls = (globalThis as any)[stateKey] as Array<{ tool: string }>
+    expect(calls.length).toBe(1)
+    expect(calls[0].tool).toBe("edit")
+    delete (globalThis as any)[stateKey]
+  })
+})
