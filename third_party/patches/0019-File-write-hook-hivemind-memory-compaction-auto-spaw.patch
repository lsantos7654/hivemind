+import { afterEach, describe, expect, test } from "bun:test"
+import path from "path"
+import os from "os"
+import { tmpdir } from "../fixture/fixture"
+import { Plugin } from "../../src/plugin"
+import { Instance } from "../../src/project/instance"
+import { Session } from "../../src/session"
+import { Log } from "../../src/util/log"
+
+Log.init({ print: false })
+
+afterEach(async () => {
+  await Instance.disposeAll()
+})
+
+// Hivemind: tests for the in-tree HivemindMemoryPlugin (auto-spawn
+// the memory-compaction daemon when an agent's short_memory.md crosses
+// the byte threshold). The plugin is registered as an INTERNAL_PLUGIN
+// so it loads automatically — no manual setup needed.
+
+const projectRoot = path.join(__dirname, "../..")
+
+async function configWithThreshold(threshold: number): Promise<{ path: string; cleanup: () => Promise<void> }> {
+  // The plugin reads hivemind.json from process.cwd() relative paths.
+  // For the test we point the plugin at a tmp file via cwd swap.
+  const tmpDir = path.join(os.tmpdir(), `hivemind-memtest-${Date.now()}-${Math.random()}`)
+  await Bun.write(
+    path.join(tmpDir, "hivemind.json"),
+    JSON.stringify({ memory: { compaction_threshold_bytes: threshold } }),
+  )
+  return {
+    path: tmpDir,
+    cleanup: async () => {
+      await import("node:fs/promises").then((fs) => fs.rm(tmpDir, { recursive: true, force: true }))
+    },
+  }
+}
+
+describe("hivemind-memory plugin", () => {
+  test("sub-threshold write does not spawn a daemon session", async () => {
+    const cfg = await configWithThreshold(100_000)  // very high — never triggers
+    const cwd = process.cwd()
+    process.chdir(cfg.path)
+    try {
+      await Instance.provide({
+        directory: projectRoot,
+        fn: async () => {
+          const main = await Session.create({})
+          const before = (await Session.children(main.id)).length
+
+          await Plugin.notifyFileWrite({
+            path: "/Users/santos/.config/opencode/hivemind/memory/bazel/short_memory.md",
+            sessionID: main.id,
+            bytes: 1024,  // way below threshold
+            tool: "write",
+          })
+
+          await new Promise((r) => setTimeout(r, 100))
+          const after = (await Session.children(main.id)).length
