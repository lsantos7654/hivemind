diff --git a/packages/opencode/src/tool/read-task-result.ts b/packages/opencode/src/tool/read-task-result.ts
new file mode 100644
index 0000000..b5281a3
--- /dev/null
+++ b/packages/opencode/src/tool/read-task-result.ts
@@ -0,0 +1,64 @@
+// Hivemind: pull a completed background-task result out of
+// SessionBackground's per-parent buffer. Pairs with the `background: true`
+// parameter on the Task tool — when the engine signals via
+// <system-reminder> that a task is ready, the model calls this tool with
+// the corresponding task_id to consume the result.
+//
+// Strict pull semantics. If the task is still running this returns an
+// indication, not the result, and leaves the registry untouched. If the
+// task is unknown (consumed already or never spawned by this parent)
+// this returns an error. A task is consumable only by the parent that
+// spawned it — cross-session reads are rejected.
+import z from "zod"
+import { Tool } from "./tool"
+import { SessionBackground } from "../session/background"
+import { SessionID } from "../session/schema"
+
+const DESCRIPTION = `Read the result of a background Task spawned with background=true.
+
+Strict pull: call this tool only after you see a <system-reminder> announcing the task_id is ready. If the task is still running, the tool returns a status indicator and you should wait for the next reminder. After a successful read, the result is consumed and a second call with the same task_id returns "no such task."
+
+Tasks are scoped to the parent session that spawned them — you can only read results for background tasks you spawned yourself.`
+
+const parameters = z.object({
+  task_id: z
+    .string()
+    .describe("The task_id returned by a Task call with background=true. Must match a task this session spawned."),
+})
+
+type Metadata = {
+  taskID: string
+  status: "complete" | "running" | "unknown"
+}
+
+export const ReadTaskResultTool = Tool.define("read_task_result", {
+  description: DESCRIPTION,
+  parameters,
+  async execute(params: z.infer<typeof parameters>, ctx: Tool.Context<Metadata>) {
+    const taskID = SessionID.make(params.task_id)
+    const entry = SessionBackground.consume(ctx.sessionID, taskID)
+    if (!entry) {
+      return {
+        title: "read_task_result (unknown)",
+        metadata: { taskID: params.task_id, status: "unknown" as const },
+        output: `<task_result task_id="${params.task_id}" status="unknown">No background task with this task_id was spawned by the current session, or its result has already been consumed.</task_result>`,
+      }
+    }
+    if (entry.status !== "complete") {
+      return {
+        title: "read_task_result (running)",
+        metadata: { taskID: params.task_id, status: "running" as const },
+        output: `<task_result task_id="${params.task_id}" status="running">Task has not yet completed. Wait for the next <system-reminder> announcing readiness.</task_result>`,
+      }
+    }
+    return {
+      title: "read_task_result",
+      metadata: { taskID: params.task_id, status: "complete" as const },
+      output: [
+        `<task_result task_id="${params.task_id}">`,
+        entry.result ?? "",
+        "</task_result>",
+      ].join("\n"),
+    }
+  },
+})
