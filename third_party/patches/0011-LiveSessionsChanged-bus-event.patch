From b71c5a819a00dc6542ae7244812da4c0db35c491 Mon Sep 17 00:00:00 2001
From: Lucas Santos <lsantos7654@gmail.com>
Date: Mon, 27 Apr 2026 23:01:18 -0400
Subject: [PATCH 11/16] LiveSessionsChanged bus event

Emits session.live.changed on every increment/decrement of the
per-session SSE subscriber map (introduced in patch 0009). The payload
carries the full set of currently-live session IDs.

Mechanism:
  - New BusEvent definition LiveSessionsChanged in event.ts.
  - _incr / _decr now call a shared _publishChange helper that fires
    Bus.publish(LiveSessionsChanged, { sessions: liveSessions() })
    fire-and-forget.

Pairs with the TUI footer indicator that subscribes to this event to
render a live count without polling. Other connected clients (a future
hivemind dashboard, a watching CI script) can do the same.
---
 packages/opencode/src/server/routes/event.ts | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/packages/opencode/src/server/routes/event.ts b/packages/opencode/src/server/routes/event.ts
index 2d84754..b9ba0a3 100644
--- a/packages/opencode/src/server/routes/event.ts
+++ b/packages/opencode/src/server/routes/event.ts
@@ -1,6 +1,7 @@
 import { Hono } from "hono"
 import { describeRoute, resolver } from "hono-openapi"
 import { streamSSE } from "hono/streaming"
+import z from "zod"
 import { Log } from "@/util/log"
 import { BusEvent } from "@/bus/bus-event"
 import { Bus } from "@/bus"
@@ -8,6 +9,17 @@ import { AsyncQueue } from "../../util/queue"

 const log = Log.create({ service: "server" })

+// Hivemind: emitted on every change to the per-session subscriber map so
+// connected clients (e.g. the TUI footer) can render a live count without
+// polling. The payload carries the full set of currently-live session IDs;
+// subscribers can derive .length, diff against their last known set, etc.
+export const LiveSessionsChanged = BusEvent.define(
+  "session.live.changed",
+  z.object({
+    sessions: z.array(z.string()),
+  }),
+)
+
 // Hivemind: per-session count of currently-open SSE subscriptions.
 // A TUI subscribes to `/event?sessionID=<current>` for whichever session
 // it's attached to; the count is incremented when the stream opens and
@@ -19,14 +31,22 @@ const log = Log.create({ service: "server" })
 // route backwards-compatible for any non-TUI consumer.
 const _subscriberCount = new Map<string, number>()

+function _publishChange(): void {
+  Bus.publish(LiveSessionsChanged, { sessions: liveSessions() }).catch((err) =>
+    log.error("failed to publish LiveSessionsChanged", { err }),
+  )
+}
+
 function _incr(sessionID: string): void {
   _subscriberCount.set(sessionID, (_subscriberCount.get(sessionID) ?? 0) + 1)
+  _publishChange()
 }

 function _decr(sessionID: string): void {
   const next = (_subscriberCount.get(sessionID) ?? 0) - 1
   if (next <= 0) _subscriberCount.delete(sessionID)
   else _subscriberCount.set(sessionID, next)
+  _publishChange()
 }

 export function liveSessions(): string[] {
