 .../cmd/tui/feature-plugins/home/footer.tsx   | 42 +++++++++++++++++++
 1 file changed, 42 insertions(+)

diff --git a/packages/opencode/src/cli/cmd/tui/feature-plugins/home/footer.tsx b/packages/opencode/src/cli/cmd/tui/feature-plugins/home/footer.tsx
index db87562..a83a152 100644
--- a/packages/opencode/src/cli/cmd/tui/feature-plugins/home/footer.tsx
+++ b/packages/opencode/src/cli/cmd/tui/feature-plugins/home/footer.tsx
@@ -140,6 +140,47 @@ function LiveSessions(props: { api: TuiPluginApi }) {
   )
 }

+// Hivemind: shows the count of background-mode Task children currently
+// running across all parents. Initial value comes from
+// GET /global/background-tasks; updates arrive via the
+// `session.background.changed` bus event, which the engine fires on every
+// SessionBackground.register / .complete / .consume mutation (patch 0017).
+// Counts only `running` entries — completed-but-unconsumed results are the
+// model's concern, not the user's. No polling.
+function BackgroundTasks(props: { api: TuiPluginApi }) {
+  const theme = () => props.api.theme.current
+  const [count, setCount] = createSignal(0)
+
+  function _runningOnly(tasks: { status?: string }[]): number {
+    return tasks.filter((t) => t.status === "running").length
+  }
+
+  onMount(async () => {
+    try {
+      const result = await props.api.client.global.backgroundTasks()
+      const tasks = (result as { data?: { tasks?: { status?: string }[] } }).data?.tasks ?? []
+      setCount(_runningOnly(tasks))
+    } catch {
+      // Initial fetch is best-effort; the bus event will populate the count
+      // as soon as anything changes.
+    }
+  })
+
+  const unsubscribe = props.api.event.on("session.background.changed", (event) => {
+    setCount(_runningOnly(event.properties.tasks))
+  })
+  onCleanup(unsubscribe)
+
+  return (
+    <box flexDirection="row" flexShrink={0} gap={1}>
+      <text fg={count() > 0 ? theme().success : theme().textMuted}>●</text>
+      <text fg={theme().textMuted}>
+        {count()} bg
+      </text>
+    </box>
+  )
+}
+
 function Version(props: { api: TuiPluginApi }) {
   const theme = () => props.api.theme.current

@@ -165,6 +206,7 @@ function View(props: { api: TuiPluginApi }) {
       <Directory api={props.api} />
       <Mcp api={props.api} />
       <LiveSessions api={props.api} />
+      <BackgroundTasks api={props.api} />
       <HivemindStatus api={props.api} />
       <box flexGrow={1} />
       <Version api={props.api} />
