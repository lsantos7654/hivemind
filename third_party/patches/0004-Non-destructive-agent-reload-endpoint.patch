 export namespace Agent {
   export const Info = z
@@ -51,10 +53,18 @@ export namespace Agent {
     })
   export type Info = z.infer<typeof Info>

+  // Hivemind: emitted by reload() so subscribers can refresh agent UI
+  // without going through /global/dispose (which kills MCP subprocesses).
+  export const AgentsChanged = BusEvent.define(
+    "agent.changed",
+    z.object({ count: z.number() }),
+  )
+
   export interface Interface {
     readonly get: (agent: string) => Effect.Effect<Agent.Info>
     readonly list: () => Effect.Effect<Agent.Info[]>
     readonly defaultAgent: () => Effect.Effect<string>
+    readonly reload: () => Effect.Effect<{ count: number }, never, Bus.Service>
     readonly generate: (input: {
       description: string
       model?: { providerID: ProviderID; modelID: ModelID }
@@ -326,6 +336,17 @@ export namespace Agent {
         defaultAgent: Effect.fn("Agent.defaultAgent")(function* () {
           return yield* InstanceState.useEffect(state, (s) => s.defaultAgent())
         }),
+        // Hivemind: re-read agents/*.md from disk and rebuild the per-instance
+        // Agent registry. Invalidates Config + Agent state caches without
+        // calling Instance.dispose, so MCP subprocesses survive.
+        reload: Effect.fn("Agent.reload")(function* () {
+          yield* config.invalidateState()
+          yield* InstanceState.invalidate(state)
+          const list = yield* InstanceState.useEffect(state, (s) => s.list())
+          const bus = yield* Bus.Service
+          yield* bus.publish(AgentsChanged, { count: list.length }).pipe(Effect.ignore)
+          return { count: list.length }
+        }),
         generate: Effect.fn("Agent.generate")(function* (input: {
           description: string
           model?: { providerID: ProviderID; modelID: ModelID }
@@ -424,4 +445,29 @@ export namespace Agent {
   export async function generate(input: { description: string; model?: { providerID: ProviderID; modelID: ModelID } }) {
     return runPromise((svc) => svc.generate(input))
   }
+
+  /**
+   * Hivemind: reload the agent registry for every active instance. Iterates
+   * `Instance.directories()`, provides each context, and runs `reload()` so
+   * agents/*.md changes are picked up without disposing the InstanceState
+   * (which would SIGTERM MCP subprocesses and kill in-flight sessions).
+   *
+   * Used by the `POST /global/reload-agents` route.
+   */
+  export async function reloadAll(): Promise<{ instances: number; agents: number }> {
+    const dirs = Instance.directories()
+    let agents = 0
+    for (const directory of dirs) {
+      try {
+        const result = await Instance.provide({
+          directory,
+          fn: () => runPromise((svc) => svc.reload()),
+        })
+        agents += result.count
+      } catch {
+        // Skip instances that failed to load; the dispose path skips them too.
+      }
+    }
+    return { instances: dirs.length, agents }
+  }
 }
