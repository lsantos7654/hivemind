+// Hivemind: emitted on every change to the per-client presence map so
+// connected clients (e.g. the TUI footer) can render a live count
+// without polling. `sessions` is every currently-focused session ID
+// plus the direct children of every focused root; `subagents` is the
+// subset whose `parentID` is set. The TUI footer derives a "root
+// sessions" count via `sessions.length - subagents.length` and shows
+// the two as separate pills.
+export const LiveSessionsChanged = BusEvent.define(
+  "session.live.changed",
+  z.object({
+    sessions: z.array(z.string()),
+    subagents: z.array(z.string()),
+  }),
+)
+
+// Hivemind: per-client presence state. Each TUI process opens ONE
+// long-lived SSE on `/event` with header `X-Client-ID: <uuid>` on
+// mount, kept alive for the life of the TUI. The SSE connection is
+// the presence beacon — when it closes, the client's entry is removed
+// and any sessions it owned drop out of the live set. Focus changes
+// within the TUI are signaled out-of-band via `POST /event/focus`.
+//
+// Single connection per client (not per session view) so cleanup is
+// one-shot: `stream.onAbort` fires once when the TUI dies, taking the
+// entire entry with it. There is no refcount and no race window
+// between a "register presence" mutation and an abort-listener
+// registration — the listener is registered before the mutation, and
+// `stream.aborted` is rechecked synchronously after.
+//
+// Subscriptions without an `X-Client-ID` header (the legacy "subscribe
+// to all events" shape) do not contribute to liveness — the route is
+// backwards-compatible for non-TUI consumers.
+const _clients = new Map<string, { focus: string | null }>()
+
+function _publishChange(): void {
+  // Fire-and-forget the expansion so call-sites stay sync. Each call
+  // does one Session.get (per focused ID) and at most one
+  // Session.children (per focused root) — typically 0–2 single-indexed
+  // queries per change, <1ms each.
+  void (async () => {
+    try {
+      const expanded = await expandedLiveSet()
+      await Bus.publish(LiveSessionsChanged, expanded)
+    } catch (err) {
+      log.error("failed to publish LiveSessionsChanged", { err })
+    }
+  })()
+}
+
+/**
+ * Hivemind: raw set of currently-focused session IDs across all live
+ * clients. Useful for diagnostics; the route + bus event use
+ * `expandedLiveSet` which also pulls direct children of every focused
+ * root from the DB.
+ */
+export function liveSessions(): string[] {
+  const focused = new Set<string>()
+  for (const c of _clients.values()) {
+    if (c.focus) focused.add(c.focus)
+  }
+  return [...focused]
+}
+
+/**
+ * Hivemind: expanded live set used by both the bus event and the
+ * `/global/live-sessions` route.
+ *
+ * `sessions` = focused IDs ∪ direct children of every focused root.
+ * `subagents` = focused IDs that are subagents ∪ direct children of
+ *               every focused root.
+ *
+ * Both contain the same subagent IDs (so `subagents ⊆ sessions`); the
+ * footer reads `sessions.length - subagents.length` to derive the root
+ * count and `subagents.length` for the subagents pill, both correct.
+ *
+ * Subagents cannot spawn subagents (depth-1 contract per `task.ts`
+ * permission overlay), so a single `Session.children(rootID)` per
+ * focused root is exhaustive — no recursive descent.
+ */
+export async function expandedLiveSet(): Promise<{
+  sessions: string[]
+  subagents: string[]
+}> {
+  const focused = liveSessions()
+  if (focused.length === 0) return { sessions: [], subagents: [] }
+
+  const sessionsSet = new Set<string>(focused)
+  const subagentsSet = new Set<string>()
+
+  for (const id of focused) {
+    try {
+      const session = await Session.get(SessionID.make(id))
+      if (session.parentID != null) {
+        subagentsSet.add(id)
+        continue
+      }
+      const children = await Session.children(SessionID.make(id))
+      for (const child of children) {
+        sessionsSet.add(child.id)
+        subagentsSet.add(child.id)
+      }
+    } catch (err) {
+      // DB miss; fall through with what we have. A slight footer
+      // miscount is preferable to failing the publish.
+      log.error("expandedLiveSet: lookup failed", { id, err })
+    }
+  }
+
+  return { sessions: [...sessionsSet], subagents: [...subagentsSet] }
+}
