-function LiveSessions(props: { api: TuiPluginApi }) {
+// Hivemind: split the live-tracker pill into two — root sessions
+// (parentID == null in the live set) and subagents (parentID set, i.e.
+// Task-spawned children). Server publishes both fields on every
+// `session.live.changed`. Initial values come from GET /global/live-sessions
+// on mount; updates flow via the bus event. No polling.
+function Sessions(props: { api: TuiPluginApi }) {
   const theme = () => props.api.theme.current
   const [count, setCount] = createSignal(0)

+  function _rootCount(sessions: string[], subagents: string[]): number {
+    return Math.max(0, sessions.length - subagents.length)
+  }
+
   onMount(async () => {
     try {
       const result = await props.api.client.global.liveSessions()
-      const sessions = (result as { data?: { sessions?: string[] } }).data?.sessions ?? []
-      setCount(sessions.length)
+      const data = (result as { data?: { sessions?: string[]; subagents?: string[] } }).data
+      setCount(_rootCount(data?.sessions ?? [], data?.subagents ?? []))
     } catch {
-      // Initial fetch is best-effort; the bus event will populate the count
-      // as soon as anything changes.
+      // Initial fetch is best-effort; the bus event populates on next change.
     }
   })

   const unsubscribe = props.api.event.on("session.live.changed", (event) => {
-    setCount(event.properties.sessions.length)
+    setCount(_rootCount(event.properties.sessions, event.properties.subagents))
   })
   onCleanup(unsubscribe)

