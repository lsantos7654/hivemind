Date: Mon, 27 Apr 2026 23:02:58 -0400
Subject: [PATCH 12/16] TUI footer live sessions indicator
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Adds a "● N live" indicator to the home footer that reports how many
sessions a TUI is currently attached to. Sits between the MCP and
hivemind connection indicators. Bullet is theme().success when the
count is non-zero, theme().textMuted when zero — same convention as
HivemindStatus.

Mechanism:
  - SDK: new Global.liveSessions() method on the typed client (called
    once on mount for initial state) plus the matching
    EventSessionLiveChanged variant added to the Event union so
    api.event.on("session.live.changed", ...) is type-safe.
  - footer.tsx: new LiveSessions component using createSignal for the
    count, onMount for the initial fetch, and api.event.on (cleaned
    up via onCleanup) for reactive updates.

The TUI's existing SSE stream already carries the bus events; this
component reuses that channel — no extra socket, no polling.

Pairs with patch 0011 (which fires LiveSessionsChanged on every
counter mutation) so the indicator updates within one event of any
change to the live set.
---
 .../cmd/tui/feature-plugins/home/footer.tsx   | 37 ++++++++++++++++++-
 1 file changed, 36 insertions(+), 1 deletion(-)

diff --git a/packages/opencode/src/cli/cmd/tui/feature-plugins/home/footer.tsx b/packages/opencode/src/cli/cmd/tui/feature-plugins/home/footer.tsx
index c876c4a..db87562 100644
--- a/packages/opencode/src/cli/cmd/tui/feature-plugins/home/footer.tsx
+++ b/packages/opencode/src/cli/cmd/tui/feature-plugins/home/footer.tsx
@@ -1,5 +1,5 @@
 import type { TuiPlugin, TuiPluginApi, TuiPluginModule } from "@opencode-ai/plugin/tui"
-import { createMemo, Match, Show, Switch } from "solid-js"
+import { createMemo, createSignal, Match, onCleanup, onMount, Show, Switch } from "solid-js"
 import { existsSync, readFileSync } from "node:fs"
 import { homedir } from "node:os"
 import { join } from "node:path"
@@ -106,6 +106,40 @@ function Mcp(props: { api: TuiPluginApi }) {
   )
 }

+// Hivemind: shows the count of sessions currently attached by a TUI client.
+// Initial value comes from GET /global/live-sessions; updates arrive via the
+// `session.live.changed` bus event, which the engine fires on every SSE
+// subscriber map increment/decrement (patches 0009 + 0011). No polling.
+function LiveSessions(props: { api: TuiPluginApi }) {
+  const theme = () => props.api.theme.current
+  const [count, setCount] = createSignal(0)
+
+  onMount(async () => {
+    try {
+      const result = await props.api.client.global.liveSessions()
+      const sessions = (result as { data?: { sessions?: string[] } }).data?.sessions ?? []
+      setCount(sessions.length)
+    } catch {
+      // Initial fetch is best-effort; the bus event will populate the count
+      // as soon as anything changes.
+    }
+  })
+
+  const unsubscribe = props.api.event.on("session.live.changed", (event) => {
+    setCount(event.properties.sessions.length)
+  })
+  onCleanup(unsubscribe)
+
+  return (
+    <box flexDirection="row" flexShrink={0} gap={1}>
+      <text fg={count() > 0 ? theme().success : theme().textMuted}>●</text>
+      <text fg={theme().textMuted}>
+        {count()} live
+      </text>
+    </box>
+  )
+}
+
 function Version(props: { api: TuiPluginApi }) {
   const theme = () => props.api.theme.current

@@ -130,6 +164,7 @@ function View(props: { api: TuiPluginApi }) {
     >
       <Directory api={props.api} />
       <Mcp api={props.api} />
+      <LiveSessions api={props.api} />
       <HivemindStatus api={props.api} />
       <box flexGrow={1} />
       <Version api={props.api} />
