diff --git a/packages/opencode/test/server/event.test.ts b/packages/opencode/test/server/event.test.ts
new file mode 100644
index 0000000..aa82043
--- /dev/null
+++ b/packages/opencode/test/server/event.test.ts
@@ -0,0 +1,220 @@
+import { afterEach, describe, expect, test } from "bun:test"
+import { Instance } from "../../src/project/instance"
+import { Server } from "../../src/server/server"
+import { Log } from "../../src/util/log"
+import { tmpdir } from "../fixture/fixture"
+
+Log.init({ print: false })
+
+afterEach(async () => {
+  await Instance.disposeAll()
+})
+
+// Hivemind: Pulls `data:` lines off a `text/event-stream` response and
+// JSON-parses each as an event. Skips connection / heartbeat sentinels
+// when asked, so tests can wait for the next "real" bus event.
+function readSSE(stream: ReadableStream<Uint8Array>) {
+  const reader = stream.getReader()
+  const decoder = new TextDecoder()
+  let buf = ""
+
+  async function next(): Promise<{ type: string; properties?: unknown }> {
+    while (true) {
+      const idx = buf.indexOf("\n\n")
+      if (idx >= 0) {
+        const frame = buf.slice(0, idx)
+        buf = buf.slice(idx + 2)
+        const line = frame.split("\n").find((l) => l.startsWith("data:"))
+        if (line) return JSON.parse(line.slice(5).trim())
+        continue
+      }
+      const { value, done } = await reader.read()
+      if (done) throw new Error("stream ended")
+      buf += decoder.decode(value, { stream: true })
+    }
+  }
+
+  async function nextOfType(types: ReadonlyArray<string>): Promise<{ type: string; properties?: unknown }> {
+    while (true) {
+      const ev = await next()
+      if (types.includes(ev.type)) return ev
+    }
+  }
+
+  return {
+    next,
+    nextOfType,
+    cancel: () => reader.cancel(),
+  }
+}
+
+async function liveSessions(app: ReturnType<typeof Server.Default>["app"]) {
+  const res = await app.request("/global/live-sessions")
+  expect(res.status).toBe(200)
+  return (await res.json()) as { sessions: string[]; subagents: string[] }
+}
+
+describe("event presence + focus", () => {
+  test("subscriptions without X-Client-ID don't contribute to liveness", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const app = Server.Default().app
+        const res = await app.request("/event")
+        expect(res.status).toBe(200)
+        const sse = readSSE(res.body!)
+        const first = await sse.next()
+        expect(first.type).toBe("server.connected")
+
+        const live = await liveSessions(app)
+        expect(live.sessions).toEqual([])
+        expect(live.subagents).toEqual([])
+
+        await sse.cancel()
+      },
+    })
+  })
+
+  test("X-Client-ID registers a client with focus = null", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const app = Server.Default().app
+        const res = await app.request("/event", { headers: { "X-Client-ID": "client-A" } })
+        const sse = readSSE(res.body!)
+        const first = await sse.next()
+        expect(first.type).toBe("server.connected")
+
+        // _publishChange is fire-and-forget; let the microtask run.
+        await Bun.sleep(20)
+
+        const live = await liveSessions(app)
+        // Focus is null until POST /event/focus, so nothing is live yet.
+        expect(live.sessions).toEqual([])
+        expect(live.subagents).toEqual([])
+
+        await sse.cancel()
+      },
+    })
+  })
+
+  test("POST /event/focus { sessionID } puts the client's focus into the live set", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const app = Server.Default().app
+        const res = await app.request("/event", { headers: { "X-Client-ID": "client-A" } })
+        const sse = readSSE(res.body!)
+        await sse.next() // server.connected
+        await Bun.sleep(20) // let the initial _publishChange flush
+
+        const focusRes = await app.request("/event/focus", {
+          method: "POST",
+          headers: { "X-Client-ID": "client-A", "Content-Type": "application/json" },
+          body: JSON.stringify({ sessionID: "ses_test_root" }),
+        })
+        expect(focusRes.status).toBe(200)
+        await Bun.sleep(20)
+
+        const live = await liveSessions(app)
+        expect(live.sessions).toContain("ses_test_root")
+
+        await sse.cancel()
+      },
+    })
+  })
+
+  test("cancelling the SSE stream removes the client from the live set", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const app = Server.Default().app
+        const res = await app.request("/event", { headers: { "X-Client-ID": "client-A" } })
+        const sse = readSSE(res.body!)
+        await sse.next() // server.connected
+        await Bun.sleep(20)
+
+        // Set focus so the client appears in `sessions`.
+        await app.request("/event/focus", {
+          method: "POST",
+          headers: { "X-Client-ID": "client-A", "Content-Type": "application/json" },
+          body: JSON.stringify({ sessionID: "ses_test_root" }),
+        })
+        await Bun.sleep(20)
+        const before = await liveSessions(app)
+        expect(before.sessions).toContain("ses_test_root")
+
+        // The leak-catcher: cancelling the body's reader fires
+        // `stream.onAbort` on the server, which deletes the client.
+        await sse.cancel()
+        await Bun.sleep(50)
+
+        const after = await liveSessions(app)
+        expect(after.sessions).toEqual([])
+      },
+    })
+  })
+
+  test("POST /event/focus without a registered SSE returns 404", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const app = Server.Default().app
+        const res = await app.request("/event/focus", {
+          method: "POST",
+          headers: { "X-Client-ID": "ghost-client", "Content-Type": "application/json" },
+          body: JSON.stringify({ sessionID: "ses_test_root" }),
+        })
+        expect(res.status).toBe(404)
+      },
+    })
+  })
+
+  test("two clients with distinct focuses, then one disconnects", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const app = Server.Default().app
+
+        const resA = await app.request("/event", { headers: { "X-Client-ID": "client-A" } })
+        const sseA = readSSE(resA.body!)
+        await sseA.next()
+
+        const resB = await app.request("/event", { headers: { "X-Client-ID": "client-B" } })
+        const sseB = readSSE(resB.body!)
+        await sseB.next()
+        await Bun.sleep(20)
+
+        await app.request("/event/focus", {
+          method: "POST",
+          headers: { "X-Client-ID": "client-A", "Content-Type": "application/json" },
+          body: JSON.stringify({ sessionID: "ses_root_A" }),
+        })
+        await app.request("/event/focus", {
+          method: "POST",
+          headers: { "X-Client-ID": "client-B", "Content-Type": "application/json" },
+          body: JSON.stringify({ sessionID: "ses_root_B" }),
+        })
+        await Bun.sleep(20)
+
+        const both = await liveSessions(app)
+        expect(both.sessions.sort()).toEqual(["ses_root_A", "ses_root_B"])
+
+        // Only client A goes away — B's focus must remain live.
+        await sseA.cancel()
+        await Bun.sleep(50)
+
+        const onlyB = await liveSessions(app)
+        expect(onlyB.sessions).toEqual(["ses_root_B"])
+
+        await sseB.cancel()
+      },
+    })
+  })
+})
