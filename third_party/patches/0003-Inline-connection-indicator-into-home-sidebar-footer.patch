From 68573673c1fdadfb3d2fd4dc9dfddde9547d4892 Mon Sep 17 00:00:00 2001
From: Lucas Santos <lsantos7654@gmail.com>
Date: Mon, 20 Apr 2026 21:22:13 -0400
Subject: [PATCH 03/17] Inline connection indicator into home + sidebar footers

Replaces the deprecated `opencode/plugins/connection-indicator.js` TUI
plugin with a native source-level patch that renders the same indicator
(standalone / hivemind-managed / remote) inside opencode's two built-in
footer plugins:

  packages/opencode/src/cli/cmd/tui/feature-plugins/home/footer.tsx
  packages/opencode/src/cli/cmd/tui/feature-plugins/sidebar/footer.tsx

The detection logic is identical to the original plugin: scan
`process.argv` for an `attach`/`--attach <url>` pair, parse the URL,
compare against `~/.cache/hivemind/server.json` to distinguish a
hivemind-managed server from a remote one.

Hunks use full-file context (-U999) because Bazel's Starlark patch
parser is stricter than `patch(1)` and can mis-track positions across
hunks with large gaps; one giant hunk per file sidesteps that.
---
 .../cmd/tui/feature-plugins/home/footer.tsx   | 63 +++++++++++++++++++
 .../tui/feature-plugins/sidebar/footer.tsx    | 59 +++++++++++++++++
 2 files changed, 122 insertions(+)

diff --git a/packages/opencode/src/cli/cmd/tui/feature-plugins/home/footer.tsx b/packages/opencode/src/cli/cmd/tui/feature-plugins/home/footer.tsx
index 8047c26..c876c4a 100644
--- a/packages/opencode/src/cli/cmd/tui/feature-plugins/home/footer.tsx
+++ b/packages/opencode/src/cli/cmd/tui/feature-plugins/home/footer.tsx
@@ -1,9 +1,71 @@
 import type { TuiPlugin, TuiPluginApi, TuiPluginModule } from "@opencode-ai/plugin/tui"
 import { createMemo, Match, Show, Switch } from "solid-js"
+import { existsSync, readFileSync } from "node:fs"
+import { homedir } from "node:os"
+import { join } from "node:path"
 import { Global } from "@/global"

 const id = "internal:home-footer"

+// Hivemind: detect connection mode (standalone / hivemind-managed / remote).
+// Replaces the `opencode/plugins/connection-indicator.js` external plugin.
+type HivemindMode = "standalone" | "hivemind" | "remote"
+type HivemindState = { mode: HivemindMode; label: string }
+
+function detectHivemindMode(): HivemindState {
+  let attachUrl: string | null = null
+  for (let i = 0; i < process.argv.length - 1; i++) {
+    const cur = process.argv[i]
+    if (cur === "attach" || cur === "--attach") {
+      const next = process.argv[i + 1]
+      if (typeof next === "string" && next.startsWith("http")) {
+        attachUrl = next
+        break
+      }
+    }
+  }
+  if (!attachUrl) return { mode: "standalone", label: "standalone" }
+
+  let host = ""
+  let port = ""
+  try {
+    const u = new URL(attachUrl)
+    host = u.hostname
+    port = u.port
+  } catch {
+    return { mode: "standalone", label: "standalone" }
+  }
+
+  try {
+    const serverFile = join(homedir(), ".cache", "hivemind", "server.json")
+    if (existsSync(serverFile)) {
+      const managed = JSON.parse(readFileSync(serverFile, "utf8"))
+      if (host === managed.hostname && port === String(managed.port)) {
+        return { mode: "hivemind", label: `hivemind ${host}:${port}` }
+      }
+    }
+  } catch {
+    // fall through to remote
+  }
+  return { mode: "remote", label: `remote ${host}${port ? ":" + port : ""}` }
+}
+
+function HivemindStatus(props: { api: TuiPluginApi }) {
+  const theme = () => props.api.theme.current
+  const state = detectHivemindMode()
+  const bulletColor = () =>
+    state.mode === "hivemind" ? theme().success
+    : state.mode === "remote" ? theme().warning
+    : theme().textMuted
+  const bulletChar = state.mode === "standalone" ? "○" : "●"
+  return (
+    <box flexDirection="row" flexShrink={0} gap={1}>
+      <text fg={bulletColor()}>{bulletChar}</text>
+      <text fg={theme().textMuted}>{state.label}</text>
+    </box>
+  )
+}
+
 function Directory(props: { api: TuiPluginApi }) {
   const theme = () => props.api.theme.current
   const dir = createMemo(() => {
@@ -68,6 +130,7 @@ function View(props: { api: TuiPluginApi }) {
     >
       <Directory api={props.api} />
       <Mcp api={props.api} />
+      <HivemindStatus api={props.api} />
       <box flexGrow={1} />
       <Version api={props.api} />
     </box>
