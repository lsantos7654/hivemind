diff --git a/packages/opencode/src/server/routes/presence.ts b/packages/opencode/src/server/routes/presence.ts
new file mode 100644
index 0000000..c35f91e
--- /dev/null
+++ b/packages/opencode/src/server/routes/presence.ts
@@ -0,0 +1,123 @@
+import { Hono } from "hono"
+import type { UpgradeWebSocket } from "hono/ws"
+import z from "zod"
+import { Log } from "@/util/log"
+import { BusEvent } from "@/bus/bus-event"
+
+const log = Log.create({ service: "server" })
+
+// Hivemind: kept for SDK type generation. The TUI receives presence
+// updates over the `/presence` WebSocket itself (see _broadcast below);
+// this BusEvent is no longer published from the server, but its
+// definition is still emitted into `@opencode-ai/sdk` so the
+// `Event["session.live.changed"]` union member exists for plugins
+// (the TUI footer's `api.event.on("session.live.changed", ...)` keeps
+// working because `sdk.tsx` synthesizes the event from incoming WS
+// messages and feeds it to the local emitter).
+export const LiveSessionsChanged = BusEvent.define(
+  "session.live.changed",
+  z.object({
+    sessions: z.array(z.string()),
+  }),
+)
+
+// Hivemind: per-client presence state. Each TUI process opens ONE
+// long-lived WebSocket on `/presence` for the life of the TUI. The
+// connection is the presence beacon — when it closes (clean exit,
+// SIGINT, kill, network drop), the WebSocket protocol's close frame
+// triggers `onClose` synchronously and the entry is removed.
+//
+// The map is keyed by the underlying `ServerWebSocket` (`wsContext.raw`).
+// Hono creates a *new* `WSContext` wrapper on each callback, so using
+// the wrapper itself as a Map key would fail to look up entries
+// between `onOpen` and `onMessage`. The raw socket is stable across
+// callbacks for the lifetime of the connection.
+//
+// The map lives at module scope (not in `InstanceState`) because
+// presence is a global property of the engine, not of any one project
+// directory: multiple TUIs in different worktrees must see each other's
+// focus values. Updates fan out over the same WebSocket via
+// `_broadcast()`; routing them through the per-instance `Bus` would
+// silently drop cross-directory deliveries.
+//
+// Focus is signaled in-band over the same WebSocket via JSON messages:
+//   client → server: { "type": "focus",          "sessionID": "ses_..." | null }
+//   server → client: { "type": "live-sessions",  "sessions":  string[] }
+// Updating focus is a single state mutation on the existing entry —
+// no separate POST endpoint, no race between the WebSocket handshake
+// and a subsequent focus call.
+const _clients = new Map<object, { focus: string | null }>()
+
+/**
+ * Hivemind: deduplicated set of session IDs focused by at least one
+ * connected client. Drives the global "● N sessions" pill and is
+ * exposed as `GET /global/live-sessions`.
+ */
+export function liveSessions(): string[] {
+  const focused = new Set<string>()
+  for (const c of _clients.values()) {
+    if (c.focus) focused.add(c.focus)
+  }
+  return [...focused]
+}
+
+// Hivemind: fan-out updated live-sessions list to every connected
+// client over their existing presence WebSocket. Cross-directory by
+// construction — `_clients` is module-scoped, no InstanceState lookup.
+// Replaces the previous `Bus.publish(LiveSessionsChanged, ...)` call,
+// which only reached subscribers in the publisher's directory.
+function _broadcast(): void {
+  const sessions = liveSessions()
+  const msg = JSON.stringify({ type: "live-sessions", sessions })
+  for (const key of _clients.keys()) {
+    try {
+      ;(key as { send: (data: string) => void }).send(msg)
+    } catch (err) {
+      // Failed sends mean a half-closed socket; onClose will sweep
+      // the entry shortly. Don't propagate.
+      log.error("presence: broadcast send failed", { err })
+    }
+  }
+}
+
+const FocusMessage = z.object({
+  type: z.literal("focus"),
+  sessionID: z.string().nullable(),
+})
+
+export function PresenceRoutes(upgradeWebSocket: UpgradeWebSocket) {
+  return new Hono().get(
+    "/presence",
+    upgradeWebSocket(() => ({
+      onOpen(_ev, ws) {
+        const key = (ws.raw ?? ws) as object
+        _clients.set(key, { focus: null })
+        _broadcast()
+        log.info("presence connected")
+      },
+      onMessage(ev, ws) {
+        const key = (ws.raw ?? ws) as object
+        const entry = _clients.get(key)
+        if (!entry) return
+        let parsed: { type: "focus"; sessionID: string | null }
+        try {
+          const raw = typeof ev.data === "string" ? ev.data : new TextDecoder().decode(ev.data as ArrayBuffer)
+          parsed = FocusMessage.parse(JSON.parse(raw))
+        } catch (err) {
+          log.error("presence: bad message", { err })
+          return
+        }
+        if (entry.focus === parsed.sessionID) return
+        entry.focus = parsed.sessionID
+        _broadcast()
+      },
+      onClose(_ev, ws) {
+        const key = (ws.raw ?? ws) as object
+        if (_clients.delete(key)) {
+          _broadcast()
+          log.info("presence disconnected")
+        }
+      },
+    })),
+  )
+}
