+import { afterEach, describe, expect, test } from "bun:test"
+import type { Server as BunServer } from "bun"
+import { createBunWebSocket } from "hono/bun"
+import { Instance } from "../../src/project/instance"
+import { Server } from "../../src/server/server"
+import { Log } from "../../src/util/log"
+import { tmpdir } from "../fixture/fixture"
+import { createPresenceClient } from "../../src/cli/cmd/tui/context/presence-client"
+
+Log.init({ print: false })
+
+afterEach(async () => {
+  await Instance.disposeAll()
+})
+
+// Hivemind: presence-client tests. The client is the TUI-side half
+// of the presence channel; these tests pin the contract:
+//   - initial connect re-asserts the most recent focus once the
+//     socket opens (covers OPENCODE_ROUTE seeding the route store
+//     before the WS is up);
+//   - reconnect after a transient drop re-sends `currentFocus`
+//     (the actual reconnect bug: a TUI silently going unfocused
+//     server-side after the daemon restarts);
+//   - incoming `live-sessions` broadcasts are delivered to the
+//     `onLiveSessions` callback.
+//
+// Same harness as `presence.test.ts`: real `Bun.serve`, real
+// `WebSocket` clients (via the production `presence-client`).
+
+const { websocket } = createBunWebSocket()
+
+async function startServer(): Promise<{ url: string; wsURL: string; port: number; stop: () => Promise<void> }> {
+  const app = Server.Default().app
+  let server: BunServer
+  // eslint-disable-next-line prefer-const
+  server = Bun.serve({
+    fetch: (req: Request) => app.fetch(req, server),
+    websocket,
+    port: 0,
+    hostname: "127.0.0.1",
+  })
+  return {
+    url: `http://127.0.0.1:${server.port}`,
+    wsURL: `ws://127.0.0.1:${server.port}`,
+    port: server.port,
+    stop: async () => {
+      await server.stop(true)
+    },
+  }
+}
+
+async function liveSessions(url: string): Promise<string[]> {
+  const res = await fetch(url + "/global/live-sessions")
+  const data = (await res.json()) as { sessions: string[] }
+  return data.sessions.sort()
+}
+
+// Block until liveSessions(url) matches `expected`. Polling with a
+// timeout is the simplest way to bridge the async client → server
+// flow without sprinkling sleeps through every test.
+async function waitForLiveSessions(url: string, expected: string[], timeoutMs = 1000): Promise<void> {
+  const want = JSON.stringify(expected.slice().sort())
+  const deadline = Date.now() + timeoutMs
+  let last: string[] = []
+  while (Date.now() < deadline) {
+    last = await liveSessions(url)
+    if (JSON.stringify(last) === want) return
+    await Bun.sleep(20)
+  }
+  throw new Error(`liveSessions never reached ${want}; last seen ${JSON.stringify(last)}`)
+}
+
+describe("presence-client", () => {
+  test("setFocus before WS opens flushes on connect", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const { url, wsURL, stop } = await startServer()
+        try {
+          const broadcasts: string[][] = []
+          const client = createPresenceClient({
+            url: wsURL + "/presence",
+            onLiveSessions: (sessions) => broadcasts.push(sessions),
+          })
+          // Set focus immediately — before the socket is open. The
+          // client buffers it as currentFocus and re-sends on onopen.
+          client.setFocus("ses_initial")
+
+          await waitForLiveSessions(url, ["ses_initial"])
+          expect(broadcasts.some((b) => b.includes("ses_initial"))).toBe(true)
+
+          client.close()
+        } finally {
+          await stop()
+        }
+      },
+    })
+  })
+
+  test("reconnect re-sends currentFocus", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const first = await startServer()
+        let port = first.port
+        try {
+          const client = createPresenceClient({
+            url: first.wsURL + "/presence",
+            onLiveSessions: () => {},
+            reconnectMs: 50,
+          })
+          client.setFocus("ses_persist")
+          await waitForLiveSessions(first.url, ["ses_persist"])
+
+          // Simulate a daemon restart: stop the server, start a
+          // fresh one on the same port. The client's reconnect
+          // loop should pick up the new server and re-send
+          // currentFocus without any external nudge.
+          await first.stop()
+          let second: BunServer
+          // eslint-disable-next-line prefer-const
+          second = Bun.serve({
+            fetch: (req: Request) => Server.Default().app.fetch(req, second),
+            websocket,
+            port,
+            hostname: "127.0.0.1",
+          })
+          port = second.port
+          try {
+            await waitForLiveSessions(`http://127.0.0.1:${second.port}`, ["ses_persist"], 3000)
+          } finally {
+            await second.stop(true)
+          }
+
+          client.close()
+        } finally {
+          // first already stopped; nothing to do
+        }
+      },
+    })
+  })
+
+  test("incoming live-sessions broadcast invokes onLiveSessions", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const { wsURL, stop } = await startServer()
+        try {
+          let lastBroadcast: string[] | undefined
+          const client = createPresenceClient({
+            url: wsURL + "/presence",
+            onLiveSessions: (sessions) => {
+              lastBroadcast = sessions
+            },
+          })
+          client.setFocus("ses_self")
+
+          // Open a second raw WS and have it focus a different
+          // session. The client should receive a broadcast that
+          // includes both.
+          const peer = new WebSocket(wsURL + "/presence")
+          await new Promise<void>((resolve) => {
+            peer.onopen = () => resolve()
+          })
+          peer.send(JSON.stringify({ type: "focus", sessionID: "ses_peer" }))
+
+          // Spin until the client has seen both sessions. Polling
+          // because onLiveSessions is called multiple times during
+          // the connection dance (initial empty, our focus, peer's
+          // focus); we only care that the eventual state lands.
+          const deadline = Date.now() + 1000
+          while (Date.now() < deadline) {
+            if (lastBroadcast && lastBroadcast.includes("ses_self") && lastBroadcast.includes("ses_peer")) break
+            await Bun.sleep(20)
+          }
+          expect(lastBroadcast?.slice().sort()).toEqual(["ses_peer", "ses_self"])
+
+          peer.close()
+          client.close()
+        } finally {
+          await stop()
+        }
+      },
+    })
+  })
+
+  test("close() prevents reconnect", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const first = await startServer()
+        const port = first.port
+        try {
+          const client = createPresenceClient({
+            url: first.wsURL + "/presence",
+            onLiveSessions: () => {},
+            reconnectMs: 50,
+          })
+          client.setFocus("ses_x")
+          await waitForLiveSessions(first.url, ["ses_x"])
+
+          // Close the client BEFORE bouncing the server. After this,
+          // a new server on the same port must not see the client
+          // come back — the reconnect loop must be inert.
+          client.close()
+          await first.stop()
+
+          let second: BunServer
+          // eslint-disable-next-line prefer-const
+          second = Bun.serve({
+            fetch: (req: Request) => Server.Default().app.fetch(req, second),
+            websocket,
+            port,
+            hostname: "127.0.0.1",
+          })
+          try {
+            // Give the (closed) client plenty of time to mistakenly
+            // reconnect. It must not.
+            await Bun.sleep(300)
+            const sessions = await liveSessions(`http://127.0.0.1:${second.port}`)
+            expect(sessions).toEqual([])
+          } finally {
+            await second.stop(true)
+          }
+        } finally {
+          // first already stopped
+        }
+      },
+    })
+  })
+})
