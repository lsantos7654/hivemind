+import { afterEach, describe, expect, test } from "bun:test"
+import type { Server as BunServer } from "bun"
+import { createBunWebSocket } from "hono/bun"
+import { Instance } from "../../src/project/instance"
+import { Server } from "../../src/server/server"
+import { Log } from "../../src/util/log"
+import { tmpdir } from "../fixture/fixture"
+
+Log.init({ print: false })
+
+afterEach(async () => {
+  await Instance.disposeAll()
+})
+
+// Hivemind: presence WebSocket tests. Native Bun.serve is the
+// substrate (same as production), real `WebSocket` clients open
+// connections, real CLOSE frames trigger cleanup. The protocol's
+// explicit close handshake means same-process tests faithfully
+// exercise the production code path — no need for a cross-process
+// curl variant; killing a `ws` instance fires `onClose` server-side
+// just like a TUI quitting does.
+
+// Hivemind: hono/bun's `upgradeWebSocket` and `websocket` are module-level
+// singletons (see node_modules/hono/dist/adapter/bun/websocket.js), so the
+// `websocket` handler we hand to Bun.serve here matches the
+// `upgradeWebSocket` Server.create() registered against. Calling
+// createBunWebSocket() in two places returns references to the same
+// singletons.
+const { websocket } = createBunWebSocket()
+
+async function startServer(): Promise<{ url: string; wsURL: string; stop: () => Promise<void> }> {
+  const app = Server.Default().app
+  let server: BunServer
+  // eslint-disable-next-line prefer-const
+  server = Bun.serve({
+    fetch: (req: Request) => app.fetch(req, server),
+    websocket,
+    port: 0,
+    hostname: "127.0.0.1",
+  })
+  return {
+    url: `http://127.0.0.1:${server.port}`,
+    wsURL: `ws://127.0.0.1:${server.port}`,
+    stop: async () => {
+      await server.stop(true)
+    },
+  }
+}
+
+async function liveSessions(url: string) {
+  const res = await fetch(url + "/global/live-sessions")
+  expect(res.status).toBe(200)
+  return (await res.json()) as { sessions: string[] }
+}
+
+async function openWS(wsURL: string, directory?: string): Promise<WebSocket> {
+  const url = directory ? wsURL + "/presence?directory=" + encodeURIComponent(directory) : wsURL + "/presence"
+  const ws = new WebSocket(url)
+  await new Promise<void>((resolve, reject) => {
+    ws.onopen = () => resolve()
+    ws.onerror = (e) => reject(e)
+  })
+  return ws
+}
+
+// Hivemind: harness for receiving server→client `live-sessions`
+// broadcasts. Captures every message; `awaitContains(sessionID)`
+// resolves when a broadcast carrying that sessionID arrives, with
+// a small timeout so flaky network conditions don't hang the suite.
+function captureLiveSessions(ws: WebSocket): {
+  messages: string[][]
+  awaitContains: (sessionID: string, timeoutMs?: number) => Promise<string[]>
+  awaitExcludes: (sessionID: string, timeoutMs?: number) => Promise<string[]>
+} {
+  const messages: string[][] = []
+  const listeners: Array<(sessions: string[]) => void> = []
+  ws.addEventListener("message", (ev) => {
+    try {
+      const msg = JSON.parse(typeof ev.data === "string" ? ev.data : "")
+      if (msg && msg.type === "live-sessions" && Array.isArray(msg.sessions)) {
+        messages.push(msg.sessions)
+        for (const l of listeners) l(msg.sessions)
+      }
+    } catch {
+      // ignore
+    }
+  })
+  function waitFor(predicate: (sessions: string[]) => boolean, timeoutMs: number) {
+    return new Promise<string[]>((resolve, reject) => {
+      // Check buffered messages first.
+      for (const m of messages) {
+        if (predicate(m)) return resolve(m)
+      }
+      const timer = setTimeout(() => {
+        const idx = listeners.indexOf(listener)
+        if (idx >= 0) listeners.splice(idx, 1)
+        reject(new Error(`timed out after ${timeoutMs}ms; messages so far: ${JSON.stringify(messages)}`))
+      }, timeoutMs)
+      const listener = (sessions: string[]) => {
+        if (!predicate(sessions)) return
+        clearTimeout(timer)
+        const idx = listeners.indexOf(listener)
+        if (idx >= 0) listeners.splice(idx, 1)
+        resolve(sessions)
+      }
+      listeners.push(listener)
+    })
+  }
+  return {
+    messages,
+    awaitContains: (sessionID, timeoutMs = 500) => waitFor((s) => s.includes(sessionID), timeoutMs),
+    awaitExcludes: (sessionID, timeoutMs = 500) => waitFor((s) => !s.includes(sessionID), timeoutMs),
+  }
+}
+
+describe("presence WebSocket", () => {
+  test("client appears in live set when it sends focus", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const { url, wsURL, stop } = await startServer()
+        try {
+          const ws = await openWS(wsURL)
+          await Bun.sleep(20)
+
+          expect((await liveSessions(url)).sessions).toEqual([])
+
+          ws.send(JSON.stringify({ type: "focus", sessionID: "ses_root_A" }))
+          await Bun.sleep(50)
+
+          expect((await liveSessions(url)).sessions).toEqual(["ses_root_A"])
+
+          ws.close()
+        } finally {
+          await stop()
+        }
+      },
+    })
+  })
+
+  test("focus update mutates the entry rather than creating a new one", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const { url, wsURL, stop } = await startServer()
+        try {
+          const ws = await openWS(wsURL)
+          ws.send(JSON.stringify({ type: "focus", sessionID: "ses_old" }))
+          await Bun.sleep(30)
+          expect((await liveSessions(url)).sessions).toEqual(["ses_old"])
+
+          ws.send(JSON.stringify({ type: "focus", sessionID: "ses_new" }))
+          await Bun.sleep(30)
+          // Same client, focus updated. Old session is gone, new is live.
+          expect((await liveSessions(url)).sessions).toEqual(["ses_new"])
+
+          ws.close()
+        } finally {
+          await stop()
+        }
+      },
+    })
+  })
+
+  test("focus = null blurs the client without disconnecting", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const { url, wsURL, stop } = await startServer()
+        try {
+          const ws = await openWS(wsURL)
+          ws.send(JSON.stringify({ type: "focus", sessionID: "ses_x" }))
+          await Bun.sleep(30)
+          expect((await liveSessions(url)).sessions).toEqual(["ses_x"])
+
+          ws.send(JSON.stringify({ type: "focus", sessionID: null }))
+          await Bun.sleep(30)
+          expect((await liveSessions(url)).sessions).toEqual([])
+
+          // Connection still alive — re-focus to confirm.
+          ws.send(JSON.stringify({ type: "focus", sessionID: "ses_y" }))
+          await Bun.sleep(30)
+          expect((await liveSessions(url)).sessions).toEqual(["ses_y"])
+
+          ws.close()
+        } finally {
+          await stop()
+        }
+      },
+    })
+  })
+
+  test("closing the WebSocket removes the client (the leak-catcher)", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const { url, wsURL, stop } = await startServer()
+        try {
+          const ws = await openWS(wsURL)
+          ws.send(JSON.stringify({ type: "focus", sessionID: "ses_root" }))
+          await Bun.sleep(30)
+          expect((await liveSessions(url)).sessions).toEqual(["ses_root"])
+
+          ws.close()
+          await Bun.sleep(100)
+
+          expect((await liveSessions(url)).sessions).toEqual([])
+        } finally {
+          await stop()
+        }
+      },
+    })
+  })
+
+  test("two clients with distinct focuses, one disconnects, only its focus drops", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const { url, wsURL, stop } = await startServer()
+        try {
+          const a = await openWS(wsURL)
+          const b = await openWS(wsURL)
+          a.send(JSON.stringify({ type: "focus", sessionID: "ses_A" }))
+          b.send(JSON.stringify({ type: "focus", sessionID: "ses_B" }))
+          await Bun.sleep(50)
+
+          expect((await liveSessions(url)).sessions.sort()).toEqual(["ses_A", "ses_B"])
+
+          a.close()
+          await Bun.sleep(100)
+
+          expect((await liveSessions(url)).sessions).toEqual(["ses_B"])
+
+          b.close()
+        } finally {
+          await stop()
+        }
+      },
+    })
+  })
+
+  test("two clients on the same session dedupe", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const { url, wsURL, stop } = await startServer()
+        try {
+          const a = await openWS(wsURL)
+          const b = await openWS(wsURL)
+          a.send(JSON.stringify({ type: "focus", sessionID: "ses_shared" }))
+          b.send(JSON.stringify({ type: "focus", sessionID: "ses_shared" }))
+          await Bun.sleep(50)
+
+          // Set semantics — one entry despite two clients.
+          expect((await liveSessions(url)).sessions).toEqual(["ses_shared"])
+
+          a.close()
+          await Bun.sleep(100)
+          // B is still attached; the session stays live.
+          expect((await liveSessions(url)).sessions).toEqual(["ses_shared"])
+
+          b.close()
+          await Bun.sleep(100)
+          expect((await liveSessions(url)).sessions).toEqual([])
+        } finally {
+          await stop()
+        }
+      },
+    })
+  })
+
+  // Hivemind: the next three tests pin the cross-instance broadcast
+  // contract. The bug they regression-test: before the fix,
+  // `_publishChange()` routed through `Bus.publish` which is
+  // per-directory (`InstanceState`-scoped). A focus update from a
+  // client connected with `?directory=B` never reached a client
+  // connected with `?directory=A`. The TUI footer's `● N sessions`
+  // pill silently desynced across worktrees.
+
+  test("focus mutation broadcasts the new live-sessions list to every client", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const { wsURL, stop } = await startServer()
+        try {
+          const a = await openWS(wsURL)
+          const b = await openWS(wsURL)
+          const capA = captureLiveSessions(a)
+          const capB = captureLiveSessions(b)
+
+          a.send(JSON.stringify({ type: "focus", sessionID: "ses_X" }))
+
+          // A and B should both receive a broadcast that includes ses_X.
+          expect(await capA.awaitContains("ses_X")).toContain("ses_X")
+          expect(await capB.awaitContains("ses_X")).toContain("ses_X")
+
+          a.close()
+          b.close()
+        } finally {
+          await stop()
+        }
+      },
+    })
+  })
+
+  test("disconnect broadcasts updated list to remaining clients", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const { wsURL, stop } = await startServer()
+        try {
+          const a = await openWS(wsURL)
+          const b = await openWS(wsURL)
+          a.send(JSON.stringify({ type: "focus", sessionID: "ses_A" }))
+          b.send(JSON.stringify({ type: "focus", sessionID: "ses_B" }))
+          await Bun.sleep(40)
+
+          const capB = captureLiveSessions(b)
+          a.close()
+
+          // B should see a broadcast that no longer includes ses_A.
+          const sessions = await capB.awaitExcludes("ses_A")
+          expect(sessions).toEqual(["ses_B"])
+
+          b.close()
+        } finally {
+          await stop()
+        }
+      },
+    })
+  })
+
+  test("broadcast crosses directories (regression: per-instance bus dropped these)", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const { wsURL, stop } = await startServer()
+        try {
+          // Distinct ?directory= values mimic the multi-worktree
+          // scenario: TUI A in pr-1/, TUI B in pr-2/. The presence
+          // map is module-scoped, but a per-instance Bus.publish
+          // would not have crossed this boundary.
+          const a = await openWS(wsURL, tmp.path + "/dir-a")
+          const b = await openWS(wsURL, tmp.path + "/dir-b")
+          const capA = captureLiveSessions(a)
+          const capB = captureLiveSessions(b)
+
+          a.send(JSON.stringify({ type: "focus", sessionID: "ses_in_A" }))
+          b.send(JSON.stringify({ type: "focus", sessionID: "ses_in_B" }))
+
+          // Both clients must eventually see a broadcast containing
+          // BOTH sessions — the dedup'd live-sessions list after both
+          // focuses have been registered. Waiting on the later focus
+          // ("ses_in_B") on both captures avoids resolving early on
+          // the intermediate broadcast that only contains "ses_in_A".
+          const fromA = await capA.awaitContains("ses_in_B")
+          const fromB = await capB.awaitContains("ses_in_B")
+          expect(fromA.sort()).toEqual(["ses_in_A", "ses_in_B"])
+          expect(fromB.sort()).toEqual(["ses_in_A", "ses_in_B"])
+
+          a.close()
+          b.close()
+        } finally {
+          await stop()
+        }
+      },
+    })
+  })
+
+  test("malformed message is ignored, connection survives", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
