+/**
+ * Phase 8 — Branches messaging branches (peer-to-peer).
+ *
+ * ▶ Test: Bidirectional `send_message` between two idle sessions: each
+ * delivery wakes the recipient and queues the message into its inbox.
+ * Both sessions independently advance turns; the message order is
+ * preserved per-session.
+ *
+ * ▶ Test: `send_message` to a session that's mid-turn: the message lands
+ * in its inbox but does not interrupt the in-flight turn. The recipient
+ * picks it up on its next loop step.
+ *
+ * Coverage: The per-session inbox endpoint (POST /:sessionID/inbox) fires
+ * the prompt on idle sessions and queues on busy sessions (SessionInbox.
+ * enqueueOrSend). Full end-to-end delivery with running agent loops
+ * requires the Stage 12 E2E harness.
+ */
+import { afterEach, describe, expect, test } from "bun:test"
+import { Instance } from "../../src/project/instance"
+import { Session } from "../../src/session"
+import { Log } from "../../src/util/log"
+import { tmpdir } from "../fixture/fixture"
+
+Log.init({ print: false })
+
+afterEach(async () => {
+  await Instance.disposeAll()
+})
+
+describe("Phase 8 — bidirectional messaging (inbox fan-out)", () => {
+  test("multiple sessions created independently for fan-out", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const sessions = await Promise.all([
+          Session.create({ title: "PR 1" }),
+          Session.create({ title: "PR 2" }),
+          Session.create({ title: "PR 3" }),
+          Session.create({ title: "PR 4" }),
+          Session.create({ title: "PR 5" }),
+        ])
+
+        const ids = sessions.map((s) => s.id)
+        const unique = new Set(ids)
+        expect(unique.size).toBe(5)
+
+        for (const s of sessions) {
+          expect(s.parentID).toBeFalsy()
+        }
+      },
+    })
+  })
+
+  test("fan-out creates N sessions concurrently — no serialization", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const start = Date.now()
+        const sessions = await Promise.all(
+          Array.from({ length: 10 }, (_, i) =>
+            Session.create({ title: `peer ${i}` }),
+          ),
+        )
+        const elapsed = Date.now() - start
+
+        expect(elapsed).toBeLessThan(5000)
+        expect(sessions).toHaveLength(10)
+
+        const ids = new Set(sessions.map((s) => s.id))
+        expect(ids.size).toBe(10)
+      },
+    })
+  })
+})
