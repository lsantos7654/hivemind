diff --git a/packages/opencode/src/server/routes/presence.ts b/packages/opencode/src/server/routes/presence.ts
index c35f91e..335d1b8 100644
--- a/packages/opencode/src/server/routes/presence.ts
+++ b/packages/opencode/src/server/routes/presence.ts
@@ -80,6 +80,22 @@ function _broadcast(): void {
   }
 }
 
+// Hivemind: push a reload-agents notification to every connected
+// client. Mirrors _broadcast() exactly — module-scoped, cross-worktree
+// by construction. Each TUI re-fetches its agent/skill/command lists
+// on receipt so the Task tool's subagent-type registry picks up
+// newly-enabled agents without restarting the engine.
+export function broadcastReload(): void {
+  const msg = JSON.stringify({ type: "reload-agents" })
+  for (const key of _clients.keys()) {
+    try {
+      ;(key as { send: (data: string) => void }).send(msg)
+    } catch (err) {
+      log.error("presence: reload broadcast send failed", { err })
+    }
+  }
+}
+
