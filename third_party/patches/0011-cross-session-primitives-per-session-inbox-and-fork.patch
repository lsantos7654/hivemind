diff --git a/packages/opencode/src/session/inbox.ts b/packages/opencode/src/session/inbox.ts
new file mode 100644
index 0000000..3f662a3
--- /dev/null
+++ b/packages/opencode/src/session/inbox.ts
@@ -0,0 +1,92 @@
+// Hivemind: per-session message inbox with deferred delivery.
+//
+// `POST /session/:id/inbox` accepts a SessionPrompt.PromptInput and delivers
+// it now if the session is idle, or queues it (FIFO) if the session is busy.
+// The queued tail is drained from `SessionRunState.onIdle` via
+// `SessionInbox.drainNext` so a message landing mid-turn is delivered as
+// soon as the current turn finishes.
+//
+// In-memory only (Map keyed by SessionID). On engine restart, queued
+// messages are lost — acceptable for this UX.
+import z from "zod"
+import { Bus } from "@/bus"
+import { BusEvent } from "@/bus/bus-event"
+import { Log } from "../util/log"
+import { Session } from "."
+import { SessionID } from "./schema"
+import { SessionPrompt } from "./prompt"
+import { SessionRunState } from "./run-state"
+
+export namespace SessionInbox {
+  const log = Log.create({ service: "session.inbox" })
+  const queues = new Map<SessionID, SessionPrompt.PromptInput[]>()
+
+  export const Queued = BusEvent.define(
+    "session.message.queued",
+    z.object({
+      sessionID: SessionID.zod,
+      depth: z.number(),
+    }),
+  )
+
+  function enqueue(input: SessionPrompt.PromptInput): number {
+    const sessionID = input.sessionID
+    const q = queues.get(sessionID) ?? []
+    q.push(input)
+    queues.set(sessionID, q)
+    Bus.publish(Queued, { sessionID, depth: q.length }).catch((err) =>
+      log.error("inbox publish failed", { sessionID, error: err }),
+    )
+    return q.length
+  }
+
+  function fireAndForget(input: SessionPrompt.PromptInput) {
+    const sessionID = input.sessionID
+    SessionPrompt.prompt(input).catch((err) => {
+      if (err instanceof Session.BusyError) {
+        // Lost a race against another runner — re-queue and let onIdle drain.
+        enqueue(input)
+        return
+      }
+      log.error("inbox prompt failed", { sessionID, error: err })
+    })
+  }
+
+  /**
+   * Hivemind: queue if busy, send if idle. Returns once the decision is
+   * made (does not wait for the prompt's full turn to complete).
+   */
+  export async function enqueueOrSend(
+    input: SessionPrompt.PromptInput,
+  ): Promise<{ queued: boolean; depth: number }> {
+    let busy = false
+    try {
+      await SessionRunState.assertNotBusy(input.sessionID)
+    } catch (err) {
+      if (err instanceof Session.BusyError) busy = true
+      else throw err
+    }
+    if (busy) {
+      const depth = enqueue(input)
+      return { queued: true, depth }
+    }
+    fireAndForget(input)
+    return { queued: false, depth: queues.get(input.sessionID)?.length ?? 0 }
+  }
+
+  /**
+   * Hivemind: pop the next queued message for `sessionID` and dispatch it
+   * via SessionPrompt.prompt. Called from SessionRunState.onIdle.
+   */
+  export function drainNext(sessionID: SessionID): void {
+    const q = queues.get(sessionID)
+    if (!q || q.length === 0) return
+    const next = q.shift()!
+    if (q.length === 0) queues.delete(sessionID)
+    fireAndForget(next)
+  }
+
+  export function depth(sessionID: SessionID): number {
+    return queues.get(sessionID)?.length ?? 0
+  }
+}
