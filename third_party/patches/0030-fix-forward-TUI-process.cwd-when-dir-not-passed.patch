From 7c176c4def9cfc90aa1521f305e5dad5091333cf Mon Sep 17 00:00:00 2001
From: Lucas Santos <lsantos7654@gmail.com>
Date: Mon, 11 May 2026 17:53:17 -0400
Subject: [PATCH 30/36] fix: forward TUI process.cwd() when --dir not passed
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

When --dir was absent, the attach handler returned undefined for
the directory. This propagated through SDK (no x-opencode-directory
header) to the server router, which fell back to the server's own
process.cwd() — frozen to wherever hivemind server start was run.
Return process.cwd() instead so the SDK sets the header and the
server receives the TUI's actual working directory.
---
 packages/opencode/src/cli/cmd/tui/attach.ts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/packages/opencode/src/cli/cmd/tui/attach.ts b/packages/opencode/src/cli/cmd/tui/attach.ts
index e892f99..289758c 100644
--- a/packages/opencode/src/cli/cmd/tui/attach.ts
+++ b/packages/opencode/src/cli/cmd/tui/attach.ts
@@ -51,7 +51,7 @@ export const AttachCommand = cmd({
       }
 
       const directory = (() => {
-        if (!args.dir) return undefined
+        if (!args.dir) return process.cwd()
         try {
           process.chdir(args.dir)
           return process.cwd()
-- 
