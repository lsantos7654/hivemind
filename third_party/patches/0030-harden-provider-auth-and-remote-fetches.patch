diff --git a/packages/opencode/test/provider/hivemind-lockdown.test.ts b/packages/opencode/test/provider/hivemind-lockdown.test.ts
new file mode 100644
index 0000000..01eca21
--- /dev/null
+++ b/packages/opencode/test/provider/hivemind-lockdown.test.ts
@@ -0,0 +1,50 @@
+import { expect, test } from "bun:test"
+
+import { Auth } from "../../src/auth"
+import { Env } from "../../src/env"
+import { Instance } from "../../src/project/instance"
+import { Provider } from "../../src/provider/provider"
+import { ProviderID } from "../../src/provider/schema"
+import { tmpdir } from "../fixture/fixture"
+
+test("defaultModel requires an explicit configured model", async () => {
+  await using tmp = await tmpdir({ config: { $schema: "https://opencode.ai/config.json" } })
+  await Instance.provide({
+    directory: tmp.path,
+    fn: async () => {
+      expect(Provider.defaultModel()).rejects.toThrow("No model configured")
+    },
+  })
+})
+
+test("env credentials alone do not activate a provider", async () => {
+  await using tmp = await tmpdir({ config: { $schema: "https://opencode.ai/config.json" } })
+  await Instance.provide({
+    directory: tmp.path,
+    init: async () => {
+      Env.set("ANTHROPIC_API_KEY", "test-api-key")
+    },
+    fn: async () => {
+      const providers = await Provider.list()
+      expect(providers[ProviderID.anthropic]).toBeUndefined()
+    },
+  })
+})
+
+test("auth-backed providers remain available", async () => {
+  await using tmp = await tmpdir({ config: { $schema: "https://opencode.ai/config.json" } })
+  await Instance.provide({
+    directory: tmp.path,
+    fn: async () => {
+      await Auth.set(
+        "anthropic",
+        new Auth.Api({
+          type: "api",
+          key: "test-api-key",
+        }),
+      )
+      const providers = await Provider.list()
+      expect(providers[ProviderID.anthropic]).toBeDefined()
+    },
+  })
+})
