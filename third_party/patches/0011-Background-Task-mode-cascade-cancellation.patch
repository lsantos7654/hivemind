diff --git a/packages/opencode/src/session/background.ts b/packages/opencode/src/session/background.ts
new file mode 100644
index 0000000..5f24b5a
--- /dev/null
+++ b/packages/opencode/src/session/background.ts
@@ -0,0 +1,177 @@
+// Hivemind: in-memory registry of background-mode Task children, keyed by
+// parent session. Pairs with the `background: true` parameter on the Task
+// tool (tool/task.ts). When a background child is spawned the entry is
+// added with status="running"; when its prompt completes the entry flips
+// to status="complete" and the result text is buffered. The parent's next
+// turn picks up a <system-reminder> listing pending task_ids and consumes
+// each result via the read_task_result tool.
+//
+// The registry is also the cascade-cancellation source: SessionPrompt.cancel
+// walks the parent's running children and calls SessionRunState.cancel on
+// each so aborting the parent kills its background workers.
+//
+// In-memory only. On engine restart the buffer is gone — acceptable because
+// background runners die with the process anyway, so the lost buffer is
+// consistent with the lost runners.
+import z from "zod"
+import { Bus } from "@/bus"
+import { BusEvent } from "@/bus/bus-event"
+import { Log } from "../util/log"
+import { SessionID } from "./schema"
+
+export namespace SessionBackground {
+  const log = Log.create({ service: "session.background" })
+
+  // Per-parent concurrency cap. Background tasks already in `complete`
+  // status do not count against the cap — only `running` children do.
+  export const CONCURRENCY_CAP = 8
+
+  export type Status = "running" | "complete"
+
+  export interface Pending {
+    parentID: SessionID
+    taskID: SessionID
+    status: Status
+    result?: string
+    startedAt: number
+    completedAt?: number
+  }
+
+  // Map<parentID, Map<taskID, Pending>>
+  const _registry = new Map<SessionID, Map<SessionID, Pending>>()
+
+  export const Changed = BusEvent.define(
+    "session.background.changed",
+    z.object({
+      tasks: z.array(
+        z.object({
+          parentID: SessionID.zod,
+          taskID: SessionID.zod,
+          status: z.enum(["running", "complete"]),
+        }),
+      ),
+    }),
+  )
+
+  export class CapExceededError extends Error {
+    constructor(
+      public parentID: SessionID,
+      public cap: number,
+    ) {
+      super(`max ${cap} concurrent background tasks per parent (parentID=${parentID})`)
+      this.name = "BackgroundCapExceededError"
+    }
+  }
+
+  function _publishChange(): void {
+    Bus.publish(Changed, { tasks: activeTasks() }).catch((err) =>
+      log.error("failed to publish BackgroundTasksChanged", { err }),
+    )
+  }
+
+  function _bucket(parentID: SessionID): Map<SessionID, Pending> {
+    let bucket = _registry.get(parentID)
+    if (!bucket) {
+      bucket = new Map()
+      _registry.set(parentID, bucket)
+    }
+    return bucket
+  }
+
+  function _runningCount(parentID: SessionID): number {
+    const bucket = _registry.get(parentID)
+    if (!bucket) return 0
+    let n = 0
+    for (const p of bucket.values()) if (p.status === "running") n++
+    return n
+  }
+
+  /**
+   * Register a freshly spawned background task. Throws CapExceededError
+   * if the parent already has CONCURRENCY_CAP running tasks. Fires
+   * BackgroundTasksChanged on success.
+   */
+  export function register(parentID: SessionID, taskID: SessionID): void {
+    if (_runningCount(parentID) >= CONCURRENCY_CAP) {
+      throw new CapExceededError(parentID, CONCURRENCY_CAP)
+    }
+    const bucket = _bucket(parentID)
+    bucket.set(taskID, {
+      parentID,
+      taskID,
+      status: "running",
+      startedAt: Date.now(),
+    })
+    log.info("register", { parentID, taskID })
+    _publishChange()
+  }
+
+  /**
+   * Mark a running task complete. Stores `result` for later consumption
+   * via `consume`. No-op if the task is unknown (e.g. cancelled before
+   * the runner reached completion). Fires BackgroundTasksChanged.
+   */
+  export function complete(parentID: SessionID, taskID: SessionID, result: string): void {
+    const bucket = _registry.get(parentID)
+    const entry = bucket?.get(taskID)
+    if (!entry) {
+      log.info("complete (unknown task, ignored)", { parentID, taskID })
+      return
+    }
+    entry.status = "complete"
+    entry.result = result
+    entry.completedAt = Date.now()
+    log.info("complete", { parentID, taskID, resultLength: result.length })
+    _publishChange()
+  }
+
+  /**
+   * Pop a completed result and remove it from the registry. Returns
+   * undefined if the task is unknown or still running.
+   */
+  export function consume(parentID: SessionID, taskID: SessionID): Pending | undefined {
+    const bucket = _registry.get(parentID)
+    const entry = bucket?.get(taskID)
+    if (!entry) return undefined
+    if (entry.status !== "complete") return entry  // still running, leave registry intact
+    bucket!.delete(taskID)
+    if (bucket!.size === 0) _registry.delete(parentID)
+    log.info("consume", { parentID, taskID })
+    _publishChange()
+    return entry
+  }
+
+  /** Read entries for a parent without mutating the registry. */
+  export function pendingFor(parentID: SessionID): Pending[] {
+    const bucket = _registry.get(parentID)
+    if (!bucket) return []
+    return [...bucket.values()]
+  }
+
+  /** Running children of a parent — for cascade cancellation. */
+  export function runningFor(parentID: SessionID): SessionID[] {
+    const bucket = _registry.get(parentID)
+    if (!bucket) return []
+    return [...bucket.values()].filter((p) => p.status === "running").map((p) => p.taskID)
+  }
+
+  /** All entries across all parents — for /global/background-tasks. */
+  export function activeTasks(): Array<{ parentID: SessionID; taskID: SessionID; status: Status }> {
+    const out: Array<{ parentID: SessionID; taskID: SessionID; status: Status }> = []
+    for (const bucket of _registry.values()) {
+      for (const p of bucket.values()) {
+        out.push({ parentID: p.parentID, taskID: p.taskID, status: p.status })
+      }
+    }
+    return out
+  }
+
+  /** Count of currently-running tasks across all parents — for footer. */
+  export function activeRunningCount(): number {
+    let n = 0
+    for (const bucket of _registry.values()) {
+      for (const p of bucket.values()) if (p.status === "running") n++
+    }
+    return n
+  }
+}
