+// Hivemind: pills powered by the per-client presence map. Server emits
+// `session.live.changed` whenever any TUI registers/unregisters or
+// flips its focus, with a payload of { sessions, subagents }. Roots =
+// sessions.length - subagents.length; subagents pill = subagents.length.
+// Initial seed via GET /global/live-sessions on mount; updates flow via
+// the bus event. No polling.
+function rootCount(sessions: readonly string[], subagents: readonly string[]): number {
+  return Math.max(0, sessions.length - subagents.length)
 }

