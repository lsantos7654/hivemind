             if (ctrl.signal.aborted) break
@@ -87,12 +108,48 @@ export const { use: useSDK, provider: SDKProvider } = createSimpleContext({
       })().catch(() => {})
     }

+    // Hivemind: posts the currently-focused session to the server's
+    // presence map. Called from a route effect so a navigation
+    // triggers exactly one POST. `null` blurs (e.g. when the route is
+    // `home` or a plugin pane). Errors are swallowed — focus is
+    // best-effort metadata, not load-bearing.
+    function postFocus(sessionID: string | null) {
+      const f = props.fetch ?? fetch
+      f(props.url + "/event/focus", {
+        method: "POST",
+        signal: abort.signal,
+        headers: { "Content-Type": "application/json", ...presenceHeaders },
+        body: JSON.stringify({ sessionID }),
+      }).catch(() => {})
+    }
+
+    // Buffer the first focus value if the route effect fires before
+    // the SSE handshake registers this client. Set when `presenceReady`
+    // is false; flushed by startSSE() once the connection is alive.
+    let presenceReady = false
+    let pendingFocus: string | null | undefined = undefined
+
+    const route = useRoute()
+
     onMount(async () => {
       if (props.events) {
         const unsub = await props.events.subscribe(props.directory, handleEvent)
         onCleanup(unsub)
       } else {
         startSSE()
+        // Mirror the active route into the server's presence map.
+        // SolidJS reruns this effect whenever `route.data` changes, so
+        // each navigation triggers exactly one POST without us
+        // diffing session IDs manually.
+        createEffect(() => {
+          const data = route.data
+          const sessionID = data.type === "session" ? data.sessionID : null
+          if (presenceReady) {
+            postFocus(sessionID)
+          } else {
+            pendingFocus = sessionID
+          }
+        })
       }
     })

@@ -110,6 +167,7 @@ export const { use: useSDK, provider: SDKProvider } = createSimpleContext({
       event: emitter,
       fetch: props.fetch ?? fetch,
       url: props.url,
+      clientID,
     }
   },
 })
