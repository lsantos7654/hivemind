 export type EventSource = {
   subscribe: (directory: string | undefined, handler: (event: Event) => void) => Promise<() => void>
@@ -19,13 +20,25 @@ export const { use: useSDK, provider: SDKProvider } = createSimpleContext({
     const abort = new AbortController()
     let sse: AbortController | undefined

+    // Hivemind: generated once per TUI process. Sent as `X-Client-ID`
+    // on the `/event` SSE handshake so the server can register this
+    // client in the per-client presence map, and on every subsequent
+    // `POST /event/focus` so the server knows whose focus to update.
+    // The SSE connection is the presence beacon — when it dies,
+    // `stream.onAbort` fires server-side and the entry is removed.
+    const clientID = (typeof crypto !== "undefined" && typeof crypto.randomUUID === "function")
+      ? crypto.randomUUID()
+      : `tui-${Date.now()}-${Math.random().toString(36).slice(2)}`
+
+    const presenceHeaders: Record<string, string> = { "X-Client-ID": clientID }
+
     function createSDK() {
       return createOpencodeClient({
         baseUrl: props.url,
         signal: abort.signal,
         directory: props.directory,
         fetch: props.fetch,
-        headers: props.headers,
+        headers: { ...(props.headers as Record<string, string> | undefined), ...presenceHeaders },
       })
     }

@@ -75,6 +88,14 @@ export const { use: useSDK, provider: SDKProvider } = createSimpleContext({
         while (true) {
           if (abort.signal.aborted || ctrl.signal.aborted) break
           const events = await sdk.event.subscribe({}, { signal: ctrl.signal })
+          // SSE handshake complete — server has registered the client.
+          // Flush any focus the route effect captured before the
+          // beacon was alive.
+          if (pendingFocus !== undefined) {
