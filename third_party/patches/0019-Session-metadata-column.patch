-      return Service.of({ trigger, list, init })
+      // Hivemind: scoped post-write notifier. Walks loaded hooks once,
+      // matches the absolute write path against any registered glob
+      // patterns from `onFileWrite`, and dispatches matched handlers.
+      // Hooks without `onFileWrite` are skipped; hooks whose patterns
+      // don't match are skipped. Errors in handlers are logged and
+      // swallowed so a misbehaving plugin can't break a tool call.
+      const notifyFileWrite = Effect.fn("Plugin.notifyFileWrite")(function* (input: {
+        path: string
+        sessionID: string
+        bytes: number
+        tool: "write" | "edit"
+      }) {
+        const s = yield* InstanceState.get(state)
+        for (const hook of s.hooks) {
+          const reg = (hook as any).onFileWrite as
+            | { patterns: string[]; handler: (i: typeof input) => Promise<void> }
+            | undefined
+          if (!reg || !reg.handler || !Array.isArray(reg.patterns) || reg.patterns.length === 0) continue
+          const matched = reg.patterns.some((p) => new Bun.Glob(p).match(input.path))
+          if (!matched) continue
+          yield* Effect.tryPromise({
+            try: () => reg.handler(input),
+            catch: (err) => {
+              log.error("onFileWrite handler failed", { path: input.path, error: errorMessage(err) })
+            },
+          }).pipe(Effect.ignore)
+        }
+      })
+
+      return Service.of({ trigger, list, init, notifyFileWrite })
     }),
   )
 
@@ -287,4 +324,17 @@ export namespace Plugin {
   export async function init() {
     return runPromise((svc) => svc.init())
