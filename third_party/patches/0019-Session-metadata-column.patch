+import { describe, expect, test } from "bun:test"
+import path from "path"
+import { Session } from "../../src/session"
+import { SessionBackground } from "../../src/session/background"
+import { Log } from "../../src/util/log"
+import { Instance } from "../../src/project/instance"
+
+const projectRoot = path.join(__dirname, "../..")
+Log.init({ print: false })
+
+// Hivemind: tests for the session.ephemeral column. Sessions flagged
+// ephemeral are deleted when the runner reaches idle on a terminal turn
+// (completed | failed | cancelled). Background tasks defer deletion to
+// `SessionBackground.consume` so the parent has a chance to read the
+// buffered result first.
+
+describe("Session ephemeral column", () => {
+  test("round-trips true / false / undefined", async () => {
+    await Instance.provide({
+      directory: projectRoot,
+      fn: async () => {
+        const a = await Session.create({ ephemeral: true })
+        const b = await Session.create({ ephemeral: false })
+        const c = await Session.create({})
+
+        expect((await Session.get(a.id)).ephemeral).toBe(true)
+        expect((await Session.get(b.id)).ephemeral).toBe(false)
+        expect((await Session.get(c.id)).ephemeral).toBeFalsy()
+      },
+    })
+  })
+
+  test("fork carries ephemeral when set on the fork call", async () => {
+    await Instance.provide({
+      directory: projectRoot,
+      fn: async () => {
+        const source = await Session.create({})
+        const forked = await Session.fork({ sessionID: source.id, ephemeral: true })
+        expect((await Session.get(forked.id)).ephemeral).toBe(true)
+        // Source untouched.
+        expect((await Session.get(source.id)).ephemeral).toBeFalsy()
+      },
+    })
+  })
+
+  test("consume() deletes the session if ephemeral", async () => {
+    await Instance.provide({
+      directory: projectRoot,
+      fn: async () => {
+        const parent = await Session.create({})
+        const ephemeralChild = await Session.create({ parentID: parent.id, ephemeral: true })
+
+        SessionBackground.register(parent.id, ephemeralChild.id)
+        SessionBackground.complete(parent.id, ephemeralChild.id, "result text")
+
+        // Consume returns the buffered entry…
+        const entry = SessionBackground.consume(parent.id, ephemeralChild.id)
+        expect(entry?.result).toBe("result text")
+
+        // …and triggers fire-and-forget cleanup. The cleanup is async,
+        // so wait briefly for Session.remove to land.
+        await new Promise((r) => setTimeout(r, 50))
+        await expect(Session.get(ephemeralChild.id)).rejects.toThrow()
+      },
+    })
+  })
+
+  test("consume() leaves non-ephemeral sessions in place", async () => {
+    await Instance.provide({
+      directory: projectRoot,
+      fn: async () => {
+        const parent = await Session.create({})
+        const persistentChild = await Session.create({ parentID: parent.id })
+
+        SessionBackground.register(parent.id, persistentChild.id)
+        SessionBackground.complete(parent.id, persistentChild.id, "result")
+        SessionBackground.consume(parent.id, persistentChild.id)
+
+        await new Promise((r) => setTimeout(r, 50))
+        // Still there.
+        const fetched = await Session.get(persistentChild.id)
+        expect(fetched.id).toBe(persistentChild.id)
+      },
+    })
+  })
+
+  test("isRegistered() returns true for active background tasks only", async () => {
+    await Instance.provide({
+      directory: projectRoot,
+      fn: async () => {
+        const parent = await Session.create({})
+        const child = await Session.create({ parentID: parent.id })
+
+        expect(SessionBackground.isRegistered(child.id)).toBe(false)
+
+        SessionBackground.register(parent.id, child.id)
+        expect(SessionBackground.isRegistered(child.id)).toBe(true)
+
+        SessionBackground.complete(parent.id, child.id, "")
+        // Still registered until consume pops it.
+        expect(SessionBackground.isRegistered(child.id)).toBe(true)
+
+        SessionBackground.consume(parent.id, child.id)
+        expect(SessionBackground.isRegistered(child.id)).toBe(false)
+      },
+    })
+  })
+})
