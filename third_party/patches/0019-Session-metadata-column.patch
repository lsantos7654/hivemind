+
+  // Hivemind: fire onFileWrite hooks (pattern-matched at registration).
+  // Tools call this after a successful write/edit; if no plugin
+  // registered a matching pattern this is effectively a no-op (a single
+  // map iteration with no matches).
+  export async function notifyFileWrite(input: {
+    path: string
+    sessionID: string
+    bytes: number
+    tool: "write" | "edit"
+  }): Promise<void> {
+    return runPromise((svc) => svc.notifyFileWrite(input))
+  }
 }
