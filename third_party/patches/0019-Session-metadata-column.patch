 export namespace SessionRunState {
+  const log = Log.create({ service: "session.run-state" })
+
+  /**
+   * Hivemind: foreground ephemeral cleanup. Runs when a session's runner
+   * reaches idle (terminal turn — completed, failed, or cancelled). If the
+   * session is `ephemeral` AND not registered as a background task, remove
+   * it. Background tasks defer cleanup to `SessionBackground.consume` so
+   * the parent has a chance to read the buffered result first.
+   *
