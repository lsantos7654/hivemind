diff --git a/packages/opencode/src/plugin/hivemind-memory.ts b/packages/opencode/src/plugin/hivemind-memory.ts
new file mode 100644
index 0000000..0cfa89d
--- /dev/null
+++ b/packages/opencode/src/plugin/hivemind-memory.ts
@@ -0,0 +1,143 @@
+/**
+ * Hivemind: memory-compaction auto-spawn plugin.
+ *
+ * Listens for writes to `~/.config/opencode/hivemind/memory/<agent>/short_memory.md`
+ * via the engine's `onFileWrite` hook (registered by pattern). When a write
+ * crosses the byte threshold configured in hivemind.json, spawns the
+ * `hivemind-memory-daemon` system_templated agent as a depth-1 sibling of
+ * the writer under main. The daemon runs one compaction pass and exits.
+ *
+ * Design properties:
+ *   - No chain walking: the writer's `parent_id` is read once. In the
+ *     hivemind depth=1 model the writer is either main itself
+ *     (`parent_id == null`) or a direct child of main, so the daemon's
+ *     `parent_id` is `writer.parent_id ?? writer.id`.
+ *   - Recursion guard: if the writer's own agent IS the daemon, skip.
+ *   - Structured attribution: the spawned daemon's `metadata` carries
+ *     `triggered_by_session`, `target_agent`, `triggered_at_bytes`.
+ *   - Threshold from hivemind.json:memory.compaction_threshold_bytes.
+ *     Cached per process; invalidated by mtime check.
+ */
+
+import type { Hooks, PluginInput } from "@opencode-ai/plugin"
+import path from "node:path"
+import { Log } from "../util/log"
+
+const log = Log.create({ service: "plugin.hivemind-memory" })
+
+const DAEMON_AGENT = "hivemind-memory-daemon"
+const MEMORY_PATH_PATTERN = "**/hivemind/memory/**/short_memory.md"
+const HIVEMIND_JSON_CANDIDATES = [
+  // Workspace path the user runs hivemind from. Resolved relative to the
+  // launcher cwd; the engine sees process.cwd() when invoked.
+  "hivemind.json",
+  // Cache mirror used by long-running daemons.
+  path.join(process.env.HOME ?? "~", ".cache/hivemind/hivemind.json"),
+]
+const DEFAULT_THRESHOLD_BYTES = 8192
+
+interface ThresholdConfig {
+  threshold_bytes: number
+}
+
+let _configCache: { config: ThresholdConfig; mtimeMs: number; path: string } | null = null
+
+async function readMemoryConfig(): Promise<ThresholdConfig> {
+  for (const candidate of HIVEMIND_JSON_CANDIDATES) {
+    try {
+      const file = Bun.file(candidate)
+      const stat = await file.stat()
+      if (_configCache && _configCache.path === candidate && _configCache.mtimeMs === stat.mtimeMs) {
+        return _configCache.config
+      }
+      const json = (await file.json()) as { memory?: { compaction_threshold_bytes?: number } }
+      const threshold_bytes = json.memory?.compaction_threshold_bytes ?? DEFAULT_THRESHOLD_BYTES
+      const config = { threshold_bytes }
+      _configCache = { config, mtimeMs: stat.mtimeMs, path: candidate }
+      return config
+    } catch {
+      // try next candidate
+    }
+  }
+  return { threshold_bytes: DEFAULT_THRESHOLD_BYTES }
+}
+
+const SHORT_MEMORY_RE = /\/hivemind\/memory\/([^/]+)\/short_memory\.md$/
+
+export const HivemindMemoryPlugin = async (input: PluginInput): Promise<Hooks> => {
+  const { client } = input
+
+  return {
+    onFileWrite: {
+      patterns: [MEMORY_PATH_PATTERN],
+      handler: async ({ sessionID, path: writePath, bytes, tool }) => {
+        const config = await readMemoryConfig()
+        if (bytes < config.threshold_bytes) return
+
+        // Single typed lookup. No chain walking.
+        let writer
+        try {
+          const result = await client.session.get({ path: { id: sessionID as `ses_${string}` } })
+          writer = result.data
+        } catch (err) {
+          log.warn("memory-hook: failed to fetch writer session", { sessionID, err })
+          return
+        }
+        if (!writer) return
+
+        // Recursion guard: don't spawn another daemon when the daemon
+        // itself writes back to a memory file.
+        const writerAgent = (writer as { agent?: string }).agent
+        if (writerAgent === DAEMON_AGENT) return
+
+        // Depth-1 invariant: writer is either main or a direct child of main.
+        // Reading parent_id once is sufficient — never null for a subagent,
+        // null only when the writer IS main (rare for memory writes but
+        // valid for the orchestrator's _orchestrator/short_memory.md).
+        const writerParent = (writer as { parentID?: string; parent_id?: string }).parentID
+          ?? (writer as { parent_id?: string }).parent_id
+        const mainID = writerParent ?? sessionID
+
+        const match = SHORT_MEMORY_RE.exec(writePath)
+        if (!match) return
+        const targetAgent = match[1]
+
+        try {
+          // Hivemind: `agent`, `metadata`, and `ephemeral` are hivemind
+          // engine extensions not in the V1 OpenAPI spec the SDK was
+          // generated from. Cast through `unknown` so the call site
+          // documents the intent without abusing `// @ts-expect-error`
+          // (which would suppress unrelated future errors silently).
+          await client.session.create({
+            body: {
+              parentID: mainID,
+              agent: DAEMON_AGENT,
+              title: `compact memory: ${targetAgent}`,
+              metadata: {
+                triggered_by_session: sessionID,
+                target_agent: targetAgent,
+                triggered_at_bytes: bytes,
+              },
+              // Hivemind: the daemon is one-off. Auto-delete its session
+              // when it reaches terminal state so the subagent tree only
+              // shows long-lived agents instead of accumulating one
+              // `compact memory: <agent>` corpse per write that crossed
+              // the threshold. Belt-and-braces with the daemon's
+              // frontmatter `ephemeral: true` — explicit here so the
+              // behavior is visible at the call site.
+              ephemeral: true,
+            } as unknown as { parentID?: string; title?: string },
+          })
+          log.info("memory-hook: spawned daemon", {
+            target_agent: targetAgent,
+            triggered_by: sessionID,
+            parent: mainID,
+            bytes,
+          })
+        } catch (err) {
+          log.error("memory-hook: failed to spawn daemon", { err })
+        }
+      },
+    },
+  }
+}
