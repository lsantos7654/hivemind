+import { describe, expect, test } from "bun:test"
+import path from "path"
+import { Session } from "../../src/session"
+import { Log } from "../../src/util/log"
+import { Instance } from "../../src/project/instance"
+
+const projectRoot = path.join(__dirname, "../..")
+Log.init({ print: false })
+
+// Hivemind: tests for the session.metadata column added by patch.
+// Used by the memory-compaction daemon to record structured
+// attribution (triggered_by_session, target_agent, triggered_at_bytes)
+// without parsing the title.
+
+describe("Session metadata column", () => {
+  test("round-trips arbitrary JSON-serializable metadata", async () => {
+    await Instance.provide({
+      directory: projectRoot,
+      fn: async () => {
+        const meta = {
+          triggered_by_session: "ses_writer_xyz",
+          target_agent: "bazel",
+          triggered_at_bytes: 9000,
+        }
+        const session = await Session.create({ metadata: meta })
+        const fetched = await Session.get(session.id)
+        expect(fetched.metadata).toEqual(meta)
+      },
+    })
+  })
+
+  test("defaults to undefined when not provided", async () => {
+    await Instance.provide({
+      directory: projectRoot,
+      fn: async () => {
+        const session = await Session.create({})
+        const fetched = await Session.get(session.id)
+        expect(fetched.metadata).toBeUndefined()
+      },
+    })
+  })
+
+  test("supports nested values", async () => {
+    await Instance.provide({
+      directory: projectRoot,
+      fn: async () => {
+        const meta = {
+          nested: { count: 42, ids: ["a", "b"] },
+          flag: true,
+        }
+        const session = await Session.create({ metadata: meta })
+        const fetched = await Session.get(session.id)
+        expect(fetched.metadata).toEqual(meta)
+      },
+    })
+  })
+})
diff --git a/packages/opencode/test/tool/task-ephemeral.test.ts b/packages/opencode/test/tool/task-ephemeral.test.ts
new file mode 100644
index 0000000..4195a7f
--- /dev/null
+++ b/packages/opencode/test/tool/task-ephemeral.test.ts
@@ -0,0 +1,350 @@
+import { afterEach, describe, expect } from "bun:test"
+import { Effect, Layer } from "effect"
+import { Agent } from "../../src/agent/agent"
+import { Config } from "../../src/config/config"
+import * as CrossSpawnSpawner from "../../src/effect/cross-spawn-spawner"
+import { Instance } from "../../src/project/instance"
+import { Session } from "../../src/session"
+import { MessageV2 } from "../../src/session/message-v2"
+import { SessionPrompt } from "../../src/session/prompt"
+import { MessageID, PartID } from "../../src/session/schema"
+import { ModelID, ProviderID } from "../../src/provider/schema"
+import { TaskTool } from "../../src/tool/task"
+import { provideTmpdirInstance } from "../fixture/fixture"
+import { testEffect } from "../lib/effect"
+
+// Hivemind: tests for the ephemeral subagent flag on the Task tool.
+// Verifies the per-spawn override path (params.ephemeral) and the
+// frontmatter-default path (agent declares ephemeral). Mutual
+// exclusion with task_id is checked. Termination-driven cleanup
+// itself is covered by test/session/ephemeral.test.ts; here we
+// only assert that the spawned session is created with the right
+// `ephemeral` value.
+
+afterEach(async () => {
+  await Instance.disposeAll()
+})
+
+const ref = {
+  providerID: ProviderID.make("test"),
+  modelID: ModelID.make("test-model"),
+}
+
+const it = testEffect(
+  Layer.mergeAll(Agent.defaultLayer, Config.defaultLayer, CrossSpawnSpawner.defaultLayer, Session.defaultLayer),
+)
+
+const seed = Effect.fn("TaskEphemeralTest.seed")(function* (title = "Pinned") {
+  const session = yield* Session.Service
+  const chat = yield* session.create({ title })
+  const user = yield* session.updateMessage({
+    id: MessageID.ascending(),
+    role: "user",
+    sessionID: chat.id,
+    agent: "build",
+    model: ref,
+    time: { created: Date.now() },
+  })
+  const assistant: MessageV2.Assistant = {
+    id: MessageID.ascending(),
+    role: "assistant",
+    parentID: user.id,
+    sessionID: chat.id,
+    mode: "build",
+    agent: "build",
+    cost: 0,
+    path: { cwd: "/tmp", root: "/tmp" },
+    tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+    modelID: ref.modelID,
+    providerID: ref.providerID,
+    time: { created: Date.now() },
+  }
+  yield* session.updateMessage(assistant)
+  return { chat, assistant }
+})
+
+function reply(input: Parameters<typeof SessionPrompt.prompt>[0], text: string): MessageV2.WithParts {
+  const id = MessageID.ascending()
+  return {
+    info: {
+      id,
+      role: "assistant",
+      parentID: input.messageID ?? MessageID.ascending(),
+      sessionID: input.sessionID,
+      mode: input.agent ?? "general",
+      agent: input.agent ?? "general",
+      cost: 0,
+      path: { cwd: "/tmp", root: "/tmp" },
+      tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+      modelID: input.model?.modelID ?? ref.modelID,
+      providerID: input.model?.providerID ?? ref.providerID,
+      time: { created: Date.now() },
+      finish: "stop",
+    },
+    parts: [
+      {
+        id: PartID.ascending(),
+        messageID: id,
+        sessionID: input.sessionID,
+        type: "text",
+        text,
+      },
+    ],
+  }
+}
+
+describe("tool.task ephemeral", () => {
+  it.live("Task(ephemeral=true) creates an ephemeral session", () =>
+    provideTmpdirInstance(() =>
+      Effect.gen(function* () {
+        const sessions = yield* Session.Service
+        const { chat, assistant } = yield* seed()
+        const tool = yield* TaskTool
+        const def = yield* Effect.promise(() => tool.init())
+        const resolve = SessionPrompt.resolvePromptParts
+        const prompt = SessionPrompt.prompt
+
+        SessionPrompt.resolvePromptParts = async (template) => [{ type: "text", text: template }]
+        SessionPrompt.prompt = async (input) => reply(input, "done")
+        yield* Effect.addFinalizer(() =>
+          Effect.sync(() => {
+            SessionPrompt.resolvePromptParts = resolve
+            SessionPrompt.prompt = prompt
+          }),
+        )
+
+        const result = yield* Effect.promise(() =>
+          def.execute(
+            {
+              description: "explore foo",
+              prompt: "find foo references",
+              subagent_type: "general",
+              ephemeral: true,
+            },
+            {
+              sessionID: chat.id,
+              messageID: assistant.id,
+              agent: "build",
+              abort: new AbortController().signal,
+              messages: [],
+              metadata() {},
+              ask: async () => {},
+            },
+          ),
+        )
+
+        const childID = result.metadata.sessionId
+        const child = yield* sessions.get(childID)
+        expect(child.ephemeral).toBe(true)
+      }),
+    ),
+  )
+
+  it.live("Task() default is non-ephemeral", () =>
+    provideTmpdirInstance(() =>
+      Effect.gen(function* () {
+        const sessions = yield* Session.Service
+        const { chat, assistant } = yield* seed()
+        const tool = yield* TaskTool
+        const def = yield* Effect.promise(() => tool.init())
+        const resolve = SessionPrompt.resolvePromptParts
+        const prompt = SessionPrompt.prompt
+
+        SessionPrompt.resolvePromptParts = async (template) => [{ type: "text", text: template }]
+        SessionPrompt.prompt = async (input) => reply(input, "done")
+        yield* Effect.addFinalizer(() =>
+          Effect.sync(() => {
+            SessionPrompt.resolvePromptParts = resolve
+            SessionPrompt.prompt = prompt
+          }),
+        )
+
+        const result = yield* Effect.promise(() =>
+          def.execute(
+            {
+              description: "regular work",
+              prompt: "do thing",
+              subagent_type: "general",
+            },
+            {
+              sessionID: chat.id,
+              messageID: assistant.id,
+              agent: "build",
+              abort: new AbortController().signal,
+              messages: [],
+              metadata() {},
+              ask: async () => {},
+            },
+          ),
+        )
+
+        const child = yield* sessions.get(result.metadata.sessionId)
+        expect(child.ephemeral).toBeFalsy()
+      }),
+    ),
+  )
+
+  it.live("Task(task_id, ephemeral=true) is rejected at the schema layer", () =>
+    provideTmpdirInstance(() =>
+      Effect.gen(function* () {
+        const sessions = yield* Session.Service
+        const { chat, assistant } = yield* seed()
+        const child = yield* sessions.create({ parentID: chat.id, title: "Existing" })
+        const tool = yield* TaskTool
+        const def = yield* Effect.promise(() => tool.init())
+
+        // The Task tool's validation failure surfaces as a rejected
+        // promise from `def.execute`. Use Effect.tryPromise so the
+        // rejection becomes a typed failure that Effect.exit can
+        // capture (Effect.promise turns rejections into defects,
+        // which would crash the test runner instead).
+        const exitResult = yield* Effect.exit(
+          Effect.tryPromise({
+            try: () =>
+              def.execute(
+                {
+                  description: "resume + ephemeral",
+                  prompt: "should reject",
+                  subagent_type: "general",
+                  task_id: child.id,
+                  ephemeral: true,
+                },
+                {
+                  sessionID: chat.id,
+                  messageID: assistant.id,
+                  agent: "build",
+                  abort: new AbortController().signal,
+                  messages: [],
+                  metadata() {},
+                  ask: async () => {},
+                },
+              ),
+            catch: (err) => err as Error,
+          }),
+        )
+        expect(exitResult._tag).toBe("Failure")
+        // Effect 4.x exposes the wrapped error via `cause.reasons`.
+        // Each Reason is { _tag: "Fail" | "Die" | "Interrupt", error/defect }.
+        const cause = (exitResult as unknown as {
+          cause: { reasons: ReadonlyArray<{ _tag: string; error?: Error; defect?: unknown }> }
+        }).cause
+        const reason = cause.reasons[0]
+        const err = (reason?.error ?? reason?.defect) as Error | undefined
+        expect(err?.message ?? "").toContain("ephemeral")
+      }),
+    ),
+  )
+
+  it.live("frontmatter ephemeral default applies when caller omits the flag", () =>
+    provideTmpdirInstance(
+      () =>
+        Effect.gen(function* () {
+          const sessions = yield* Session.Service
+          const { chat, assistant } = yield* seed()
+          const tool = yield* TaskTool
+          const def = yield* Effect.promise(() => tool.init())
+          const resolve = SessionPrompt.resolvePromptParts
+          const prompt = SessionPrompt.prompt
+
+          SessionPrompt.resolvePromptParts = async (template) => [{ type: "text", text: template }]
+          SessionPrompt.prompt = async (input) => reply(input, "done")
+          yield* Effect.addFinalizer(() =>
+            Effect.sync(() => {
+              SessionPrompt.resolvePromptParts = resolve
+              SessionPrompt.prompt = prompt
+            }),
+          )
+
+          const result = yield* Effect.promise(() =>
+            def.execute(
+              {
+                description: "always-ephemeral",
+                prompt: "do",
+                subagent_type: "throwaway",
+              },
+              {
+                sessionID: chat.id,
+                messageID: assistant.id,
+                agent: "build",
+                abort: new AbortController().signal,
+                messages: [],
+                metadata() {},
+                ask: async () => {},
+              },
+            ),
+          )
+
+          const child = yield* sessions.get(result.metadata.sessionId)
+          expect(child.ephemeral).toBe(true)
+        }),
+      {
+        config: {
+          agent: {
+            throwaway: {
+              description: "Always-ephemeral subagent (test fixture)",
+              mode: "subagent",
+              ephemeral: true,
+            },
+          },
+        },
+      },
+    ),
+  )
+
+  it.live("per-spawn ephemeral=false overrides frontmatter default true", () =>
+    provideTmpdirInstance(
+      () =>
+        Effect.gen(function* () {
+          const sessions = yield* Session.Service
+          const { chat, assistant } = yield* seed()
+          const tool = yield* TaskTool
+          const def = yield* Effect.promise(() => tool.init())
+          const resolve = SessionPrompt.resolvePromptParts
+          const prompt = SessionPrompt.prompt
+
+          SessionPrompt.resolvePromptParts = async (template) => [{ type: "text", text: template }]
+          SessionPrompt.prompt = async (input) => reply(input, "done")
+          yield* Effect.addFinalizer(() =>
+            Effect.sync(() => {
+              SessionPrompt.resolvePromptParts = resolve
+              SessionPrompt.prompt = prompt
+            }),
+          )
+
+          const result = yield* Effect.promise(() =>
+            def.execute(
+              {
+                description: "override",
+                prompt: "do",
+                subagent_type: "throwaway",
+                ephemeral: false,
+              },
+              {
+                sessionID: chat.id,
+                messageID: assistant.id,
+                agent: "build",
+                abort: new AbortController().signal,
+                messages: [],
+                metadata() {},
+                ask: async () => {},
+              },
+            ),
+          )
+
+          const child = yield* sessions.get(result.metadata.sessionId)
+          expect(child.ephemeral).toBe(false)
+        }),
+      {
+        config: {
+          agent: {
+            throwaway: {
+              description: "Always-ephemeral subagent (test fixture)",
+              mode: "subagent",
+              ephemeral: true,
+            },
+          },
+        },
+      },
+    ),
+  )
+})
