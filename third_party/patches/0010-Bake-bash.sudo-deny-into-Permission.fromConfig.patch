From 9b75ef65b519da19a38d8c7e2f20d5d316d7a677 Mon Sep 17 00:00:00 2001
From: Lucas Santos <lsantos7654@gmail.com>
Date: Mon, 20 Apr 2026 21:22:13 -0400
Subject: [PATCH 10/25] Bake `bash.sudo *: deny` into Permission.fromConfig
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Replaces hivemind's runtime injection of `permissions.bash."sudo *":
"deny"` into ~/.config/opencode/opencode.json with a default that's
baked into opencode's own permission ruleset builder.

Every Permission.fromConfig() call now produces a ruleset prefixed with
{permission: "bash", pattern: "sudo *", action: "deny"}. Because
permission/evaluate.ts:9-15 uses findLast() to pick the matching rule,
user-supplied rules placed later in the merged ruleset still win — so
a user with `bash: { "sudo *": "allow" }` in their config opts back in.

A blanket `bash: { "*": "allow" }` will also override (the catch-all
matches and is later in the list) — that is intentional; explicit user
opt-out remains possible. Users without any bash config get sudo deny
by default.
---
 packages/opencode/src/permission/index.ts     | 15 +++++++-
 .../opencode/test/permission/next.test.ts     | 36 +++++++++++++++----
 2 files changed, 43 insertions(+), 8 deletions(-)

diff --git a/packages/opencode/src/permission/index.ts b/packages/opencode/src/permission/index.ts
index b2cc0f9..ffc0b7e 100644
--- a/packages/opencode/src/permission/index.ts
+++ b/packages/opencode/src/permission/index.ts
@@ -276,8 +276,21 @@ export namespace Permission {
     return pattern
   }
 
+  // Hivemind hardening: every ruleset includes `bash.sudo *: deny`
+  // prepended so sudo is denied by default. User config rules appear
+  // later in the merged ruleset and findLast() in evaluate() picks the
+  // last match, so a user-supplied `bash: { "sudo *": "allow" }` still
+  // wins. A blanket `bash: { "*": "allow" }` will also override (the
+  // catch-all matches and is later in the list) — that is intentional;
+  // explicit user opt-out remains possible.
+  const HIVEMIND_DENY_SUDO: Rule = {
+    permission: "bash",
+    pattern: "sudo *",
+    action: "deny",
+  }
+
   export function fromConfig(permission: Config.Permission) {
-    const ruleset: Ruleset = []
+    const ruleset: Ruleset = [HIVEMIND_DENY_SUDO]
     for (const [key, value] of Object.entries(permission)) {
       if (typeof value === "string") {
         ruleset.push({ permission: key, action: value, pattern: "*" })
diff --git a/packages/opencode/test/permission/next.test.ts b/packages/opencode/test/permission/next.test.ts
index 043e325..2087253 100644
--- a/packages/opencode/test/permission/next.test.ts
+++ b/packages/opencode/test/permission/next.test.ts
@@ -34,12 +34,16 @@ async function waitForPending(count: number) {
 
 test("fromConfig - string value becomes wildcard rule", () => {
   const result = Permission.fromConfig({ bash: "allow" })
-  expect(result).toEqual([{ permission: "bash", pattern: "*", action: "allow" }])
+  expect(result).toEqual([
+    { permission: "bash", pattern: "sudo *", action: "deny" },
+    { permission: "bash", pattern: "*", action: "allow" },
+  ])
 })
 
 test("fromConfig - object value converts to rules array", () => {
   const result = Permission.fromConfig({ bash: { "*": "allow", rm: "deny" } })
   expect(result).toEqual([
+    { permission: "bash", pattern: "sudo *", action: "deny" },
     { permission: "bash", pattern: "*", action: "allow" },
     { permission: "bash", pattern: "rm", action: "deny" },
   ])
@@ -52,6 +56,7 @@ test("fromConfig - mixed string and object values", () => {
     webfetch: "ask",
   })
   expect(result).toEqual([
+    { permission: "bash", pattern: "sudo *", action: "deny" },
     { permission: "bash", pattern: "*", action: "allow" },
     { permission: "bash", pattern: "rm", action: "deny" },
     { permission: "edit", pattern: "*", action: "allow" },
@@ -61,32 +66,49 @@ test("fromConfig - mixed string and object values", () => {
 
 test("fromConfig - empty object", () => {
   const result = Permission.fromConfig({})
-  expect(result).toEqual([])
+  expect(result).toEqual([
+    { permission: "bash", pattern: "sudo *", action: "deny" },
+  ])
 })
 
 test("fromConfig - expands tilde to home directory", () => {
   const result = Permission.fromConfig({ external_directory: { "~/projects/*": "allow" } })
-  expect(result).toEqual([{ permission: "external_directory", pattern: `${os.homedir()}/projects/*`, action: "allow" }])
+  expect(result).toEqual([
+    { permission: "bash", pattern: "sudo *", action: "deny" },
+    { permission: "external_directory", pattern: `${os.homedir()}/projects/*`, action: "allow" },
+  ])
 })
 
 test("fromConfig - expands $HOME to home directory", () => {
   const result = Permission.fromConfig({ external_directory: { "$HOME/projects/*": "allow" } })
-  expect(result).toEqual([{ permission: "external_directory", pattern: `${os.homedir()}/projects/*`, action: "allow" }])
+  expect(result).toEqual([
+    { permission: "bash", pattern: "sudo *", action: "deny" },
+    { permission: "external_directory", pattern: `${os.homedir()}/projects/*`, action: "allow" },
+  ])
 })
 
 test("fromConfig - expands $HOME without trailing slash", () => {
   const result = Permission.fromConfig({ external_directory: { $HOME: "allow" } })
-  expect(result).toEqual([{ permission: "external_directory", pattern: os.homedir(), action: "allow" }])
+  expect(result).toEqual([
+    { permission: "bash", pattern: "sudo *", action: "deny" },
+    { permission: "external_directory", pattern: os.homedir(), action: "allow" },
+  ])
 })
 
 test("fromConfig - does not expand tilde in middle of path", () => {
   const result = Permission.fromConfig({ external_directory: { "/some/~/path": "allow" } })
-  expect(result).toEqual([{ permission: "external_directory", pattern: "/some/~/path", action: "allow" }])
+  expect(result).toEqual([
+    { permission: "bash", pattern: "sudo *", action: "deny" },
+    { permission: "external_directory", pattern: "/some/~/path", action: "allow" },
+  ])
 })
 
 test("fromConfig - expands exact tilde to home directory", () => {
   const result = Permission.fromConfig({ external_directory: { "~": "allow" } })
-  expect(result).toEqual([{ permission: "external_directory", pattern: os.homedir(), action: "allow" }])
+  expect(result).toEqual([
+    { permission: "bash", pattern: "sudo *", action: "deny" },
+    { permission: "external_directory", pattern: os.homedir(), action: "allow" },
+  ])
 })
 
 test("evaluate - matches expanded tilde pattern", () => {
