From f93a744eef26ee4ff1396d54df7a5a05845eb01b Mon Sep 17 00:00:00 2001
From: Lucas Santos <lsantos7654@gmail.com>
Date: Thu, 14 May 2026 23:10:39 -0400
Subject: [PATCH 25/26] fix: resolve agent from session history on inbox/prompt
 fallback
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

When send_message delivers a prompt via the inbox (or any caller
omitting agent), createUserMessage fell back to defaultAgent() —
switching an expert subagent to the built-in primary agent and
losing the expert's system prompt, skills, and TUI identity.

Add lastAgent (mirroring lastModel) that returns the most recent
user message's agent from the session stream, so the session
retains its assigned expert agent across inbox-driven turns.
---
 packages/opencode/src/session/prompt.ts | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/packages/opencode/src/session/prompt.ts b/packages/opencode/src/session/prompt.ts
index b037d21..5165ebd 100644
--- a/packages/opencode/src/session/prompt.ts
+++ b/packages/opencode/src/session/prompt.ts
@@ -923,8 +923,18 @@ NOTE: At any point in time through this workflow you should feel free to ask the
         return yield* provider.defaultModel()
       })
 
+      const lastAgent = Effect.fnUntraced(function* (sessionID: SessionID) {
+        const agent = yield* Effect.promise(async () => {
+          for await (const item of MessageV2.stream(sessionID)) {
+            if (item.info.role === "user" && item.info.agent) return item.info.agent
+          }
+        })
+        if (agent) return agent
+        return yield* agents.defaultAgent()
+      })
+
       const createUserMessage = Effect.fn("SessionPrompt.createUserMessage")(function* (input: PromptInput) {
-        const agentName = input.agent || (yield* agents.defaultAgent())
+        const agentName = input.agent || (yield* lastAgent(input.sessionID))
         const ag = yield* agents.get(agentName)
         if (!ag) {
           const available = (yield* agents.list()).filter((a) => !a.hidden).map((a) => a.name)
