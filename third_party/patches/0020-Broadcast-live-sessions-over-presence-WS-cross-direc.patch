new file mode 100644
index 0000000..da34243
--- /dev/null
+++ b/packages/opencode/src/cli/cmd/tui/context/presence-client.ts
@@ -0,0 +1,110 @@
+// Hivemind: long-lived client for the `/presence` WebSocket. One
+// connection per TUI process, kept alive for the life of the TUI.
+// The connection is the presence beacon — its close frame is what
+// the server reads to remove the entry from `_clients`.
+//
+// Bidirectional protocol on the same socket:
+//   client → server: { "type": "focus",         "sessionID": "ses_..." | null }
+//   server → client: { "type": "live-sessions", "sessions":  string[] }
+//
+// `currentFocus` is a single source of truth for "what does this
+// TUI claim to be focused on right now". `setFocus` updates it
+// and writes to the socket if open. Every `onopen` (initial AND
+// reconnect) re-sends `currentFocus`, so a transient disconnect or
+// daemon restart doesn't leave the TUI silently unfocused on the
+// server.
+
+export interface PresenceClient {
+  setFocus(sessionID: string | null): void
+  close(): void
+}
+
+export interface PresenceClientOptions {
+  url: string
+  onLiveSessions: (sessions: string[]) => void
+  WebSocketCtor?: typeof WebSocket
+  reconnectMs?: number
+}
+
+interface LiveSessionsMessage {
+  type: "live-sessions"
+  sessions: string[]
+}
+
+function isLiveSessionsMessage(value: unknown): value is LiveSessionsMessage {
+  if (!value || typeof value !== "object") return false
+  const obj = value as Record<string, unknown>
+  if (obj.type !== "live-sessions") return false
+  if (!Array.isArray(obj.sessions)) return false
+  return obj.sessions.every((s) => typeof s === "string")
+}
+
+export function createPresenceClient(opts: PresenceClientOptions): PresenceClient {
+  const Ctor = opts.WebSocketCtor ?? WebSocket
+  const reconnectMs = opts.reconnectMs ?? 500
+  let currentFocus: string | null = null
+  let ws: WebSocket | undefined
+  let closed = false
+  let reconnectTimer: ReturnType<typeof setTimeout> | undefined
+
+  function connect() {
+    if (closed) return
+    const next = new Ctor(opts.url)
+    ws = next
+    next.onopen = () => {
+      // Always send currentFocus on connect/reconnect — the server's
+      // _clients map starts a fresh entry at focus=null on every open,
+      // so we have to re-assert focus every time the socket comes up.
+      try {
+        next.send(JSON.stringify({ type: "focus", sessionID: currentFocus }))
+      } catch {
+        // ignore — onclose will fire and we'll reconnect
+      }
+    }
+    next.onmessage = (ev: MessageEvent) => {
+      try {
+        const raw = typeof ev.data === "string" ? ev.data : ""
+        if (!raw) return
+        const parsed = JSON.parse(raw)
+        if (isLiveSessionsMessage(parsed)) {
+          opts.onLiveSessions(parsed.sessions)
+        }
+      } catch {
+        // ignore malformed payload
+      }
+    }
+    next.onclose = () => {
+      if (ws === next) ws = undefined
+      if (closed) return
+      reconnectTimer = setTimeout(connect, reconnectMs)
+    }
+    next.onerror = () => {
+      // Errors are followed by onclose; nothing to do here.
+    }
+  }
+
+  connect()
+
+  return {
+    setFocus(sessionID: string | null) {
+      currentFocus = sessionID
+      const sock = ws
+      if (sock && sock.readyState === Ctor.OPEN) {
+        try {
+          sock.send(JSON.stringify({ type: "focus", sessionID }))
+        } catch {
+          // onclose will reconnect; currentFocus will re-send
+        }
+      }
+    },
+    close() {
+      closed = true
+      if (reconnectTimer) clearTimeout(reconnectTimer)
+      try {
+        ws?.close()
+      } catch {
+        // ignore
+      }
+    },
+  }
+}
