+// Hivemind: fan-out updated live-sessions list to every connected
+// client over their existing presence WebSocket. Cross-directory by
+// construction — `_clients` is module-scoped, no InstanceState lookup.
+// Replaces the previous `Bus.publish(LiveSessionsChanged, ...)` call,
+// which only reached subscribers in the publisher's directory.
+function _broadcast(): void {
+  const sessions = liveSessions()
+  const msg = JSON.stringify({ type: "live-sessions", sessions })
+  for (const key of _clients.keys()) {
+    try {
+      ;(key as { send: (data: string) => void }).send(msg)
+    } catch (err) {
+      // Failed sends mean a half-closed socket; onClose will sweep
+      // the entry shortly. Don't propagate.
+      log.error("presence: broadcast send failed", { err })
+    }
+  }
+}
