From 31e547cb47ed04222c5ad1712dcfb0b5a2c0afcb Mon Sep 17 00:00:00 2001
From: Lucas Santos <lsantos7654@gmail.com>
Date: Mon, 11 May 2026 00:54:53 -0400
Subject: [PATCH 30/35] fix: make Agent.reload() optional on Bus.Service
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Uses Effect.serviceOptional(Bus.Service) instead of yielding
it directly. When Bus.Service is not in the layer tree
(reloadAll static helper path), the Bus.publish is skipped
— the presence WebSocket broadcast (patch 0023) handles TUI
notification. Fixes the Bus.Service scope mismatch in
Instance.provide's fn generic chain.
---
 packages/opencode/src/agent/agent.ts | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/packages/opencode/src/agent/agent.ts b/packages/opencode/src/agent/agent.ts
index 5bb21b0..ea3d0b2 100644
--- a/packages/opencode/src/agent/agent.ts
+++ b/packages/opencode/src/agent/agent.ts
@@ -19,7 +19,7 @@ import { Global } from "@/global"
 import path from "path"
 import { Plugin } from "@/plugin"
 import { Skill } from "../skill"
-import { Effect, ServiceMap, Layer } from "effect"
+import { Effect, ServiceMap, Layer, Option } from "effect"
 import { InstanceState } from "@/effect/instance-state"
 import { makeRuntime } from "@/effect/run-service"
 import { Bus } from "@/bus"
@@ -69,7 +69,7 @@ export namespace Agent {
     readonly get: (agent: string) => Effect.Effect<Agent.Info>
     readonly list: () => Effect.Effect<Agent.Info[]>
     readonly defaultAgent: () => Effect.Effect<string>
-    readonly reload: () => Effect.Effect<{ count: number }, never, Bus.Service>
+    readonly reload: () => Effect.Effect<{ count: number }>
     readonly generate: (input: {
       description: string
       model?: { providerID: ProviderID; modelID: ModelID }
@@ -349,8 +349,11 @@ export namespace Agent {
           yield* config.invalidateState()
           yield* InstanceState.invalidate(state)
           const list = yield* InstanceState.useEffect(state, (s) => s.list())
-          const bus = yield* Bus.Service
-          yield* bus.publish(AgentsChanged, { count: list.length }).pipe(Effect.ignore)
+          const bus = yield* Effect.serviceOptional(Bus.Service)
+          yield* Option.match(bus, {
+            onNone: () => Effect.unit,
+            onSome: (b) => b.publish(AgentsChanged, { count: list.length }).pipe(Effect.ignore),
+          })
           return { count: list.length }
         }),
         generate: Effect.fn("Agent.generate")(function* (input: {
-- 
