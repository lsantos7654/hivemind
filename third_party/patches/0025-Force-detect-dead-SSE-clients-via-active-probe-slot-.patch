diff --git a/packages/opencode/src/server/routes/event.ts b/packages/opencode/src/server/routes/event.ts
index c5a480d..6badaea 100644
--- a/packages/opencode/src/server/routes/event.ts
+++ b/packages/opencode/src/server/routes/event.ts
@@ -46,40 +46,58 @@ export const LiveSessionsChanged = BusEvent.define(
 // liveness probe (see `_sweep`) can directly check socket state and
 // self-evict if the client died but the abstraction-layer disconnect
 // signals haven't fired yet.
+type NodeOutgoing = {
+  destroyed?: boolean
+  writableEnded?: boolean
+  socket?: { destroyed?: boolean; readable?: boolean; writable?: boolean }
+  write?: (chunk: string) => boolean | void
+  on?: Function
+}
 type ClientEntry = {
   focus: string | null
-  outgoing?: { destroyed?: boolean; writableEnded?: boolean; socket?: { destroyed?: boolean } }
+  outgoing?: NodeOutgoing
   stop?: () => void
 }
 const _clients = new Map<string, ClientEntry>()

 // Hivemind: server-side liveness probe. Fires every 2 seconds, iterates
-// `_clients`, and self-evicts any whose underlying Node `outgoing` is
-// destroyed/ended — i.e. the TUI's TCP socket is gone but the
-// `outgoing.on("close")` event hasn't been delivered to JS yet.
+// `_clients`, and actively writes an SSE-comment probe (`":\n"` — a
+// no-op per the SSE spec, ignored by clients) to each client's Node
+// `outgoing`. The probe forces the kernel to attempt a real send,
+// which surfaces `EPIPE` / write errors on half-closed sockets that
+// passive flag checks (`destroyed`, `writableEnded`, `socket.destroyed`)
+// don't catch.
 //
 // Why this is necessary: production runs on `@hono/node-server`'s Node
-// http compat on Bun. When a busy server has multiple sockets and steady
-// JS work, Bun's I/O loop batches socket-close events and only delivers
-// them when other I/O (e.g. a new incoming connection) wakes the loop.
-// The user's reproducer is exactly this: closing one of two TUIs leaves
-// the count stale until a third TUI connects. The event handlers on the
-// SSE handler (`stream.onAbort`, `c.req.raw.signal`,
-// `incoming.on("close")`, `outgoing.on("close")`) all sit downstream of
-// that batched event — when it doesn't fire, none of them do.
+// http compat on Bun. Bun's I/O loop batches socket-close events when
+// other I/O is active — they sit queued until something else wakes the
+// loop. Even `outgoing.destroyed` doesn't flip until that batched event
+// is delivered, so passive sweeps can't catch it either.
+//
+// Active write probes bypass the queue: writing to a half-closed socket
+// hits the kernel synchronously and (on Bun's compat) either throws,
+// returns false, or fires an 'error' event we hooked at registration
+// time. Any of those routes calls `stop()` and evicts the client.
 //
-// The probe bypasses the queue: it polls socket state directly. The
-// timer is `.unref()`d so it doesn't keep tests alive past their
-// natural lifetime.
+// The probe is "harmless" — `":\n"` is the SSE comment syntax. Clients
+// (curl, fetch readers) skip lines starting with `:` per the spec, so
+// the probe doesn't pollute the event stream.
 //
 // One timer at module scope, not per-client. Cost is constant in client
-// count: 2s interval × <1µs per probe iteration. Cheap.
+// count: 2s interval × one syscall per active client. Cheap.
 const _sweep = setInterval(() => {
   for (const [clientID, entry] of _clients) {
     const out = entry.outgoing
     if (!out) continue
     if (out.destroyed || out.writableEnded || out.socket?.destroyed) {
-      log.info("sweep evicting dead client", { clientID })
+      log.info("sweep evicting dead client (passive)", { clientID })
+      entry.stop?.()
+      continue
+    }
+    try {
+      out.write?.(":\n")
+    } catch {
+      log.info("sweep evicting dead client (write threw)", { clientID })
       entry.stop?.()
     }
   }
@@ -142,9 +160,28 @@ export const EventRoutes = () =>
         // here to wire disconnect detection directly to Node's socket
         // events — neither `stream.onAbort` nor `c.req.raw.signal` fires
         // reliably for long-lived SSE responses on Bun's Node compat.
-        const env = c.env as { incoming?: { on: Function; once: Function }; outgoing?: { on: Function; once: Function } } | undefined
+        const env = c.env as
+          | {
+              incoming?: { on: Function; once: Function; socket?: { setKeepAlive?: Function } }
+              outgoing?: { on: Function; once: Function }
+            }
+          | undefined
         const incoming = env?.incoming
         const outgoing = env?.outgoing
+        // Hivemind: enable aggressive TCP keepalive on the request
+        // socket so the kernel itself probes the peer every second
+        // and tears the socket down on failed probes. Without this,
+        // a Ctrl-C'd TUI's socket can sit half-open from the server's
+        // POV indefinitely on Bun's Node compat — none of the
+        // userland event handlers fire and even `outgoing.destroyed`
+        // never flips. Kernel-level keepalive bypasses the JS event
+        // queue entirely.
+        try {
+          incoming?.socket?.setKeepAlive?.(true, 1_000)
+        } catch {
+          // setKeepAlive may not be available on every transport
+          // (HTTP/2, WebSocket upgrade, etc.). Best-effort.
+        }
         return streamSSE(c, async (stream) => {
           const q = new AsyncQueue<string | null>()
           let done = false
@@ -180,7 +217,9 @@ export const EventRoutes = () =>
           c.req.raw.signal.addEventListener("abort", stop, { once: true })
           incoming?.once("close", stop)
           incoming?.once("aborted", stop)
+          incoming?.once("error", stop)
           outgoing?.once("close", stop)
+          outgoing?.once("error", stop)
           if (stream.aborted || c.req.raw.signal.aborted) {
             stop()
             return
