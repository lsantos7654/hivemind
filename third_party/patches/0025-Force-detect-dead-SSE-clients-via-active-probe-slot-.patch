@@ -172,10 +172,11 @@ const tui: TuiPlugin = async (api) => {
         // No focused session on home — Subagents renders 0.
         return <View api={api} />
       },
-      // Hivemind: rendered while inside a session. The slot context
-      // provides `session_id`, which feeds the per-TUI Subagents pill.
-      session_footer(ctx) {
-        return <View api={api} sessionID={ctx.session_id} />
