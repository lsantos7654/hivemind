From b3501078117d172147af91df7cd848b53a29d772 Mon Sep 17 00:00:00 2001
From: Lucas Santos <lsantos7654@gmail.com>
Date: Mon, 20 Apr 2026 21:22:13 -0400
Subject: [PATCH 05/15] Hardened opencode config defaults
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Bakes hivemind's hardening defaults into the opencode config schema so
they don't have to be merged into ~/.config/opencode/opencode.json by
`hivemind init`. After this patch + the corresponding cleanup in
opencode/config/defaults.json, the user-facing opencode.json no longer
contains a `hardening` block — it's the upstream default.

Changes:
  - share:               default "disabled" (was unset; opencode upstream
                         defaults to allowing manual share)
  - autoshare:           default false (deprecated but still consumed
                         by the legacy autoshare->share migration in
                         config.ts:1515)
  - autoupdate:          default false (was implicitly true)
  - server.hostname:     default "127.0.0.1" (was "localhost" via
                         cli/network.ts default)

Users can still override any of these in their own opencode.json.
---
 packages/opencode/src/config/config.ts | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/packages/opencode/src/config/config.ts b/packages/opencode/src/config/config.ts
index 15d7fca..cee060b 100644
--- a/packages/opencode/src/config/config.ts
+++ b/packages/opencode/src/config/config.ts
@@ -775,7 +775,7 @@ export namespace Config {
   export const Server = z
     .object({
       port: z.number().int().positive().optional().describe("Port to listen on"),
-      hostname: z.string().optional().describe("Hostname to listen on"),
+      hostname: z.string().optional().default("127.0.0.1").describe("Hostname to listen on"),
       mdns: z.boolean().optional().describe("Enable mDNS service discovery"),
       mdnsDomain: z.string().optional().describe("Custom domain name for mDNS service (default: opencode.local)"),
       cors: z.array(z.string()).optional().describe("Additional domains to allow for CORS"),
@@ -932,16 +932,19 @@ export namespace Config {
       share: z
         .enum(["manual", "auto", "disabled"])
         .optional()
+        .default("disabled")
         .describe(
           "Control sharing behavior:'manual' allows manual sharing via commands, 'auto' enables automatic sharing, 'disabled' disables all sharing",
         ),
       autoshare: z
         .boolean()
         .optional()
+        .default(false)
         .describe("@deprecated Use 'share' field instead. Share newly created sessions automatically"),
       autoupdate: z
         .union([z.boolean(), z.literal("notify")])
         .optional()
+        .default(false)
         .describe(
           "Automatically update to the latest version. Set to true to auto-update, false to disable, or 'notify' to show update notifications",
         ),
--
