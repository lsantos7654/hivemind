+    function presenceURL(): string {
+      const u = new URL(props.url)
+      u.protocol = u.protocol === "https:" ? "wss:" : "ws:"
+      u.pathname = (u.pathname.endsWith("/") ? u.pathname.slice(0, -1) : u.pathname) + "/presence"
+      return u.toString()
+    }
+
+    function sendFocus(sessionID: string | null) {
+      if (presenceWS && presenceWS.readyState === WebSocket.OPEN) {
+        presenceWS.send(JSON.stringify({ type: "focus", sessionID }))
+      } else {
+        pendingFocus = sessionID
+      }
+    }
+
+    function startPresence() {
+      if (presenceClosed) return
+      presenceWS = new WebSocket(presenceURL())
+      presenceReady = false
+      presenceWS.onopen = () => {
+        presenceReady = true
+        if (pendingFocus !== undefined) {
+          presenceWS?.send(JSON.stringify({ type: "focus", sessionID: pendingFocus }))
+          pendingFocus = undefined
+        }
+      }
+      presenceWS.onclose = () => {
+        presenceReady = false
+        presenceWS = undefined
+        if (presenceClosed || abort.signal.aborted) return
+        // Reconnect with a small backoff. Don't lose the most recent
+        // focus on reconnect — re-send it once the new socket opens.
+        presenceReconnectTimer = setTimeout(startPresence, 500)
+      }
+      presenceWS.onerror = () => {
+        // Errors will be followed by onclose; nothing to do here.
+      }
+    }
+
+    const route = useRoute()
