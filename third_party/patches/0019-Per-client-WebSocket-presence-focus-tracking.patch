+import { afterEach, describe, expect, test } from "bun:test"
+import type { Server as BunServer } from "bun"
+import { createBunWebSocket } from "hono/bun"
+import { Instance } from "../../src/project/instance"
+import { Server } from "../../src/server/server"
+import { Log } from "../../src/util/log"
+import { tmpdir } from "../fixture/fixture"
+
+Log.init({ print: false })
+
+afterEach(async () => {
+  await Instance.disposeAll()
+})
+
+// Hivemind: presence WebSocket tests. Native Bun.serve is the
+// substrate (same as production), real `WebSocket` clients open
+// connections, real CLOSE frames trigger cleanup. The protocol's
+// explicit close handshake means same-process tests faithfully
+// exercise the production code path — no need for a cross-process
+// curl variant; killing a `ws` instance fires `onClose` server-side
+// just like a TUI quitting does.
+
+// Hivemind: hono/bun's `upgradeWebSocket` and `websocket` are module-level
+// singletons (see node_modules/hono/dist/adapter/bun/websocket.js), so the
+// `websocket` handler we hand to Bun.serve here matches the
+// `upgradeWebSocket` Server.create() registered against. Calling
+// createBunWebSocket() in two places returns references to the same
+// singletons.
+const { websocket } = createBunWebSocket()
+
+async function startServer(): Promise<{ url: string; wsURL: string; stop: () => Promise<void> }> {
+  const app = Server.Default().app
+  let server: BunServer
+  // eslint-disable-next-line prefer-const
+  server = Bun.serve({
+    fetch: (req: Request) => app.fetch(req, server),
+    websocket,
+    port: 0,
+    hostname: "127.0.0.1",
+  })
+  return {
+    url: `http://127.0.0.1:${server.port}`,
+    wsURL: `ws://127.0.0.1:${server.port}`,
+    stop: async () => {
+      await server.stop(true)
+    },
+  }
+}
+
+async function liveSessions(url: string) {
+  const res = await fetch(url + "/global/live-sessions")
+  expect(res.status).toBe(200)
+  return (await res.json()) as { sessions: string[] }
+}
+
+async function openWS(wsURL: string): Promise<WebSocket> {
+  const ws = new WebSocket(wsURL + "/presence")
+  await new Promise<void>((resolve, reject) => {
+    ws.onopen = () => resolve()
