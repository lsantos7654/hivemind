From 1a41c06eef8c5707c78bfbe1afb242e220662cae Mon Sep 17 00:00:00 2001
From: Lucas Santos <lsantos7654@gmail.com>
Date: Wed, 29 Apr 2026 22:12:16 -0400
Subject: [PATCH 13/19] SessionPrompt.continue + bg-complete wake-up
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Closes the loop on background-mode Task: when a child finishes, the
parent now becomes aware of the result without waiting for the user
to type something. Phone-notification semantics — the result lands,
the parent runs a turn, the model sees the awareness reminder,
read_task_result is called, the assistant produces a response.

Two changes:

  1. SessionPrompt.continue(sessionID) — new primitive that mirrors
     prompt() but constructs its own minimal PromptInput with a
     single synthetic-flagged text part. The synthetic flag
     suppresses the per-step user-message wrap (see the loop body's
     existing `p.synthetic` skip) so the assistant doesn't see
     "<system-reminder>The user sent the following message:
     </system-reminder>" wrapping an empty string. Defaults take
     over for model/agent (both pulled from the session's last
     assistant turn) so a stale wake-up can't accidentally switch
     the active model.

  2. SessionBackground.complete now schedules a wake-up after the
     registry mutation. If the parent is idle, the wake-up calls
     SessionPrompt.continue_(parentID) which kicks a fresh turn —
     the system prompt assembly picks up the existing
     "Background tasks ready" reminder and the model handles the
     rest. If the parent is busy, the wake-up is a no-op because
     the loop's per-step system-prompt rebuild already injects the
     reminder on the next assistant iteration.

Both fire-and-forget paths handle BusyError as a no-op (the
running turn picks up the reminder per-step). All other errors are
logged and dropped — the registry mutation has already happened so
the worst case is the user types something and the reminder lands
then.

Subagents cannot spawn subagents (task.ts:75,92-100 deny `task` for
every Task-spawned child unless its definition explicitly grants
it; no hivemind agent does), so the wake-up cannot recurse: the
turn it kicks consumes the result via read_task_result and clears
the registry entry, preventing re-firing.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 packages/opencode/src/session/background.ts | 44 +++++++++++++++++++++
 packages/opencode/src/session/prompt.ts     | 33 ++++++++++++++++
 2 files changed, 77 insertions(+)

diff --git a/packages/opencode/src/session/background.ts b/packages/opencode/src/session/background.ts
index 5f24b5a..907fadb 100644
--- a/packages/opencode/src/session/background.ts
+++ b/packages/opencode/src/session/background.ts
@@ -17,7 +17,10 @@ import z from "zod"
 import { Bus } from "@/bus"
 import { BusEvent } from "@/bus/bus-event"
 import { Log } from "../util/log"
+import { Session } from "."
 import { SessionID } from "./schema"
+import { SessionPrompt } from "./prompt"
+import { SessionRunState } from "./run-state"

 export namespace SessionBackground {
   const log = Log.create({ service: "session.background" })
@@ -110,6 +113,11 @@ export namespace SessionBackground {
    * Mark a running task complete. Stores `result` for later consumption
    * via `consume`. No-op if the task is unknown (e.g. cancelled before
    * the runner reached completion). Fires BackgroundTasksChanged.
+   *
+   * Hivemind: also schedules a wake-up — see `_scheduleWakeUp`. The
+   * intent is phone-notification semantics: when a bg task finishes,
+   * the parent becomes aware of the result and can act on it without
+   * waiting for the user to type something.
    */
   export function complete(parentID: SessionID, taskID: SessionID, result: string): void {
     const bucket = _registry.get(parentID)
@@ -123,6 +131,42 @@ export namespace SessionBackground {
     entry.completedAt = Date.now()
     log.info("complete", { parentID, taskID, resultLength: result.length })
     _publishChange()
+    _scheduleWakeUp(parentID)
+  }
+
+  /**
+   * Hivemind: wake the parent if it's idle so the model sees the
+   * <system-reminder> announcing the ready task_id. If the parent is
+   * mid-turn, do nothing — its next loop step re-assembles the system
+   * prompt and picks up the reminder automatically (see prompt.ts
+   * around the "Background tasks ready" injection block).
+   *
+   * Fire-and-forget. Failures are logged and dropped because the
+   * registry mutation has already happened; the worst case is the
+   * user types something and the reminder lands then. We do not
+   * retry on failure.
+   */
+  function _scheduleWakeUp(parentID: SessionID): void {
+    void (async () => {
+      try {
+        await SessionRunState.assertNotBusy(parentID)
+      } catch (err) {
+        if (err instanceof Session.BusyError) return
+        log.error("wake-up busy-check failed", { parentID, err })
+        return
+      }
+      try {
+        await SessionPrompt.continue_(parentID)
+      } catch (err) {
+        if (err instanceof Session.BusyError) {
+          // Tiny race: parent went busy between our check and our call.
+          // Same outcome as the busy branch above — let the running
+          // turn pick up the reminder per-step.
+          return
+        }
+        log.error("wake-up prompt failed", { parentID, err })
+      }
+    })()
   }

   /**
diff --git a/packages/opencode/src/session/prompt.ts b/packages/opencode/src/session/prompt.ts
index 4aaf957..e10dbe1 100644
--- a/packages/opencode/src/session/prompt.ts
+++ b/packages/opencode/src/session/prompt.ts
@@ -69,6 +69,7 @@ export namespace SessionPrompt {
   export interface Interface {
     readonly cancel: (sessionID: SessionID) => Effect.Effect<void>
     readonly prompt: (input: PromptInput) => Effect.Effect<MessageV2.WithParts>
+    readonly continue_: (sessionID: SessionID) => Effect.Effect<MessageV2.WithParts>
     readonly loop: (input: z.infer<typeof LoopInput>) => Effect.Effect<MessageV2.WithParts>
     readonly shell: (input: ShellInput) => Effect.Effect<MessageV2.WithParts>
     readonly command: (input: CommandInput) => Effect.Effect<MessageV2.WithParts>
@@ -1299,6 +1300,31 @@ NOTE: At any point in time through this workflow you should feel free to ask the
         },
       )

+      // Hivemind: kick a turn for `sessionID` without injecting a
+      // visible user message. Used by SessionBackground.complete to
+      // wake an idle parent when one of its background-mode Task
+      // children finishes — the new turn's system-prompt assembly
+      // (this file, the per-step injection block) picks up the
+      // <system-reminder> listing the ready task_ids and the model
+      // calls read_task_result.
+      //
+      // We construct a minimal PromptInput with a single
+      // `synthetic: true` text part. The synthetic flag suppresses
+      // the per-step user-message wrap (see the loop body) so the
+      // assistant doesn't see "<system-reminder>The user sent the
+      // following message: </system-reminder>" wrapping an empty
+      // string. Defaults take over for `model`/`agent` (both pulled
+      // from the session's last assistant turn), so a stale wake-up
+      // can't accidentally switch the active model.
+      const continue_: (sessionID: SessionID) => Effect.Effect<MessageV2.WithParts> = Effect.fn(
+        "SessionPrompt.continue",
+      )(function* (sessionID: SessionID) {
+        return yield* prompt({
+          sessionID,
+          parts: [{ type: "text", text: "", synthetic: true }],
+        })
+      })
+
       const lastAssistant = (sessionID: SessionID) =>
         Effect.promise(async () => {
           let latest: MessageV2.WithParts | undefined
@@ -1687,6 +1713,7 @@ NOTE: At any point in time through this workflow you should feel free to ask the
       return Service.of({
         cancel,
         prompt,
+        continue_,
         loop,
         shell,
         command,
@@ -1793,6 +1820,12 @@ NOTE: At any point in time through this workflow you should feel free to ask the
     return runPromise((svc) => svc.prompt(PromptInput.parse(input)))
   }

+  // Hivemind: see Interface.continue_ above. Named with the trailing
+  // underscore because `continue` is a reserved word in TypeScript.
+  export async function continue_(sessionID: SessionID) {
+    return runPromise((svc) => svc.continue_(SessionID.zod.parse(sessionID)))
+  }
+
   export async function resolvePromptParts(template: string) {
     return runPromise((svc) => svc.resolvePromptParts(z.string().parse(template)))
   }
