 packages/opencode/src/server/routes/event.ts  |  34 +++-
 .../test/server/event.real-server.test.ts     | 153 ++++++++++++++++++
 2 files changed, 182 insertions(+), 5 deletions(-)
 create mode 100644 packages/opencode/test/server/event.real-server.test.ts

diff --git a/packages/opencode/src/server/routes/event.ts b/packages/opencode/src/server/routes/event.ts
index 67a0b18..18ef44a 100644
--- a/packages/opencode/src/server/routes/event.ts
+++ b/packages/opencode/src/server/routes/event.ts
@@ -148,6 +148,17 @@ export const EventRoutes = () =>
         c.header("Cache-Control", "no-cache, no-transform")
         c.header("X-Accel-Buffering", "no")
         c.header("X-Content-Type-Options", "nosniff")
+        // Hivemind: in production we run on `@hono/node-server`'s Node http
+        // adaptor. The adaptor exposes the underlying Node IncomingMessage
+        // and ServerResponse via Hono's bindings argument (see
+        // `getRequestListener` in @hono/node-server: it calls
+        // `fetchCallback(req, { incoming, outgoing })`). We capture them
+        // here to wire disconnect detection directly to Node's socket
+        // events — neither `stream.onAbort` nor `c.req.raw.signal` fires
+        // reliably for long-lived SSE responses on Bun's Node compat.
+        const env = c.env as { incoming?: { on: Function; once: Function }; outgoing?: { on: Function; once: Function } } | undefined
+        const incoming = env?.incoming
+        const outgoing = env?.outgoing
         return streamSSE(c, async (stream) => {
           const q = new AsyncQueue<string | null>()
           let done = false
@@ -166,12 +177,25 @@ export const EventRoutes = () =>
             log.info("event disconnected", { clientID })
           }

-          // Register cleanup BEFORE any state mutation. `stream.onAbort`
-          // is the canonical disconnect hook on Bun >= 1.2 — registering
-          // before `_clients.set` closes the race window patches 0009–
-          // 0030 in the prior architecture chased ineffectually.
+          // Register cleanup BEFORE any state mutation. We hook every
+          // disconnect signal we can reach. Production runs on
+          // `@hono/node-server` (Node http compat on Bun); empirically,
+          // for long-lived SSE responses neither `stream.onAbort` nor
+          // `c.req.raw.signal` fires when curl is killed — heartbeat
+          // writes succeed silently into the kernel send buffer post-
+          // FIN, so Bun never observes the close at the response-stream
+          // level. The Node `incoming` / `outgoing` socket events are
+          // the only reliable source of disconnect detection on this
+          // topology.
+          //
+          // `stop()` is idempotent via `done`, so any number of these
+          // can fire. Whichever fires first wins.
           stream.onAbort(stop)
-          if (stream.aborted) {
+          c.req.raw.signal.addEventListener("abort", stop, { once: true })
+          incoming?.once("close", stop)
+          incoming?.once("aborted", stop)
+          outgoing?.once("close", stop)
+          if (stream.aborted || c.req.raw.signal.aborted) {
             stop()
             return
           }
diff --git a/packages/opencode/test/server/event.real-server.test.ts b/packages/opencode/test/server/event.real-server.test.ts
new file mode 100644
index 0000000..c9d13de
--- /dev/null
+++ b/packages/opencode/test/server/event.real-server.test.ts
@@ -0,0 +1,153 @@
+import { afterEach, describe, expect, test } from "bun:test"
+import { createAdaptorServer } from "@hono/node-server"
+import { AddressInfo } from "node:net"
+import { Instance } from "../../src/project/instance"
+import { Server } from "../../src/server/server"
+import { Log } from "../../src/util/log"
+import { tmpdir } from "../fixture/fixture"
+
+Log.init({ print: false })
+
+afterEach(async () => {
+  await Instance.disposeAll()
+})
+
+// Hivemind: this suite spins the same `@hono/node-server` adaptor
+// that production uses (`server.ts:286 createAdaptorServer({...})`)
+// on a random port, and drives it from a SEPARATE child process
+// (`curl -N`). The combination matters:
+//
+//  - `app.request()` (used by `event.test.ts`) is in-process
+//    fake-fetch — Hono dispatches handlers without any HTTP layer.
+//  - Native `Bun.serve` exercises Bun's uWebSockets-derived stack.
+//  - `@hono/node-server` runs on Bun's Node compat (`node:http`),
+//    which is what production actually uses — and where the
+//    SSE-disconnect bug manifests.
+//
+// Cross-process curl is needed because same-process fetch+abort
+// goes through an in-runtime shortcut that propagates cancel
+// cleanly. Real OS-level FIN is the only path that exercises the
+// production failure mode.
+
+async function liveSessions(url: string) {
+  const res = await fetch(url + "/global/live-sessions")
+  expect(res.status).toBe(200)
+  return (await res.json()) as { sessions: string[]; subagents: string[] }
+}
+
+async function spawnCurlSSE(url: string, clientID: string) {
+  const proc = Bun.spawn({
+    cmd: ["curl", "-Ns", "-H", `X-Client-ID: ${clientID}`, url + "/event"],
+    stdout: "pipe",
+    stderr: "ignore",
+  })
+  // Wait until at least one byte has arrived so we know the server has
+  // accepted the SSE handshake (and thus registered the client in the
+  // presence map).
+  const reader = proc.stdout.getReader()
+  await reader.read()
+  reader.releaseLock()
+  return proc
+}
+
+async function startServer(): Promise<{ url: string; stop: () => Promise<void> }> {
+  const app = Server.Default().app
+  const server = createAdaptorServer({ fetch: app.fetch })
+  await new Promise<void>((resolve, reject) => {
+    server.once("error", reject)
+    server.once("listening", () => resolve())
+    server.listen(0, "127.0.0.1")
+  })
+  const addr = server.address() as AddressInfo
+  return {
+    url: `http://127.0.0.1:${addr.port}`,
+    stop: () => new Promise<void>((resolve) => server.close(() => resolve())),
+  }
+}
+
+describe("event presence over @hono/node-server (cross-process)", () => {
+  test("killing a separate-process SSE client removes the client", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const { url, stop: stopServer } = await startServer()
+        try {
+          const proc = await spawnCurlSSE(url, "real-A")
+          // give the server a tick to register
+          await Bun.sleep(50)
+
+          await fetch(url + "/event/focus", {
+            method: "POST",
+            headers: { "X-Client-ID": "real-A", "Content-Type": "application/json" },
+            body: JSON.stringify({ sessionID: "ses_real_root" }),
+          })
+          await Bun.sleep(50)
+
+          const before = await liveSessions(url)
+          expect(before.sessions).toContain("ses_real_root")
+
+          // Heartbeats fire every 10s. The bug only manifests after at
+          // least one heartbeat write succeeds silently into the kernel
+          // send buffer post-FIN, which is what blocks Bun from
+          // observing the close. Wait through one full heartbeat
+          // before killing.
+          await Bun.sleep(11_000)
+
+          // Kernel-level FIN delivery: kill the curl process. The OS
+          // tears down the socket; the server must observe it.
+          proc.kill()
+          await proc.exited
+          await Bun.sleep(500)
+
+          const after = await liveSessions(url)
+          expect(after.sessions).toEqual([])
+        } finally {
+          await stopServer()
+        }
+      },
+    })
+  }, { timeout: 30_000 })
+
+  test("two cross-process clients, one is killed, only its focus drops", async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const { url, stop: stopServer } = await startServer()
+        try {
+          const procA = await spawnCurlSSE(url, "real-A")
+          const procB = await spawnCurlSSE(url, "real-B")
+          await Bun.sleep(50)
+
+          await fetch(url + "/event/focus", {
+            method: "POST",
+            headers: { "X-Client-ID": "real-A", "Content-Type": "application/json" },
+            body: JSON.stringify({ sessionID: "ses_root_A" }),
+          })
+          await fetch(url + "/event/focus", {
+            method: "POST",
+            headers: { "X-Client-ID": "real-B", "Content-Type": "application/json" },
+            body: JSON.stringify({ sessionID: "ses_root_B" }),
+          })
+          await Bun.sleep(50)
+
+          const both = await liveSessions(url)
+          expect(both.sessions.sort()).toEqual(["ses_root_A", "ses_root_B"])
+
+          procA.kill()
+          await procA.exited
+          await Bun.sleep(500)
+
+          const onlyB = await liveSessions(url)
+          expect(onlyB.sessions).toEqual(["ses_root_B"])
+
+          procB.kill()
+          await procB.exited
+        } finally {
+          await stopServer()
+        }
+      },
+    })
+  })
+})
