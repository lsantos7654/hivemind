From d83ac106380c7ef3c0beb3a3faf02c0b827afe92 Mon Sep 17 00:00:00 2001
From: Lucas Santos <lsantos7654@gmail.com>
Date: Mon, 11 May 2026 17:30:46 -0400
Subject: [PATCH 22/24] fix: inline git info read into createNext, drop broken
 Effect.fnUntraced

The readGitInfo Effect.fnUntraced wrapper compiled to an object
rather than a callable, causing 'readGitInfo is not a function'
at session creation. Inlined the sync filesystem logic directly
into createNext as a yield* Effect.sync block.
---
 packages/opencode/src/cli/cmd/tui/attach.ts   |  2 +-
 .../opencode/src/server/routes/presence.ts    |  2 +-
 packages/opencode/src/session/index.ts        | 60 +++++++++----------
 3 files changed, 30 insertions(+), 34 deletions(-)

diff --git a/packages/opencode/src/cli/cmd/tui/attach.ts b/packages/opencode/src/cli/cmd/tui/attach.ts
index e892f99..289758c 100644
--- a/packages/opencode/src/cli/cmd/tui/attach.ts
+++ b/packages/opencode/src/cli/cmd/tui/attach.ts
@@ -51,7 +51,7 @@ export const AttachCommand = cmd({
       }
 
       const directory = (() => {
-        if (!args.dir) return undefined
+        if (!args.dir) return process.cwd()
         try {
           process.chdir(args.dir)
           return process.cwd()
diff --git a/packages/opencode/src/server/routes/presence.ts b/packages/opencode/src/server/routes/presence.ts
index 3f75d8c..3d3e9b1 100644
--- a/packages/opencode/src/server/routes/presence.ts
+++ b/packages/opencode/src/server/routes/presence.ts
@@ -30,7 +30,7 @@ function gitMeta(dir: string): Record<string, string> {
     }
     try {
       const cfg = new TextDecoder().decode(readFileSync(path.join(root, "config")))
-      const m = cfg.match(/\[remote\s+"origin"\][^\[]*url\s*=\s*(.+)/s)
+      const m = cfg.match(/\[remote\s+"origin"\][^\[]*url\s*=\s*(\S+)/m)
       if (m) out.remote = m[1].trim()
     } catch {}
   } catch {}
diff --git a/packages/opencode/src/session/index.ts b/packages/opencode/src/session/index.ts
index c6b1e07..4e295e7 100644
--- a/packages/opencode/src/session/index.ts
+++ b/packages/opencode/src/session/index.ts
@@ -393,37 +393,6 @@ export namespace Session {
       const config = yield* Config.Service
       const scope = yield* Scope.Scope
 
-      const readGitInfo = Effect.fnUntraced("Session.readGitInfo")(function* (dir: string) {
-        return yield* Effect.sync(() => {
-          const output: Record<string, unknown> = {}
-          try {
-            let root = path.join(dir, ".git")
-            let head: string
-            try {
-              head = new TextDecoder().decode(readFileSync(path.join(root, "HEAD")))
-            } catch {
-              const text = new TextDecoder().decode(readFileSync(root))
-              const match = text.match(/^gitdir:\s*(.+)$/m)
-              if (!match) return output
-              root = path.resolve(dir, match[1])
-              head = new TextDecoder().decode(readFileSync(path.join(root, "HEAD")))
-            }
-            head = head.trim()
-            if (head.startsWith("ref: refs/heads/")) {
-              output.git_branch = head.slice(16)
-            } else if (head.length >= 7) {
-              output.git_branch = head.slice(0, 7)
-            }
-            try {
-              const cfg = new TextDecoder().decode(readFileSync(path.join(root, "config")))
-              const m = cfg.match(/\[remote\s+"origin"\][^\[]*url\s*=\s*(.+)/s)
-              if (m) output.git_remote_url = m[1].trim()
-            } catch {}
-          } catch {}
-          return output
-        })
-      })
-
       const createNext = Effect.fn("Session.createNext")(function* (input: {
         id?: SessionID
         title?: string
@@ -455,7 +424,34 @@ export namespace Session {
             updated: Date.now(),
           },
         }
-        const git = yield* readGitInfo(input.directory)
+        const git = yield* Effect.sync(() => {
+          const out: Record<string, unknown> = {}
+          try {
+            let root = path.join(input.directory, ".git")
+            let head: string
+            try {
+              head = new TextDecoder().decode(readFileSync(path.join(root, "HEAD")))
+            } catch {
+              const text = new TextDecoder().decode(readFileSync(root))
+              const match = text.match(/^gitdir:\s*(.+)$/m)
+              if (!match) return out
+              root = path.resolve(input.directory, match[1])
+              head = new TextDecoder().decode(readFileSync(path.join(root, "HEAD")))
+            }
+            head = head.trim()
+            if (head.startsWith("ref: refs/heads/")) {
+              out.git_branch = head.slice(16)
+            } else if (head.length >= 7) {
+              out.git_branch = head.slice(0, 7)
+            }
+            try {
+              const cfg = new TextDecoder().decode(readFileSync(path.join(root, "config")))
+              const m = cfg.match(/\[remote\s+"origin"\][^\[]*url\s*=\s*(\S+)/m)
+              if (m) out.git_remote_url = m[1].trim()
+            } catch {}
+          } catch {}
+          return out
+        })
         if (Object.keys(git).length > 0) {
           result.metadata = { ...input.metadata, ...git }
         }
-- 
