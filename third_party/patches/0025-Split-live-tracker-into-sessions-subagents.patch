 packages/opencode/src/server/routes/event.ts  | 58 +++++++++++++++----
 packages/opencode/src/server/routes/global.ts |  7 ++-
 2 files changed, 51 insertions(+), 14 deletions(-)

diff --git a/packages/opencode/src/server/routes/event.ts b/packages/opencode/src/server/routes/event.ts
index abebeae..a827c8b 100644
--- a/packages/opencode/src/server/routes/event.ts
+++ b/packages/opencode/src/server/routes/event.ts
@@ -5,22 +5,31 @@ import z from "zod"
 import { Log } from "@/util/log"
 import { BusEvent } from "@/bus/bus-event"
 import { Bus } from "@/bus"
+import { Session } from "@/session"
+import { SessionID } from "@/session/schema"
 import { AsyncQueue } from "../../util/queue"

 const log = Log.create({ service: "server" })

 // Hivemind: emitted on every change to the per-session subscriber map so
 // connected clients (e.g. the TUI footer) can render a live count without
-// polling. The payload carries the full set of currently-live session IDs;
-// subscribers can derive .length, diff against their last known set, etc.
+// polling. `sessions` is every currently-live session ID (root + subagent);
+// `subagents` is the subset whose `parentID` is set — i.e. Task-spawned
+// children. The TUI footer derives a "root sessions" count via
+// `sessions.length - subagents.length` and shows the two as separate pills.
 export const LiveSessionsChanged = BusEvent.define(
   "session.live.changed",
   z.object({
     sessions: z.array(z.string()),
+    subagents: z.array(z.string()),
   }),
 )

-// Hivemind: per-session count of currently-open SSE subscriptions.
+// Hivemind: per-session count of currently-open SSE subscriptions, plus a
+// parallel `_isSubagent` flag remembered at subscription time. Looking up
+// `parentID` once per subscribe avoids a DB round-trip on every counter
+// mutation.
+//
 // A TUI subscribes to `/event?sessionID=<current>` for whichever session
 // it's attached to; the count is incremented when the stream opens and
 // decremented when the abort handler fires. `liveSessions()` returns the
@@ -30,22 +39,30 @@ export const LiveSessionsChanged = BusEvent.define(
 // to all events" shape) do not contribute to liveness. This keeps the
 // route backwards-compatible for any non-TUI consumer.
 const _subscriberCount = new Map<string, number>()
+const _isSubagent = new Map<string, boolean>()

 function _publishChange(): void {
-  Bus.publish(LiveSessionsChanged, { sessions: liveSessions() }).catch((err) =>
-    log.error("failed to publish LiveSessionsChanged", { err }),
-  )
+  Bus.publish(LiveSessionsChanged, {
+    sessions: liveSessions(),
+    subagents: liveSubagents(),
+  }).catch((err) => log.error("failed to publish LiveSessionsChanged", { err }))
 }

-function _incr(sessionID: string): void {
+function _incr(sessionID: string, isSubagent: boolean): void {
   _subscriberCount.set(sessionID, (_subscriberCount.get(sessionID) ?? 0) + 1)
+  // First increment for this sessionID — record subagent status. Later
+  // increments share the same status (a session's parent doesn't change
+  // mid-life).
+  if (!_isSubagent.has(sessionID)) _isSubagent.set(sessionID, isSubagent)
   _publishChange()
 }

 function _decr(sessionID: string): void {
   const next = (_subscriberCount.get(sessionID) ?? 0) - 1
-  if (next <= 0) _subscriberCount.delete(sessionID)
-  else _subscriberCount.set(sessionID, next)
+  if (next <= 0) {
+    _subscriberCount.delete(sessionID)
+    _isSubagent.delete(sessionID)
+  } else _subscriberCount.set(sessionID, next)
   _publishChange()
 }

@@ -53,6 +70,10 @@ export function liveSessions(): string[] {
   return [..._subscriberCount.keys()]
 }

+export function liveSubagents(): string[] {
+  return [..._subscriberCount.keys()].filter((id) => _isSubagent.get(id) === true)
+}
+
 export const EventRoutes = () =>
   new Hono().get(
     "/event",
@@ -75,7 +96,22 @@ export const EventRoutes = () =>
     async (c) => {
       const sessionID = c.req.query("sessionID")
       const signal = c.req.raw.signal
-      log.info("event connected", { sessionID })
+      // Hivemind: look up parentID *before* entering streamSSE so the
+      // subagent flag is known synchronously inside _incr. A session is
+      // classified as a subagent iff it has a parentID set (i.e. it was
+      // spawned by the Task tool). Failures (session not found, transient
+      // DB issue) treat it as a root — a slight footer miscount is
+      // preferable to refusing the SSE subscription.
+      let isSubagent = false
+      if (sessionID) {
+        try {
+          const session = await Session.get(SessionID.make(sessionID))
+          isSubagent = session.parentID != null
+        } catch (err) {
+          log.error("event: parentID lookup failed; treating as root", { sessionID, err })
+        }
+      }
+      log.info("event connected", { sessionID, isSubagent })
       c.header("Cache-Control", "no-cache, no-transform")
       c.header("X-Accel-Buffering", "no")
       c.header("X-Content-Type-Options", "nosniff")
@@ -135,7 +171,7 @@ export const EventRoutes = () =>
         // attached doesn't update to reflect itself until *another* client
         // triggers the next change. Reorder is a pure semantic fix; no
         // behavior change beyond the timing window.
-        if (sessionID) _incr(sessionID)
+        if (sessionID) _incr(sessionID, isSubagent)

         // Hivemind: hono-streaming's `stream.onAbort` doesn't fire reliably
         // when `stream.writeSSE` is blocked in the kernel send buffer
diff --git a/packages/opencode/src/server/routes/global.ts b/packages/opencode/src/server/routes/global.ts
index 275fff4..9c1d974 100644
--- a/packages/opencode/src/server/routes/global.ts
+++ b/packages/opencode/src/server/routes/global.ts
@@ -12,7 +12,7 @@ import { Log } from "../../util/log"
