+          "Hivemind: return the set of session IDs that have at least one open SSE subscription on /event with `?sessionID=<id>`. `sessions` is the full live set (root sessions + subagents); `subagents` is the subset whose `parentID` is set, recorded at subscription time. The TUI footer derives a root-session count via `sessions.length - subagents.length` and shows the two as separate pills.",
         operationId: "global.liveSessions",
         responses: {
           200: {
@@ -313,6 +313,7 @@ export const GlobalRoutes = lazy(() =>
                 schema: resolver(
                   z.object({
                     sessions: z.array(z.string()),
+                    subagents: z.array(z.string()),
                   }),
                 ),
               },
@@ -321,7 +322,7 @@ export const GlobalRoutes = lazy(() =>
         },
       }),
       async (c) => {
-        return c.json({ sessions: liveSessions() })
+        return c.json({ sessions: liveSessions(), subagents: liveSubagents() })
