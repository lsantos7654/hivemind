From 566a38e14169064c77497fed9e7c0887f621925e Mon Sep 17 00:00:00 2001
From: Lucas Santos <lsantos7654@gmail.com>
Date: Tue, 28 Apr 2026 21:08:44 -0400
Subject: [PATCH 10/21] Task tool accepts source_session_id
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Adds an optional source_session_id parameter to Task. When set, the
new subagent session is created via Session.fork (deep-copying the
source's full message history) instead of Session.create (fresh
context). The source session itself is untouched — fork is a separate
DB row.

Mechanism:
  - Reject up front if both task_id and source_session_id are
    supplied — they're conceptually different operations (resume vs
    fork-and-spawn) and the model gets a clear error.
  - Lift the existing child-permission overlay (deny todowrite, deny
    task, primary_tools allow) into a single value reused by both the
    create-fresh and fork-from-source paths.
  - In the fork path, fetch the source's stored permission ruleset
    via Session.get and stack the child overlay on top — so source-
    side rules carry over while Task's child-hardening still applies.
  - Everything past the session-resolution branch is unchanged: same
    ctx.metadata({ ..., metadata: { sessionId: ... }}), same
    SessionPrompt.prompt, same drill-down ToolPart shape.

This means the orchestrator's existing ctrl-x-down drill-down works
automatically against fork-from-source spawns — they're regular
"task" ToolParts from the TUI's perspective. Replaces hivemind's
external query_session_fork pattern for orchestrator-originating
context queries (the MCP tool stays around for subagent-originating
queries that don't have Task permission).

Pairs with patch 0015 (Session.fork accepts permission).
---
 packages/opencode/src/tool/task.ts  | 105 ++++++++++++++++++++--------
 packages/opencode/src/tool/task.txt |   2 +-
 2 files changed, 76 insertions(+), 31 deletions(-)

diff --git a/packages/opencode/src/tool/task.ts b/packages/opencode/src/tool/task.ts
index b97b53b..cfdcaff 100644
--- a/packages/opencode/src/tool/task.ts
+++ b/packages/opencode/src/tool/task.ts
@@ -23,6 +23,12 @@ const parameters = z.object({
       "This should only be set if you mean to resume a previous task (you can pass a prior task_id and the task will continue the same subagent session as before instead of creating a fresh one)",
     )
     .optional(),
+  source_session_id: z
+    .string()
+    .describe(
+      "Optional. Pass a session ID to fork that session into a fresh subagent instead of starting from scratch. The fork inherits the source's full message history and permission rules; the source itself is untouched. Useful for follow-up questions that need another session's accumulated context. Mutually exclusive with task_id.",
+    )
+    .optional(),
   command: z.string().describe("The command that triggered this task").optional(),
 })

@@ -35,6 +41,18 @@ export const TaskTool = Tool.defineEffect(
     const run = Effect.fn("TaskTool.execute")(function* (params: z.infer<typeof parameters>, ctx: Tool.Context) {
       const cfg = yield* config.get()

+      // Hivemind: source_session_id and task_id are conceptually
+      // different operations (fork-from-source vs resume-existing).
+      // Reject up front so the model gets a clear error instead of
+      // silently picking one.
+      if (params.task_id && params.source_session_id) {
+        return yield* Effect.fail(
+          new Error(
+            "task_id and source_session_id are mutually exclusive — resume an existing task or fork a source, not both",
+          ),
+        )
+      }
+
       if (!ctx.extra?.bypassAgentCheck) {
         yield* Effect.promise(() =>
           ctx.ask({
@@ -57,46 +75,73 @@ export const TaskTool = Tool.defineEffect(
       const canTask = next.permission.some((rule) => rule.permission === id)
       const canTodo = next.permission.some((rule) => rule.permission === "todowrite")

+      // Permission overlay applied to every Task-spawned child. Built
+      // once and reused by the create-fresh and fork-from-source paths
+      // so they share identical hardening (deny todowrite, deny task,
+      // allow experimental.primary_tools).
+      const childPermissionOverlay = [
+        ...(canTodo
+          ? []
+          : [
+              {
+                permission: "todowrite" as const,
+                pattern: "*" as const,
+                action: "deny" as const,
+              },
+            ]),
+        ...(canTask
+          ? []
+          : [
+              {
+                permission: id,
+                pattern: "*" as const,
+                action: "deny" as const,
+              },
+            ]),
+        ...(cfg.experimental?.primary_tools?.map((item) => ({
+          pattern: "*",
+          action: "allow" as const,
+          permission: item,
+        })) ?? []),
+      ]
+
       const taskID = params.task_id
-      const session = taskID
+      const existing = taskID
         ? yield* Effect.promise(() => {
             const id = SessionID.make(taskID)
             return Session.get(id).catch(() => undefined)
           })
         : undefined
-      const nextSession =
-        session ??
-        (yield* Effect.promise(() =>
+
+      // Resolve the subagent session: existing (resume) >
+      // fork-from-source (Hivemind) > create fresh (default).
+      let nextSession
+      if (existing) {
+        nextSession = existing
+      } else if (params.source_session_id) {
+        // Hivemind: fork-from-source path. The new subagent starts
+        // with the source session's full message history copied in;
+        // the source itself is untouched. Permission inherits the
+        // source's stored ruleset and stacks Task's child-hardening
+        // overlay on top.
+        const sourceID = SessionID.make(params.source_session_id)
+        const original = yield* Effect.promise(() => Session.get(sourceID))
+        nextSession = yield* Effect.promise(() =>
+          Session.fork({
+            sessionID: sourceID,
+            parentID: ctx.sessionID,
+            permission: [...(original.permission ?? []), ...childPermissionOverlay],
+          }),
+        )
+      } else {
+        nextSession = yield* Effect.promise(() =>
           Session.create({
             parentID: ctx.sessionID,
             title: params.description + ` (@${next.name} subagent)`,
-            permission: [
-              ...(canTodo
-                ? []
-                : [
-                    {
-                      permission: "todowrite" as const,
-                      pattern: "*" as const,
-                      action: "deny" as const,
-                    },
-                  ]),
-              ...(canTask
-                ? []
-                : [
-                    {
-                      permission: id,
-                      pattern: "*" as const,
-                      action: "deny" as const,
-                    },
-                  ]),
-              ...(cfg.experimental?.primary_tools?.map((item) => ({
-                pattern: "*",
-                action: "allow" as const,
-                permission: item,
-              })) ?? []),
-            ],
+            permission: childPermissionOverlay,
           }),
-        ))
+        )
+      }

       const msg = yield* Effect.sync(() => MessageV2.get({ sessionID: ctx.sessionID, messageID: ctx.messageID }))
       if (msg.info.role !== "assistant") return yield* Effect.fail(new Error("Not an assistant message"))
diff --git a/packages/opencode/src/tool/task.txt b/packages/opencode/src/tool/task.txt
index fba8470..bd36693 100644
--- a/packages/opencode/src/tool/task.txt
+++ b/packages/opencode/src/tool/task.txt
@@ -15,7 +15,7 @@ When NOT to use the Task tool:
 Usage notes:
 1. Launch multiple agents concurrently whenever possible, to maximize performance; to do that, use a single message with multiple tool uses
 2. When the agent is done, it will return a single message back to you. The result returned by the agent is not visible to the user. To show the user the result, you should send a text message back to the user with a concise summary of the result. The output includes a task_id you can reuse later to continue the same subagent session.
-3. Each agent invocation starts with a fresh context unless you provide task_id to resume the same subagent session (which continues with its previous messages and tool outputs). When starting fresh, your prompt should contain a highly detailed task description for the agent to perform autonomously and you should specify exactly what information the agent should return back to you in its final and only message to you.
+3. Each agent invocation starts with a fresh context unless you provide task_id to resume the same subagent session (which continues with its previous messages and tool outputs), or source_session_id to fork an existing session and run with that session's full message history as starting context (the source session itself is untouched). task_id and source_session_id are mutually exclusive. When starting fresh, your prompt should contain a highly detailed task description for the agent to perform autonomously and you should specify exactly what information the agent should return back to you in its final and only message to you.
 4. The agent's outputs should generally be trusted
 5. Clearly tell the agent whether you expect it to write code or just to do research (search, file reads, web fetches, etc.), since it is not aware of the user's intent. Tell it how to verify its work if possible (e.g., relevant test commands).
 6. If the agent description mentions that it should be used proactively, then you should try your best to use it without the user having to ask for it first. Use your judgement.
