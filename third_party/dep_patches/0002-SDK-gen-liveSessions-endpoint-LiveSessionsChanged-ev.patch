From 1724c22ae7c53c2e34feeb3e4577728c452f3217 Mon Sep 17 00:00:00 2001
From: Lucas Santos <lsantos7654@gmail.com>
Date: Fri, 1 May 2026 01:52:42 -0400
Subject: [PATCH 02/35] SDK gen: liveSessions endpoint + LiveSessionsChanged
 event type

Adds the typed bindings the TUI footer plugin uses:

  - `client.global.liveSessions()` -> { sessions: string[] }
  - `EventSessionLiveChanged` ("session.live.changed") added to the
    Event union with payload { sessions: string[] }

The shape matches the per-client WebSocket presence model that
follows. Subagent counts are computed per-TUI from
`client.session.children(focused)` and do not flow through this
event.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 packages/sdk/js/src/v2/gen/sdk.gen.ts   | 25 +++++++++++++++++++++++++
 packages/sdk/js/src/v2/gen/types.gen.ts | 15 +++++++++++++++
 2 files changed, 40 insertions(+)

diff --git a/packages/sdk/js/src/v2/gen/sdk.gen.ts b/packages/sdk/js/src/v2/gen/sdk.gen.ts
index f1dfacf..010c1f4 100644
--- a/packages/sdk/js/src/v2/gen/sdk.gen.ts
+++ b/packages/sdk/js/src/v2/gen/sdk.gen.ts
@@ -351,6 +351,31 @@ export class Global extends HeyApiClient {
     })
   }
 
+  /**
+   * List live sessions
+   *
+   * Hivemind: returns the deduplicated set of session IDs currently
+   * focused by at least one connected client (TUI). Each TUI opens a
+   * single WebSocket on `/presence` and signals focus via JSON
+   * messages. Subagent counts are computed per-TUI from the focused
+   * session's direct DB children and do not flow through this
+   * endpoint.
+   */
+  public liveSessions<ThrowOnError extends boolean = false>(options?: Options<never, ThrowOnError>) {
+    return (options?.client ?? this.client).get<
+      {
+        200: {
+          sessions: Array<string>
+        }
+      },
+      unknown,
+      ThrowOnError
+    >({
+      url: "/global/live-sessions",
+      ...options,
+    })
+  }
+
   /**
    * Upgrade opencode
    *
diff --git a/packages/sdk/js/src/v2/gen/types.gen.ts b/packages/sdk/js/src/v2/gen/types.gen.ts
index 7dccc5f..4ce2c9d 100644
--- a/packages/sdk/js/src/v2/gen/types.gen.ts
+++ b/packages/sdk/js/src/v2/gen/types.gen.ts
@@ -450,6 +450,20 @@ export type EventSessionBackgroundChanged = {
   }
 }
 
+/**
+ * Hivemind: emitted when the per-client presence map changes — a TUI
+ * connects/disconnects its `/presence` WebSocket or sends a focus
+ * update. `sessions` is the deduplicated set of session IDs focused
+ * by at least one client. Subagent counts are computed per-TUI from
+ * the focused session's direct DB children and do not flow through
+ * this event.
+ */
+export type EventSessionLiveChanged = {
+  type: "session.live.changed"
+  properties: {
+    sessions: Array<string>
+  }
+}
 
 export type EventSessionCompacted = {
   type: "session.compacted"
@@ -1015,6 +1029,7 @@ export type Event =
   | EventSessionStatus
   | EventSessionIdle
   | EventSessionBackgroundChanged
+  | EventSessionLiveChanged
   | EventSessionCompacted
   | EventTodoUpdated
   | EventPtyCreated
