 export type SessionPromptAsyncResponse = SessionPromptAsyncResponses[keyof SessionPromptAsyncResponses]
 
+export type SessionInboxListData = {
+  body?: never
+  path: {
+    sessionID: string
+  }
+  query?: {
+    directory?: string
+    workspace?: string
+  }
+  url: "/session/{sessionID}/inbox"
+}
+
+export type SessionInboxListErrors = {
+  /**
+   * Bad request
+   */
+  400: BadRequestError
+  /**
+   * Not found
+   */
+  404: NotFoundError
+}
+
+export type SessionInboxListError = SessionInboxListErrors[keyof SessionInboxListErrors]
+
+export type SessionInboxListResponses = {
+  /**
+   * Pending inbox messages
+   */
+  200: {
+    messages: Array<{
+      id: string
+      sender_id: string | null
+      text: string
+      created_at: number
+    }>
+  }
+}
+
+export type SessionInboxListResponse = SessionInboxListResponses[keyof SessionInboxListResponses]
+
 export type SessionInboxData = {
   body?: {
-    messageID?: string
-    model?: {
-      providerID: string
-      modelID: string
-    }
-    agent?: string
-    noReply?: boolean
-    /**
-     * @deprecated tools and permissions have been merged, you can set permissions on the session itself now
-     */
-    tools?: {
-      [key: string]: boolean
-    }
-    format?: OutputFormat
-    system?: string
-    variant?: string
-    parts: Array<TextPartInput | FilePartInput | AgentPartInput | SubtaskPartInput>
+    parts: Array<{
+      type: string
+      text: string
+    }>
+    sender_id?: string
   }
   path: {
     sessionID: string
@@ -4029,9 +4058,10 @@ export type SessionInboxError = SessionInboxErrors[keyof SessionInboxErrors]
 
 export type SessionInboxResponses = {
   /**
-   * Message delivered or queued
+   * Message queued
    */
   200: {
+    id: string
     sessionID: string
     queued: boolean
