From c61a7debea22303acca805fa283548e694eed060 Mon Sep 17 00:00:00 2001
From: Lucas Santos <lsantos7654@gmail.com>
Date: Wed, 29 Apr 2026 23:35:39 -0400
Subject: [PATCH 26/27] SDK gen: subagents field on liveSessions +
 LiveSessionsChanged

Pairs with the engine patch that adds a `subagents` array to the
LiveSessionsChanged bus event payload and the
GET /global/live-sessions response. SDK files in packages/sdk/js are
served from the @opencode_node_modules external repo, which only
receives dep_patches; without this dep patch the matching server-side
and TUI-side patches don't actually wire up.

Two changes:
  - sdk.gen.ts: Global.liveSessions() return type extended to
    `{ sessions: Array<string>; subagents: Array<string> }`.
  - types.gen.ts: EventSessionLiveChanged.properties extended with
    `subagents: Array<string>`.

TUI footer (next patch) consumes both fields to render separate
"N sessions" and "N subagents" pills.
---
 packages/sdk/js/src/v2/gen/sdk.gen.ts   | 12 +++++++++---
 packages/sdk/js/src/v2/gen/types.gen.ts |  5 ++++-
 2 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/packages/sdk/js/src/v2/gen/sdk.gen.ts b/packages/sdk/js/src/v2/gen/sdk.gen.ts
index 71d09f7..31386e2 100644
--- a/packages/sdk/js/src/v2/gen/sdk.gen.ts
+++ b/packages/sdk/js/src/v2/gen/sdk.gen.ts
@@ -328,11 +328,17 @@ export class Global extends HeyApiClient {
    * List live sessions
    *
    * Hivemind: returns the set of session IDs that have at least one open
-   * SSE subscription on /event?sessionID=<id>. A session is "live" iff a
-   * TUI is currently attached to it.
+   * SSE subscription on /event?sessionID=<id>. `sessions` is the full
+   * live set (root sessions + subagents); `subagents` is the subset
+   * whose `parentID` is set. The footer derives a root-session count via
+   * `sessions.length - subagents.length`.
    */
   public liveSessions<ThrowOnError extends boolean = false>(options?: Options<never, ThrowOnError>) {
-    return (options?.client ?? this.client).get<{ 200: { sessions: Array<string> } }, unknown, ThrowOnError>({
+    return (options?.client ?? this.client).get<
+      { 200: { sessions: Array<string>; subagents: Array<string> } },
+      unknown,
+      ThrowOnError
+    >({
       url: "/global/live-sessions",
       ...options,
     })
diff --git a/packages/sdk/js/src/v2/gen/types.gen.ts b/packages/sdk/js/src/v2/gen/types.gen.ts
index 034d5bd..14e0f50 100644
--- a/packages/sdk/js/src/v2/gen/types.gen.ts
+++ b/packages/sdk/js/src/v2/gen/types.gen.ts
@@ -432,12 +432,15 @@ export type EventSessionIdle = {

 /**
  * Hivemind: emitted when the per-session SSE subscriber map changes.
- * Provided by `//third_party/patches/0011-live-sessions-bus-event.patch`.
+ * `sessions` is the full live set (root sessions + subagents);
+ * `subagents` is the subset whose `parentID` is set, recorded at
+ * subscription time. Provided by patches 0011 + 0025.
  */
 export type EventSessionLiveChanged = {
   type: "session.live.changed"
   properties: {
     sessions: Array<string>
+    subagents: Array<string>
   }
 }

