# Expose source-of-truth files as labels so quality-gate targets can
# reference them via `$(rootpath //:foo)` from any package.
exports_files([
    "pyproject.toml",
    "MODULE.bazel",
    "BUILD.bazel",
])

# ---------------------------------------------------------------------------
# Top-level CLI binary (alias to the actual py_binary defined alongside __main__.py)
# ---------------------------------------------------------------------------

alias(
    name = "hivemind",
    actual = "//src/hivemind:hivemind",
    visibility = ["//visibility:public"],
)

# Stable alias to the bun-compiled engine binary. Used by the Makefile's
# `cquery --output=files //:engine` to locate the artifact for `make install`.
alias(
    name = "engine",
    actual = "@opencode_src//:hivemind_engine",
    visibility = ["//visibility:public"],
)
