common --enable_bzlmod
common --registry=https://bcr.bazel.build

build --enable_platform_specific_config

# Quieter output by default
build --show_timestamps=false

# Faster local iteration: keep the Bazel cache out of the source tree.
build --disk_cache=~/.cache/bazel/disk

# Reproducible C++ flags (silences a noisy 7.x warning).
build --incompatible_strict_action_env

test --test_output=errors

# rules_py.uv: select the default venv for all builds. The implicit
# venv name comes from the pyproject.toml project name.
common --@pypi//venv=hivemind
