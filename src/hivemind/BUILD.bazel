load("@aspect_bazel_lib//lib:expand_template.bzl", "expand_template")
load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@aspect_rules_py//py/unstable:defs.bzl", "py_venv_binary")
load("//tools/bazel:mypy_test.bzl", "mypy_test")
load("//tools/bazel:ruff_test.bzl", "ruff_check_test", "ruff_format_test")

package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.bazel"])

# Bake the engine's rlocation key into a Python constant at build time.
# Single source of truth: $(rlocationpath //:engine) resolves through
# Bazel's label graph, so any rename in MODULE.bazel (extension or repo)
# flows through here automatically.
expand_template(
    name = "_engine_rlocation",
    out = "_engine_rlocation.py",
    data = ["//:engine"],
    substitutions = {
        "__ENGINE_RLOCATION__": "$(rlocationpath //:engine)",
    },
    template = "_engine_rlocation.py.tpl",
)

py_library(
    name = "lib",
    srcs = glob(
        ["**/*.py"],
        exclude = [
            "__main__.py",
            "**/__pycache__/**",
        ],
    ) + [":_engine_rlocation"],
    data = glob(["templates/**/*.j2"]) + glob(["**/*.tcss"]),
    imports = [".."],
    deps = [
        "@pypi//crawl4ai",
        "@pypi//httpx",
        "@pypi//jinja2",
        "@pypi//lxml_html_clean",
        "@pypi//mcp",
        "@pypi//pydantic",
        "@pypi//rich",
        "@pypi//textual",
        "@pypi//trafilatura",
        "@pypi//typer",
    ],
)

# py_venv_binary builds the venv as a cached Bazel action instead of
# re-validating it on every launcher invocation (which py_binary does and
# costs ~1.9s per call). Drops cold start from ~2.4s to ~500ms.
#
# interpreter_options = ["-P"]: don't prepend the script's directory to
# sys.path. Without this, sys.path[0] becomes <runfiles>/_main/src/hivemind/
# which shadows the third-party `mcp` package (we have hivemind/mcp/ on disk).
# py_binary used -I (isolated mode) which implies -P; py_venv_binary strips -I
# (see rules_py py_venv.bzl::_interpreter_flags), so we set -P explicitly.
py_venv_binary(
    name = "hivemind",
    srcs = ["__main__.py"],
    data = ["//:engine"],
    imports = [".."],
    interpreter_options = ["-P"],
    main = "__main__.py",
    deps = [":lib"],
)

# ---------------------------------------------------------------------------
# Quality gates (Stage 0)
# ---------------------------------------------------------------------------

_PY_SRCS = glob(
    ["**/*.py"],
    exclude = ["**/__pycache__/**"],
)

ruff_check_test(
    name = "ruff_check",
    srcs = _PY_SRCS,
)

ruff_format_test(
    name = "ruff_format",
    srcs = _PY_SRCS,
)

mypy_test(
    name = "mypy",
    srcs = _PY_SRCS,
)
