# Hivemind Firecrawl — Optional Configuration
#
# To customize, copy this file to:
#   ~/.cache/hivemind/firecrawl/.env
#
# All settings below are optional. The service works without a .env file.

# --- AI Features ---
# Required for Firecrawl's /extract endpoint (structured AI extraction)
# OPENAI_API_KEY=sk-...

# --- Proxy ---
# PROXY_SERVER=http://your-proxy:port
# PROXY_USERNAME=
# PROXY_PASSWORD=

# --- Performance ---
# NUM_WORKERS_PER_QUEUE=8
# CRAWL_CONCURRENT_REQUESTS=10
# MAX_CONCURRENT_JOBS=5
# BROWSER_POOL_SIZE=5

# --- Admin ---
# BULL_AUTH_KEY=hivemind-admin
