# Generated agent files (recreated by hivemind sync)
agents/*
!agents/.gitkeep

# Repo symlink (points to ~/.cache/hivemind/repos)
repos

# External docs symlink (points to ~/.cache/hivemind/external_docs)
external_docs

# User-specific config (enabled/disabled state)
config.json

# User-specific teams and projects (track on your own branch)
teams/
projects/

# Private experts (NEVER commit)
private-experts/
private-repos.json

# Python
__pycache__/
*.pyc
*.egg-info/
dist/
build/

# OS files
.DS_Store
