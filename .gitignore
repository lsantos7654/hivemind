# Generated files (recreated by hivemind init/redeploy)
HIVEMIND.md
agents/*
!agents/.gitkeep

# Repo symlink (points to ~/.cache/hivemind/repos)
repos

# External docs symlink (points to ~/.cache/hivemind/external_docs)
external_docs

# User-specific config (enabled/disabled state)
config.json

# User-specific teams (track on your own branch)
teams/

# Python
__pycache__/
*.pyc
*.egg-info/
dist/
build/

# Bazel
bazel-*
MODULE.bazel.lock

# Local opencode dev checkout (created by `make dev`)
dev/

# Bundled engine binary (produced by `make install`)
src/hivemind/_bundled/hivemind-engine

# Coverage output (generated by `make coverage`)
tools/coverage/coverage_output/

# OS files
.DS_Store
